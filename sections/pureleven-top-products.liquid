{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding pl-top-products">
  <div class="page-width">
    {% if section.settings.heading %}
      <div class="pl-top-products__header">
        {% if section.settings.eyebrow %}
          <p class="pl-top-products__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="pl-top-products__heading">{{ section.settings.heading }}</h2>
        {% if section.settings.description %}
          <p class="pl-top-products__description">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    {% endif %}

    {%- assign products = collections[section.settings.collection].products -%}
    {%- if products.size > 0 -%}
      <div class="pl-top-products__grid">
        {%- for product in products limit: section.settings.products_to_show -%}
          <div class="pl-top-products__card">
            <div class="pl-top-products__image-wrap">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="400"
                  class="pl-top-products__image"
                >
              {%- endif -%}

              {%- if product.compare_at_price and product.compare_at_price > product.price -%}
                {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round -%}
                <div class="pl-top-products__badge pl-top-products__badge--discount">-{{ discount }}%</div>
              {%- endif -%}
            </div>

            <div class="pl-top-products__body">
              <h3 class="pl-top-products__title">{{ product.title }}</h3>

              {%- if product.variants.size > 1 -%}
                <div class="pl-top-products__variants">
                  {%- for variant in product.variants limit: 3 -%}
                    <span class="pl-top-products__variant-pill">{{ variant.title }}</span>
                  {%- endfor -%}
                  {%- if product.variants.size > 3 -%}
                    <span class="pl-top-products__variant-pill">+{{ product.variants.size | minus: 3 }} more</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="pl-top-products__price">
                {%- if product.compare_at_price and product.compare_at_price > product.price -%}
                  <span class="pl-top-products__price-original">₹{{ product.compare_at_price | money_without_currency }}</span>
                {%- endif -%}
                <span class="pl-top-products__price-current">₹{{ product.price | money_without_currency }}</span>
              </div>

              <a href="{{ product.url }}" class="pl-top-products__link">Add to cart</a>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all and products.size > section.settings.products_to_show -%}
        <div class="pl-top-products__footer">
          <a href="{{ collections[section.settings.collection].url }}" class="pl-top-products__view-all">View all</a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<style>
  .pl-top-products {
    background: #fff;
  }

  .pl-top-products__header {
    text-align: center;
    margin-bottom: 3.2rem;
  }

  .pl-top-products__eyebrow {
    display: inline-block;
    margin: 0 0 0.8rem;
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pl-teal-mid, #2e7d6e);
  }

  .pl-top-products__heading {
    margin: 0 0 1.2rem;
    font-family: var(--font-fraunces, 'Fraunces', serif) !important;
    font-size: 2rem;
    font-weight: 400;
    color: var(--pl-near-black, #1a1a1a);
  }

  .pl-top-products__description {
    margin: 0;
    max-width: 600px;
    font-family: 'Inter', sans-serif;
    font-size: 1.3rem;
    line-height: 1.6;
    color: var(--pl-text-muted, #5c5648);
  }

  .pl-top-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
  }

  @media screen and (min-width: 750px) {
    .pl-top-products__grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 2rem;
    }
  }

  .pl-top-products__card {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 1.2rem;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(27, 58, 48, 0.05);
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .pl-top-products__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(27, 58, 48, 0.12);
  }

  .pl-top-products__image-wrap {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f5f5f5;
  }

  .pl-top-products__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pl-top-products__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 6px 10px;
    border-radius: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    z-index: 2;
  }

  .pl-top-products__badge--discount {
    background: var(--pl-gold, #f4d976);
    color: var(--pl-near-black, #1a1a1a);
  }

  .pl-top-products__badge--bestseller {
    background: rgba(46, 125, 110, 0.2);
    color: var(--pl-green, #1b5e56);
  }

  .pl-top-products__body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .pl-top-products__title {
    margin: 0 0 0.4rem;
    font-family: Inter, sans-serif !important;
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--pl-near-black, #1a1a1a);
    line-height: 1.3;
  }

  .pl-top-products__variants {
    display: flex;
    gap: 5px;
    margin-bottom: 0.8rem;
  }

  .pl-top-products__variant-pill {
    flex: 1;
    text-align: center;
    padding: 6px 3px;
    border-radius: 6px;
    background: #f2efe6;
    border: 1px solid rgba(0, 0, 0, 0.08);
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--pl-near-black, #1a1a1a);
  }

  .pl-top-products__variant-pill:first-child {
    background: var(--pl-green, #1b5e56);
    color: #fff;
    border-color: var(--pl-green, #1b5e56);
  }

  .pl-top-products__price {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 1.2rem;
  }

  .pl-top-products__price-original {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    color: rgba(0, 0, 0, 0.4);
    text-decoration: line-through;
  }

  .pl-top-products__price-current {
    font-family: 'Inter', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--pl-green, #1b5e56);
  }

  .pl-top-products__link {
    display: block;
    text-align: center;
    padding: 11px 14px;
    background: var(--pl-gold, #f4d976);
    color: var(--pl-near-black, #1a1a1a);
    border: none;
    border-radius: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    min-height: 44px;
    margin-top: auto;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .pl-top-products__link:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(244, 217, 118, 0.4);
  }

  .pl-top-products__footer {
    text-align: center;
    margin-top: 2.4rem;
  }

  .pl-top-products__view-all {
    display: inline-block;
    padding: 12px 28px;
    border: 1.5px solid var(--pl-green, #1b5e56);
    border-radius: 8px;
    background: transparent;
    color: var(--pl-green, #1b5e56);
    font-family: 'Inter', sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .pl-top-products__view-all:hover {
    background: rgba(27, 94, 86, 0.08);
  }
</style>

{% schema %}
{
  "name": "Top Products Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our top spices"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Fresh essentials for daily cooking, gifting, chai, baking, and traditional recipes."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 6,
      "max": 20,
      "step": 1,
      "default": 12,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show View all button"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Top Products Grid",
      "settings": {
        "heading": "Our top spices"
      }
    }
  ]
}
{% endschema %}
