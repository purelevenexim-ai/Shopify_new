{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{{ 'tc-campaign.css' | asset_url | stylesheet_tag }}

<section class="tcx-trust{% if section.settings.tone == 'paper' %} is-paper{% endif %}" id="{{ section.settings.anchor | default: 'why-us' }}">
  <div class="tcx-trust__wrap">
    <div class="tcx-trust__story{% unless section.settings.show_story %} is-head-only{% endunless %}">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="tcx-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="tcx-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.lede != blank -%}<p class="tcx-lede">{{ section.settings.lede | escape }}</p>{%- endif -%}
        {%- if section.settings.show_story and section.settings.quote != blank -%}
          <blockquote class="tcx-quote">
            “{{ section.settings.quote | escape }}”
            {%- if section.settings.quote_by != blank -%}<cite>{{ section.settings.quote_by | escape }}</cite>{%- endif -%}
          </blockquote>
        {%- endif -%}
        {%- if section.settings.show_story and section.settings.team_image != blank -%}
          <figure class="tcx-team">
            {{ section.settings.team_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 40vw, 100vw', alt: section.settings.team_caption }}
            {%- if section.settings.team_caption != blank -%}<figcaption>{{ section.settings.team_caption | escape }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}
      </div>
      {%- if section.settings.show_story -%}
      <div class="tcx-trust__photos{% unless section.settings.show_video %} tcx-trust__photos--novideo{% endunless %}">
        <figure>
          <img src="{{ 'tc-farm-sorting-600.webp' | asset_url }}" srcset="{{ 'tc-farm-sorting-600.webp' | asset_url }} 600w, {{ 'tc-farm-sorting-1000.webp' | asset_url }} 1000w" sizes="(min-width: 990px) 26vw, 55vw" width="1000" height="667" loading="lazy" alt="{{ section.settings.photo_1_caption | escape }}">
          <figcaption>{{ section.settings.photo_1_caption | escape }}</figcaption>
        </figure>
        <figure>
          <img src="{{ 'tc-farm-pods-600.webp' | asset_url }}" srcset="{{ 'tc-farm-pods-600.webp' | asset_url }} 600w, {{ 'tc-farm-pods-1000.webp' | asset_url }} 1000w" sizes="(min-width: 990px) 20vw, 45vw" width="1000" height="667" loading="lazy" alt="{{ section.settings.photo_2_caption | escape }}">
          <figcaption>{{ section.settings.photo_2_caption | escape }}</figcaption>
        </figure>
        {%- if section.settings.show_video -%}
          <figure class="tcx-trust__video">
            <video controls muted playsinline preload="none" width="540" height="960" poster="{{ 'tc-harvest-poster.webp' | asset_url }}" aria-label="{{ section.settings.video_caption | escape }}">
              <source src="{{ 'tc-cardamom-harvest.mp4' | asset_url }}" type="video/mp4">
            </video>
            <figcaption>{{ section.settings.video_caption | escape }}</figcaption>
          </figure>
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>

    {%- assign facts = section.blocks | where: 'type', 'fact' -%}
    {%- if facts.size > 0 -%}
      <ul class="tcx-facts">
        {%- for block in facts -%}
          <li class="tcx-fact" {{ block.shopify_attributes }}>
            {%- case block.settings.icon -%}
              {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.1 7.5 9.5 4.4-1.4 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m8.8 12.2 2.2 2.2 4.3-4.6"/></svg>
              {%- when 'cash' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 9.5v5M18 9.5v5"/></svg>
              {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
              {%- when 'clock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
              {%- when 'return' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="M7.5 5.5 4 9l3.5 3.5"/></svg>
              {%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Z"/><path d="M5 19 13 11"/></svg>
              {%- when 'chart' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19h16"/><path d="m5 15 4-4 3 3 6-7"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 19.6l1.2-4A8 8 0 1 1 20 11.5Z"/></svg>
            {%- endcase -%}
            <p class="tcx-fact__title">{{ block.settings.title | escape }}</p>
            <p class="tcx-fact__text">{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- assign reviews = section.blocks | where: 'type', 'review' -%}
    {%- if reviews.size > 0 -%}
      <div class="tcx-reviews">
        <div class="tcx-reviews__stats">
          {%- if section.settings.rating != blank -%}
            <div class="tcx-stat">
              <p class="tcx-stat__big">{{ section.settings.rating | escape }} <span class="tcx-stars" aria-hidden="true">★★★★★</span></p>
              <p class="tcx-stat__small">{{ section.settings.rating_count | escape }}{% if section.settings.reviews_url != blank %} · <a href="{{ section.settings.reviews_url }}" target="_blank" rel="noopener">Read them</a>{% endif %}</p>
            </div>
          {%- endif -%}
          {%- if section.settings.orders_big != blank -%}
            <div class="tcx-stat">
              <p class="tcx-stat__big">{{ section.settings.orders_big | escape }}</p>
              <p class="tcx-stat__small">{{ section.settings.orders_small | escape }}</p>
            </div>
          {%- endif -%}
        </div>
        <div class="tcx-reviews__list">
          {%- for block in reviews -%}
            <figure class="tcx-review" {{ block.shopify_attributes }}>
              <div class="tcx-review__top">
                <span class="tcx-review__avatar" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span>
                <div>
                  <p class="tcx-review__name">{{ block.settings.name | escape }}</p>
                  <p class="tcx-review__date"><span class="tcx-stars" aria-label="{{ block.settings.stars }} out of 5 stars">{% for i in (1..block.settings.stars) %}★{% endfor %}</span>{% if block.settings.town != blank %} · {{ block.settings.town | escape }}{% endif %}{% if block.settings.date != blank %} · {{ block.settings.date | escape }}{% endif %}</p>
                  {%- if block.settings.source != blank -%}<p class="tcx-review__src">{{ block.settings.source | escape }}</p>{%- endif -%}
                </div>
              </div>
              <blockquote class="tcx-review__text">{{ block.settings.text | escape }}</blockquote>
            </figure>
          {%- endfor -%}
        </div>
        {%- if section.settings.reviews_note != blank -%}<p class="tcx-reviews__note">{{ section.settings.reviews_note | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust: proof or story",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "why-us" },
    { "type": "select", "id": "tone", "label": "Background", "default": "cream", "options": [ { "value": "cream", "label": "Cream" }, { "value": "paper", "label": "Paper" } ] },
    { "type": "checkbox", "id": "show_story", "label": "Show owner note, farm photos and video", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "04 / Who we are" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real cardamom from our own farm in Idukki." },
    { "type": "textarea", "id": "lede", "label": "Intro" },
    { "type": "textarea", "id": "quote", "label": "Owner note" },
    { "type": "text", "id": "quote_by", "label": "Owner note by", "default": "Basil, Pure Leven" },
    { "type": "text", "id": "photo_1_caption", "label": "Photo 1 caption", "default": "Sorting fresh cardamom" },
    { "type": "text", "id": "photo_2_caption", "label": "Photo 2 caption", "default": "Freshly picked cardamom" },
    { "type": "checkbox", "id": "show_video", "label": "Show harvest video", "default": true },
    { "type": "image_picker", "id": "team_image", "label": "Team photo (optional)" },
    { "type": "text", "id": "team_caption", "label": "Team photo caption" },
    { "type": "text", "id": "orders_big", "label": "Orders stat (e.g. 700+ orders)", "info": "Only a real number. Leave empty to hide." },
    { "type": "text", "id": "orders_small", "label": "Orders stat sub-line" },
    { "type": "text", "id": "video_caption", "label": "Video caption", "default": "Cardamom harvest" },
    { "type": "text", "id": "rating", "label": "Google rating (must match Google, empty hides)" },
    { "type": "text", "id": "rating_count", "label": "Review count line (must match Google)" },
    { "type": "url", "id": "reviews_url", "label": "Google reviews link" },
    { "type": "text", "id": "reviews_note", "label": "Reviews note", "default": "Copied word for word from our Google Business profile." }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
          { "value": "shield", "label": "Shield" }, { "value": "cash", "label": "Cash" }, { "value": "truck", "label": "Truck" },
          { "value": "clock", "label": "Clock" }, { "value": "return", "label": "Return" }, { "value": "chat", "label": "Chat" },
          { "value": "leaf", "label": "Leaf" }, { "value": "chart", "label": "Chart" } ] },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "inline_richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name (as the customer gave it)" },
        { "type": "text", "id": "town", "label": "Town (optional)" },
        { "type": "text", "id": "date", "label": "Date" },
        { "type": "text", "id": "source", "label": "Source (e.g. Google review)" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text (word for word)" }
      ]
    }
  ],
  "presets": [{ "name": "Trust: proof or story" }]
}
{% endschema %}
