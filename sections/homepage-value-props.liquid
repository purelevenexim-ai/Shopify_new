{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="pl-values section-{{ section.id }}-padding" aria-label="Why Choose PureLeven">
  <div class="pl-values__container page-width">

    <div class="pl-values__header">
      <p class="pl-values__eyebrow">A simpler way</p>
      <h2 class="pl-values__heading">A simpler way to buy better spices</h2>
    </div>

    <div class="pl-values__grid">

      <div class="pl-values__card">
        <div class="pl-values__card-top">
          <div class="pl-values__icon-wrap" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div class="pl-values__badge">Whole spice</div>
        </div>
        <h3 class="pl-values__title">Whole over overworked</h3>
        <p class="pl-values__text">We lean toward whole spices wherever possible, so the aroma stays in the ingredient until your kitchen wakes it up.</p>
        <div class="pl-values__accent-line"></div>
      </div>

      <div class="pl-values__card">
        <div class="pl-values__card-top">
          <div class="pl-values__icon-wrap" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 8C8 10 5.9 16.17 3.82 19.24a2 2 0 0 0 3.27 2.26C9 19 15 18 17 8z"/>
              <path d="M17 8c0 0 .5 4-5 6"/>
            </svg>
          </div>
          <div class="pl-values__badge">Cleaner source</div>
        </div>
        <h3 class="pl-values__title">Closer to origin</h3>
        <p class="pl-values__text">We buy closer to farms and keep the route cleaner, so the ingredient story stays clear from source to shelf.</p>
        <div class="pl-values__accent-line"></div>
      </div>

      <div class="pl-values__card">
        <div class="pl-values__card-top">
          <div class="pl-values__icon-wrap" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="6"/>
              <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/>
            </svg>
          </div>
          <div class="pl-values__badge">Small batch</div>
        </div>
        <h3 class="pl-values__title">Packed before character fades</h3>
        <p class="pl-values__text">Smaller packing cycles help preserve the smell, oils, and fullness that make a spice feel alive in the pan.</p>
        <div class="pl-values__accent-line"></div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Value props — skillies numbered tiles, px only. */
  #shopify-section-{{ section.id }} { background: var(--sk-bg) !important; border-top: 1px solid var(--sk-line); color: var(--sk-fg); font-family: var(--sk-sans); }
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .pl-values { background: transparent !important; }
  #shopify-section-{{ section.id }} .pl-values__container { max-width: var(--sk-wrap) !important; margin: 0 auto; padding: 0 var(--sk-gutter) !important; }
  #shopify-section-{{ section.id }} .pl-values__header { margin: 0 0 28px !important; text-align: left !important; }
  #shopify-section-{{ section.id }} .pl-values__eyebrow {
    display: block !important; width: auto !important; margin: 0 0 16px !important; padding: 0 !important; background: none !important; border: 0 !important; color: var(--sk-muted) !important;
    font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important;
  }
  #shopify-section-{{ section.id }} .pl-values__eyebrow::before, #shopify-section-{{ section.id }} .pl-values__eyebrow::after { content: none !important; }
  #shopify-section-{{ section.id }} .pl-values__heading {
    max-width: 16ch; margin: 0 !important; color: var(--sk-fg) !important; text-align: left !important;
    font-family: var(--sk-sans) !important; font-size: clamp(34px, 4.2vw, 60px) !important; font-weight: 500 !important;
    line-height: 1.08 !important; letter-spacing: -0.055em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .pl-values__grid {
    display: flex !important; gap: 12px !important; margin: 0 calc(var(--sk-gutter) * -1) !important; padding: 0 var(--sk-gutter) 2px !important;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 var(--sk-gutter); scrollbar-width: none; counter-reset: vp;
  }
  #shopify-section-{{ section.id }} .pl-values__grid::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .pl-values__card {
    flex: 0 0 84%; display: flex !important; flex-direction: column; align-items: stretch !important; gap: 12px; min-width: 0; margin: 0 !important; padding: 20px 18px !important;
    background: var(--sk-bg2) !important; border: 1px solid var(--sk-line) !important; border-radius: 3px !important; box-shadow: none !important;
    scroll-snap-align: start; counter-increment: vp; transform: none !important; text-align: left !important;
  }
  #shopify-section-{{ section.id }} .pl-values__card > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .pl-values__card-top { display: flex !important; align-items: baseline; justify-content: space-between !important; gap: 12px; width: 100%; }
  #shopify-section-{{ section.id }} .pl-values__badge { display: block !important; }
  #shopify-section-{{ section.id }} .pl-values__title, #shopify-section-{{ section.id }} .pl-values__text { text-align: left !important; }
  #shopify-section-{{ section.id }} .pl-values__card-top::before { content: counter(vp, decimal-leading-zero); color: var(--sk-acc); font: 700 14px/1 var(--sk-mono); }
  #shopify-section-{{ section.id }} .pl-values__icon-wrap { display: none !important; }
  #shopify-section-{{ section.id }} .pl-values__badge {
    padding: 0 !important; background: none !important; border: 0 !important; border-radius: 0 !important; box-shadow: none !important; color: var(--sk-muted) !important;
    font: 400 10.5px/1.4 var(--sk-mono) !important; letter-spacing: 0.1em !important; text-transform: uppercase !important;
  }
  #shopify-section-{{ section.id }} .pl-values__title {
    color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: 22px !important; font-weight: 500 !important;
    line-height: 1.12 !important; letter-spacing: -0.03em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .pl-values__text {
    color: var(--sk-muted) !important; font-family: var(--sk-sans) !important; font-size: 15px !important; line-height: 1.45 !important; letter-spacing: 0 !important;
  }
  #shopify-section-{{ section.id }} .pl-values__accent-line { display: none !important; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pl-values__header { margin-bottom: 40px !important; }
    #shopify-section-{{ section.id }} .pl-values__grid { display: grid !important; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px !important; margin: 0 !important; padding: 0 !important; overflow: visible; }
    #shopify-section-{{ section.id }} .pl-values__card { padding: 24px 22px !important; }
    #shopify-section-{{ section.id }} .pl-values__title { font-size: 24px !important; }
  }
</style>

{% schema %}
{
  "name": "Value Propositions",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Value Propositions"
    }
  ]
}
{% endschema %}
