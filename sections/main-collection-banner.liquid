{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{{ 'sk-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign _title = collection.title
  assign _title_first = _title | slice: 0 | upcase
  assign _title_rest = _title | slice: 1, 200
  assign _has_image = false
  if section.settings.show_collection_image and collection.image
    assign _has_image = true
  endif
  assign _nav = section.settings.nav_handles | split: ','
-%}

<section class="sk-coll-hero{% if _has_image %} sk-coll-hero--image{% endif %}">
  <div class="sk-coll-hero__inner">
    <div class="sk-coll-hero__text">
      <p class="tc-eyebrow">
        <i>01</i> / {{ section.settings.eyebrow | escape }}
      </p>
      <h1 class="sk-coll-hero__title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- _title_first | escape }}{{ _title_rest | escape -}}
      </h1>
      {%- if section.settings.show_collection_description and collection.description != blank -%}
        <div class="sk-coll-hero__desc">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if _has_image -%}
      <div class="sk-coll-hero__media">
        {{ collection.image | image_url: width: 1400 | image_tag:
          widths: '360, 535, 750, 1070, 1400',
          sizes: '(min-width: 750px) 45vw, 100vw',
          alt: collection.image.alt,
          fetchpriority: 'high'
        }}
      </div>
    {%- endif -%}
  </div>

  {%- if _nav.size > 0 -%}
    <nav class="sk-coll-nav" aria-label="{{ section.settings.nav_label | escape }}">
      <ul class="sk-coll-nav__list" role="list">
        {%- for h in _nav -%}
          {%- assign _h = h | strip -%}
          {%- assign _c = collections[_h] -%}
          {%- if _c == blank or _c.products_count == 0 -%}{%- continue -%}{%- endif -%}
          {%- assign _cf = _c.title | slice: 0 | upcase -%}
          {%- assign _cr = _c.title | slice: 1, 200 -%}
          <li>
            <a
              href="{{ _c.url }}"
              class="sk-coll-nav__chip"
              {% if _c.handle == collection.handle %}aria-current="page"{% endif %}
            >
              {{- _cf | escape }}{{ _cr | escape }} <span>{{ _c.products_count }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collection"
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Category links label",
      "default": "Browse categories"
    },
    {
      "type": "textarea",
      "id": "nav_handles",
      "label": "Category links (collection handles, comma separated)",
      "default": "all-products,spices,export-quality-cardamom,spiciest-black-pepper,cloves,cinnamon,tea-coffee,coffee,combo,honey"
    }
  ]
}
{% endschema %}
