<style>
  /* Homepage FAQ — skillies hairline list, px only. */
  #shopify-section-{{ section.id }} { background: var(--sk-bg2) !important; border-top: 1px solid var(--sk-line); color: var(--sk-fg); font-family: var(--sk-sans); }
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .pl-faq { background: transparent !important; }
  #shopify-section-{{ section.id }} .pl-faq__container { display: grid; max-width: var(--sk-wrap) !important; margin: 0 auto; padding: 0 var(--sk-gutter) !important; }
  #shopify-section-{{ section.id }} .pl-faq__header { margin: 0 0 24px !important; text-align: left !important; }
  #shopify-section-{{ section.id }} .pl-faq__header > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .pl-faq__eyebrow {
    display: block; margin-bottom: 16px !important; color: var(--sk-muted) !important;
    font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important;
  }
  #shopify-section-{{ section.id }} .pl-faq__heading {
    color: var(--sk-fg) !important; text-align: left !important; font-family: var(--sk-sans) !important;
    font-size: clamp(34px, 4.2vw, 60px) !important; font-weight: 500 !important; line-height: 1.08 !important; letter-spacing: -0.055em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .pl-faq__subtitle {
    margin-top: 12px !important; max-width: 46ch; color: var(--sk-muted) !important; text-align: left !important;
    font-size: 15px !important; line-height: 1.6 !important; letter-spacing: 0 !important;
  }
  #shopify-section-{{ section.id }} .pl-faq__list {
    display: grid !important; gap: 0 !important; margin: 0; padding: 0 !important;
    background: none !important; border: 0 !important; border-bottom: 1px solid var(--sk-line) !important; border-radius: 0 !important; box-shadow: none !important;
  }
  #shopify-section-{{ section.id }} .pl-faq__item {
    margin: 0 !important; padding: 0 !important; background: none !important; border: 0 !important; border-top: 1px solid var(--sk-line) !important;
    border-radius: 0 !important; box-shadow: none !important;
  }
  #shopify-section-{{ section.id }} .pl-faq__question {
    display: flex !important; align-items: flex-start; justify-content: space-between; gap: 16px;
    padding: 20px 0 !important; margin: 0 !important; cursor: pointer; list-style: none; background: none !important;
    color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: 16px !important; font-weight: 600 !important;
    line-height: 1.45 !important; letter-spacing: -0.01em !important;
  }
  #shopify-section-{{ section.id }} .pl-faq__question::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .pl-faq__question::marker { content: none; }
  #shopify-section-{{ section.id }} .pl-faq__question svg { display: none !important; }
  #shopify-section-{{ section.id }} .pl-faq__question::after {
    content: '+'; flex: none; width: 16px; margin-top: -1px; color: var(--sk-fg); text-align: center;
    font: 300 22px/1 var(--sk-sans); transition: transform 0.25s var(--sk-ease);
  }
  #shopify-section-{{ section.id }} .pl-faq__item[open] .pl-faq__question::after { transform: rotate(45deg); }
  #shopify-section-{{ section.id }} .pl-faq__answer { max-width: 68ch; margin: 0 !important; padding: 0 30px 20px 0 !important; background: none !important; }
  #shopify-section-{{ section.id }} .pl-faq__answer p {
    margin: 0 !important; color: var(--sk-fg2) !important; font-family: var(--sk-sans) !important; font-size: 15px !important; line-height: 1.65 !important; letter-spacing: 0 !important;
  }
  #shopify-section-{{ section.id }} .pl-faq__answer strong { color: var(--sk-fg); font-weight: 600; }
  #shopify-section-{{ section.id }} .pl-faq__answer a { color: var(--sk-acc) !important; text-decoration: underline; text-underline-offset: 3px; }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .pl-faq__container { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); column-gap: 64px; align-items: start; }
    #shopify-section-{{ section.id }} .pl-faq__header { margin: 0 !important; }
  }
</style>

{% schema %}
{
  "name": "FAQ Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "FAQ Section"
    }
  ]
}
{% endschema %}
