{%- if has_related_articles or request.design_mode -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    .product-related-articles-{{ section.id }} .product-related-articles__header {
      max-width: 74rem;
      margin: 0 auto 3rem;
      text-align: center;
    }

    .product-related-articles-{{ section.id }} .product-related-articles__eyebrow {
      margin: 0 0 0.8rem;
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #8F5A12;
    }

    .product-related-articles-{{ section.id }} .product-related-articles__heading {
      margin: 0;
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .product-related-articles-{{ section.id }} .product-related-articles__intro {
      margin: 1.2rem 0 0;
      font-size: 1.6rem;
      line-height: 1.75;
      color: rgba(var(--color-foreground), 0.76);
    }

    .product-related-articles-{{ section.id }} .product-related-articles__grid {
      display: grid;
      gap: 1.6rem;
    }

    @media screen and (min-width: 990px) {
      .product-related-articles-{{ section.id }} .product-related-articles__grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .product-related-articles-{{ section.id }} .product-related-articles__card {
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
      height: 100%;
      padding: 2.2rem;
      border: 0.1rem solid rgba(var(--color-foreground), 0.08);
      border-radius: 2.2rem;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(var(--color-foreground), 0.02));
      box-shadow: 0 1.6rem 4rem rgba(27, 58, 48, 0.06);
    }

    .product-related-articles-{{ section.id }} .product-related-articles__card-eyebrow {
      margin: 0;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(var(--color-foreground), 0.55);
    }

    .product-related-articles-{{ section.id }} .product-related-articles__card-title {
      margin: 0;
      font-size: 2rem;
      line-height: 1.2;
      letter-spacing: -0.03em;
      color: rgb(var(--color-foreground));
    }

    .product-related-articles-{{ section.id }} .product-related-articles__card-copy {
      margin: 0;
      font-size: 1.45rem;
      line-height: 1.7;
      color: rgba(var(--color-foreground), 0.74);
      flex-grow: 1;
    }

    .product-related-articles-{{ section.id }} .product-related-articles__card-link,
    .product-related-articles-{{ section.id }} .product-related-articles__actions a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 4.4rem;
      padding: 1.1rem 1.6rem;
      border-radius: 999px;
      text-decoration: none;
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      transition: transform var(--duration-default) ease, background var(--duration-default) ease, border-color var(--duration-default) ease;
    }

    .product-related-articles-{{ section.id }} .product-related-articles__card-link:hover,
    .product-related-articles-{{ section.id }} .product-related-articles__actions a:hover {
      transform: translateY(-0.1rem);
    }

    .product-related-articles-{{ section.id }} .product-related-articles__card-link {
      align-self: flex-start;
      color: #1B5E56;
      border: 0.1rem solid rgba(27, 94, 86, 0.22);
      background: rgba(27, 94, 86, 0.08);
    }

    .product-related-articles-{{ section.id }} .product-related-articles__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
      margin-top: 2.2rem;
    }

    .product-related-articles-{{ section.id }} .product-related-articles__actions a:first-child {
      color: #ffffff;
      background: #1B5E56;
      border: 0.1rem solid #1B5E56;
    }

    .product-related-articles-{{ section.id }} .product-related-articles__actions a:last-child {
      color: rgb(var(--color-foreground));
      background: rgba(var(--color-foreground), 0.02);
      border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    }

    .product-related-articles-{{ section.id }} .product-related-articles__footer-note {
      margin: 1.6rem auto 0;
      max-width: 58rem;
      text-align: center;
      font-size: 1.3rem;
      line-height: 1.65;
      color: rgba(var(--color-foreground), 0.68);
    }

    .product-related-articles-{{ section.id }} .product-related-articles__placeholder {
      max-width: 72rem;
      margin: 0 auto;
      padding: 2rem 2.4rem;
      border: 0.1rem dashed rgba(var(--color-foreground), 0.2);
      border-radius: 1.8rem;
      color: rgba(var(--color-foreground), 0.7);
      background: rgba(var(--color-foreground), 0.02);
    }
  {%- endstyle -%}

  <div class="color-{{ section.settings.color_scheme }} gradient product-related-articles-{{ section.id }}">
    <section class="page-width section-{{ section.id }}-padding" aria-labelledby="ProductRelatedArticles-{{ section.id }}">
      <div class="product-related-articles__header">
        <p class="product-related-articles__eyebrow">Keep exploring</p>
        <h2 id="ProductRelatedArticles-{{ section.id }}" class="product-related-articles__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        <p class="product-related-articles__intro">{{ section.settings.intro }}</p>
      </div>

      {%- if has_related_articles -%}
        <div class="product-related-articles__grid">
          <article class="product-related-articles__card">
            <p class="product-related-articles__card-eyebrow">Spice guide</p>
            <h3 class="product-related-articles__card-title">{{ article_1_title }}</h3>
            <p class="product-related-articles__card-copy">{{ article_1_copy }}</p>
            <a class="product-related-articles__card-link" href="{{ article_1_url }}">Read guide</a>
          </article>
          {%- if article_2_title != blank and article_2_url != blank -%}
            <article class="product-related-articles__card">
              <p class="product-related-articles__card-eyebrow">Buying help</p>
              <h3 class="product-related-articles__card-title">{{ article_2_title }}</h3>
              <p class="product-related-articles__card-copy">{{ article_2_copy }}</p>
              <a class="product-related-articles__card-link" href="{{ article_2_url }}">Read guide</a>
            </article>
          {%- endif -%}
          {%- if article_3_title != blank and article_3_url != blank -%}
            <article class="product-related-articles__card">
              <p class="product-related-articles__card-eyebrow">Brand story</p>
              <h3 class="product-related-articles__card-title">{{ article_3_title }}</h3>
              <p class="product-related-articles__card-copy">{{ article_3_copy }}</p>
              <a class="product-related-articles__card-link" href="{{ article_3_url }}">Read guide</a>
            </article>
          {%- endif -%}
        </div>

        <div class="product-related-articles__actions">
          <a href="/blogs/cooking-spices">Explore all spice guides</a>
          <a href="/collections/all">Shop best sellers</a>
        </div>
        <p class="product-related-articles__footer-note">From Kerala soil to your kitchen. Use these guides to compare, choose, store, and enjoy the spice more confidently.</p>
      {%- elsif request.design_mode -%}
        <div class="product-related-articles__placeholder">Add product-specific guide links here so each product page supports deeper reading, stronger internal linking, and higher purchase confidence.</div>
      {%- endif -%}
    </section>
  </div>
{%- endif -%}

{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{%- style -%}
  /* Skillies layer — after the older rules so it wins. px only. */
  #shopify-section-{{ section.id }} > div { background: var(--sk-bg) !important; border-top: 1px solid var(--sk-line); color: var(--sk-fg); font-family: var(--sk-sans); }
  #shopify-section-{{ section.id }} > div .page-width { max-width: var(--sk-wrap) !important; padding-left: var(--sk-gutter) !important; padding-right: var(--sk-gutter) !important; }
  #shopify-section-{{ section.id }} > div * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .product-related-articles__header, #shopify-section-{{ section.id }} .product-related-articles__lead { display: grid; gap: 14px; margin: 0 0 24px !important; text-align: left !important; max-width: none !important; }
  #shopify-section-{{ section.id }} .product-related-articles__header > *, #shopify-section-{{ section.id }} .product-related-articles__lead > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .product-related-articles__eyebrow { color: var(--sk-muted) !important; background: none !important; padding: 0 !important; border: 0 !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; }
  #shopify-section-{{ section.id }} .product-related-articles__heading { max-width: 22ch; color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: clamp(28px, 3.2vw, 44px) !important; font-weight: 500 !important; line-height: 1.1 !important; letter-spacing: -0.045em !important; text-transform: none !important; text-align: left !important; }
  #shopify-section-{{ section.id }} .product-related-articles__intro, #shopify-section-{{ section.id }} .product-related-articles__intro p { max-width: 60ch; margin: 0 !important; color: var(--sk-muted) !important; font-size: 16px !important; line-height: 1.6 !important; letter-spacing: 0 !important; text-align: left !important; }

  #shopify-section-{{ section.id }} .product-related-articles__grid { display: grid !important; gap: 12px !important; margin: 0 !important; }
  #shopify-section-{{ section.id }} .product-related-articles__card {
    display: flex !important; flex-direction: column; gap: 8px; margin: 0 !important; padding: 20px 18px !important;
    background: var(--sk-card) !important; border: 1px solid var(--sk-line) !important; border-radius: 3px !important; box-shadow: none !important;
  }
  #shopify-section-{{ section.id }} .product-related-articles__card > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .product-related-articles__card-eyebrow { color: var(--sk-acc) !important; background: none !important; padding: 0 !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; font-size: 10.5px !important; }
  #shopify-section-{{ section.id }} .product-related-articles__card-title { color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: 19px !important; font-weight: 500 !important; line-height: 1.2 !important; letter-spacing: -0.025em !important; text-transform: none !important; }
  #shopify-section-{{ section.id }} .product-related-articles__card-copy { color: var(--sk-muted) !important; font-size: 14px !important; line-height: 1.55 !important; letter-spacing: 0 !important; }
  #shopify-section-{{ section.id }} .product-related-articles__card-link {
    margin-top: auto !important; padding: 0 0 2px !important; align-self: flex-start; background: none !important; border: 0 !important; border-bottom: 1px solid currentColor !important; border-radius: 0 !important;
    color: var(--sk-acc) !important; text-decoration: none !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; font-size: 10.5px !important;
  }
  #shopify-section-{{ section.id }} .product-related-articles__card-link::after { content: ' \2192'; }
  #shopify-section-{{ section.id }} .product-related-articles__actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 0 !important; }
  #shopify-section-{{ section.id }} .product-related-articles__actions a {
    display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 14px 24px 14px 26px !important;
    background: transparent !important; border: 1px solid var(--sk-dark) !important; border-radius: 2px !important; box-shadow: none !important;
    color: var(--sk-fg) !important; text-decoration: none !important; font-family: var(--sk-sans) !important; font-size: 13px !important; font-weight: 600 !important; letter-spacing: -0.01em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .product-related-articles__actions a:first-child { background: var(--sk-dark) !important; color: #fff !important; }
  #shopify-section-{{ section.id }} .product-related-articles__actions a:hover { background: var(--sk-acc-hover) !important; border-color: var(--sk-acc-hover) !important; color: #fff !important; }
  #shopify-section-{{ section.id }} .product-related-articles__footer-note { margin: 20px 0 0 !important; color: var(--sk-muted) !important; text-align: left !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; font-size: 10.5px !important; letter-spacing: 0.08em !important; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .product-related-articles__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px !important; }
    #shopify-section-{{ section.id }} .product-related-articles__header { margin-bottom: 40px !important; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Product related articles",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Read before you buy"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Short guides on choosing, using and storing your spices."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h0",
          "label": "Display"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Product related articles"
    }
  ]
}
{% endschema %}
