{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} { background: var(--sk-bg) !important; border-top: 1px solid var(--sk-line); }
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .plcg {
    display: grid; gap: 22px; max-width: var(--sk-wrap); margin: 0 auto; padding: 40px var(--sk-gutter) 56px; font-family: var(--sk-sans);
  }
  #shopify-section-{{ section.id }} .plcg > * { margin: 0 !important; min-width: 0; }
  #shopify-section-{{ section.id }} .plcg__eyebrow {
    color: var(--sk-muted) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important;
  }
  html body #shopify-section-{{ section.id }} .plcg__title {
    max-width: 22ch; color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: clamp(26px, 3.4vw, 40px) !important;
    font-weight: 500 !important; line-height: 1.1 !important; letter-spacing: -0.045em !important; text-transform: none !important;
  }
  html body #shopify-section-{{ section.id }} .plcg__body,
  html body #shopify-section-{{ section.id }} .plcg__body p,
  html body #shopify-section-{{ section.id }} .plcg__body li {
    color: var(--sk-fg2) !important; font-family: var(--sk-sans) !important; font-size: 15px !important; line-height: 1.65 !important; letter-spacing: -0.005em !important;
  }
  #shopify-section-{{ section.id }} .plcg__body { max-width: 680px; }
  #shopify-section-{{ section.id }} .plcg__body p { margin: 0 0 12px !important; }
  #shopify-section-{{ section.id }} .plcg__body p:last-child { margin-bottom: 0 !important; }
  #shopify-section-{{ section.id }} .plcg__body ul { margin: 0 0 14px !important; padding-left: 20px !important; }
  #shopify-section-{{ section.id }} .plcg__body li { margin: 0 0 8px !important; }
  #shopify-section-{{ section.id }} .plcg__body strong { color: var(--sk-fg) !important; font-weight: 600 !important; }
  html body #shopify-section-{{ section.id }} .plcg a { color: var(--sk-acc-hover) !important; text-decoration: underline !important; text-underline-offset: 3px; text-decoration-color: rgba(0, 68, 56, 0.35); }
  html body #shopify-section-{{ section.id }} .plcg a:hover { text-decoration-color: var(--sk-acc-hover); }
  #shopify-section-{{ section.id }} .plcg__faq { max-width: 680px; border-bottom: 1px solid var(--sk-line); }
  html body #shopify-section-{{ section.id }} .plcg__faq-title {
    margin: 0 0 12px !important; color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: 18px !important;
    font-weight: 600 !important; line-height: 1.3 !important; letter-spacing: -0.02em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .plcg__item { border-top: 1px solid var(--sk-line); }
  html body #shopify-section-{{ section.id }} .plcg__item summary {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 16px 0; cursor: pointer; list-style: none;
    color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: 15px !important; font-weight: 600 !important; line-height: 1.45 !important;
  }
  #shopify-section-{{ section.id }} .plcg__item summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .plcg__item summary::after { content: "+"; flex: 0 0 auto; color: var(--sk-muted); font: 400 18px/1 var(--sk-mono); }
  #shopify-section-{{ section.id }} .plcg__item[open] summary::after { content: "\2212"; }
  #shopify-section-{{ section.id }} .plcg__item summary:focus-visible { outline: 2px solid var(--sk-acc); outline-offset: 2px; }
  html body #shopify-section-{{ section.id }} .plcg__answer,
  html body #shopify-section-{{ section.id }} .plcg__answer p {
    margin: 0 !important; color: var(--sk-fg2) !important; font-family: var(--sk-sans) !important; font-size: 15px !important; line-height: 1.65 !important; letter-spacing: -0.005em !important;
  }
  #shopify-section-{{ section.id }} .plcg__answer { padding: 0 0 18px; max-width: 620px; }
{%- endstyle -%}

<div class="plcg">
  {%- if section.settings.eyebrow != blank -%}
    <p class="plcg__eyebrow">{{ section.settings.eyebrow | escape }}</p>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h2 class="plcg__title">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.body != blank -%}
    <div class="plcg__body rte">{{ section.settings.body }}</div>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="plcg__faq">
      {%- if section.settings.faq_heading != blank -%}
        <h3 class="plcg__faq-title">{{ section.settings.faq_heading | escape }}</h3>
      {%- endif -%}
      {%- for block in section.blocks -%}
        <details class="plcg__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}</summary>
          <div class="plcg__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
  {%- for block in section.blocks -%}
    {%- if block.settings.question != blank and block.settings.answer != blank -%}
      {"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | strip | json }}}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
]}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Collection guide and FAQ",
  "tag": "section",
  "class": "pl-collection-guide",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "faq_heading", "label": "Questions heading" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    { "name": "Collection guide and FAQ" }
  ]
}
{% endschema %}
