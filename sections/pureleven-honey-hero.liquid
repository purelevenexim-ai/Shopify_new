{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Honey hero — typographic skillies hero with the photo beside it (text was dark-on-photo before). */
  #shopify-section-{{ section.id }} { background: var(--sk-bg) !important; color: var(--sk-fg); font-family: var(--sk-sans); }
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .hn-banner {
    position: relative; display: grid; gap: 24px; max-width: var(--sk-wrap); min-height: 0 !important; height: auto !important;
    margin: 0 auto; padding: 32px var(--sk-gutter) 40px; background: none !important; overflow: visible;
  }
  #shopify-section-{{ section.id }} .hn-banner__overlay { display: none !important; }
  #shopify-section-{{ section.id }} .hn-banner__img {
    position: static !important; order: 2; display: block; width: 100%; height: auto !important; aspect-ratio: 4 / 3; object-fit: cover;
    border: 1px solid var(--sk-line); border-radius: 3px; transform: none !important; filter: none !important;
  }
  #shopify-section-{{ section.id }} .hn-banner__text {
    position: static !important; order: 1; display: grid; gap: 16px; justify-items: start; max-width: none !important;
    padding: 0 !important; background: none !important; transform: none !important; text-align: left !important;
  }
  #shopify-section-{{ section.id }} .hn-banner__text > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .hn-banner__eyebrow { color: var(--sk-acc) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; }
  #shopify-section-{{ section.id }} .hn-banner__heading {
    max-width: 12ch; color: var(--sk-fg) !important; text-shadow: none !important;
    font-family: var(--sk-sans) !important; font-size: clamp(40px, 5.4vw, 78px) !important; font-weight: 600 !important;
    line-height: 1.02 !important; letter-spacing: -0.05em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .hn-banner__sub {
    max-width: 44ch; color: var(--sk-muted) !important; text-shadow: none !important;
    font-family: var(--sk-sans) !important; font-size: 17px !important; line-height: 1.6 !important; letter-spacing: 0 !important;
  }
  #shopify-section-{{ section.id }} .hn-banner__cta {
    display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 14px 24px 14px 26px !important;
    background: var(--sk-dark) !important; border: 1px solid var(--sk-dark) !important; border-radius: 2px !important; box-shadow: none !important;
    color: #fff !important; text-decoration: none !important; font-family: var(--sk-sans) !important; font-size: 13px !important;
    font-weight: 600 !important; line-height: 1.2 !important; letter-spacing: -0.01em !important; text-transform: none !important;
    transition: background-color 0.2s, border-color 0.2s, transform 0.25s var(--sk-ease);
  }
  #shopify-section-{{ section.id }} .hn-banner__cta:hover { background: var(--sk-acc-hover) !important; border-color: var(--sk-acc-hover) !important; transform: translateY(-1px); }
  #shopify-section-{{ section.id }} .hn-trust {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; max-width: none; margin: 0; padding: 0 var(--sk-gutter);
    background: var(--sk-bg2) !important; border-top: 1px solid var(--sk-line); border-bottom: 1px solid var(--sk-line);
  }
  #shopify-section-{{ section.id }} .hn-trust__item {
    display: flex; align-items: center; min-width: 0; padding: 14px 12px !important; margin: 0; border: 0 !important;
    background: none !important; color: var(--sk-fg2) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; font-size: 10.5px !important; letter-spacing: 0.08em !important;
  }
  #shopify-section-{{ section.id }} .hn-trust__item:nth-child(even) { border-left: 1px solid var(--sk-line) !important; }
  #shopify-section-{{ section.id }} .hn-trust__item:nth-child(odd) { padding-left: 0 !important; }
  #shopify-section-{{ section.id }} .hn-trust__item:nth-child(n+3) { border-top: 1px solid var(--sk-line) !important; }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .hn-banner { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); align-items: center; gap: 56px; padding: 72px var(--sk-gutter) 88px; }
    #shopify-section-{{ section.id }} .hn-banner__img { order: 2; aspect-ratio: 5 / 4; }
    #shopify-section-{{ section.id }} .hn-banner__text { gap: 22px; }
    #shopify-section-{{ section.id }} .hn-trust { grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 0 max(var(--sk-gutter), calc((100% - var(--sk-wrap)) / 2 + var(--sk-gutter))); }
    #shopify-section-{{ section.id }} .hn-trust__item { padding: 18px 16px !important; border-top: 0 !important; border-left: 1px solid var(--sk-line) !important; }
    #shopify-section-{{ section.id }} .hn-trust__item:first-child { border-left: 0 !important; padding-left: 0 !important; }
  }
{%- endstyle -%}

<div>
  <div class="hn-banner">
    {%- if section.settings.hero_image != blank -%}
      <img class="hn-banner__img"
        src="{{ section.settings.hero_image | image_url: width: 1400 }}"
        srcset="{{ section.settings.hero_image | image_url: width: 600 }} 600w, {{ section.settings.hero_image | image_url: width: 900 }} 900w, {{ section.settings.hero_image | image_url: width: 1400 }} 1400w"
        sizes="100vw" alt="Kerala Wild Honey" loading="eager">
    {%- else -%}
      <img class="hn-banner__img" src="{{ 'pl-brew-honey.webp' | asset_url }}" alt="Kerala Wild Honey" loading="eager">
    {%- endif -%}
    <div class="hn-banner__overlay"></div>
    <div class="hn-banner__text">
      <p class="hn-banner__eyebrow">Idukki · Wayanad · Kerala</p>
      <h1 class="hn-banner__heading">Pure Kerala<br>Wild Honey</h1>
      <p class="hn-banner__sub">Naadan forest honey from Kerala's high ranges — unprocessed, raw, and real.</p>
      <a href="#honey-products" class="hn-banner__cta">Shop Honey</a>
    </div>
  </div>

  <div class="hn-trust">
    <div class="hn-trust__item">Wild forest sourced</div>
    <div class="hn-trust__item">Naadan &amp; unprocessed</div>
    <div class="hn-trust__item">Direct from Kerala</div>
    <div class="hn-trust__item">Free delivery ₹649+</div>
  </div>
</div>

{% schema %}
{
  "name": "Honey Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" }
  ],
  "presets": [{ "name": "Honey Hero" }]
}
{% endschema %}
