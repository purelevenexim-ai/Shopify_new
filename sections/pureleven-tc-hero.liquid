{%- comment -%}
Tea & Coffee Hero Section
- Large hero banner with warm aesthetic
- Two primary CTAs (Shop Tea / Shop Coffee)
- Background: combo image (four products)
- Trust line emphasizing selection/freshness/delivery
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'tc-design-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'tc-page.css' | asset_url }}">

<section class="tc-hero" id="tc-hero-{{ section.id }}">
  <div class="tc-hero__wrapper">
    {%- comment -%} Hero Content: Text-first on desktop, stacked on mobile {%- endcomment -%}
    <div class="tc-hero__content">
      {%- if section.settings.eyebrow -%}
        <p class="tc-eyebrow tc-eyebrow--left"><i>{{ section.settings.eyebrow }}</i></p>
      {%- endif -%}

      <h1 class="tc-hero__heading">
        {{ section.settings.heading }}
      </h1>

      {%- if section.settings.subheading -%}
        <p class="tc-hero__subheading">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}

      {%- comment -%} CTA Buttons {%- endcomment -%}
      <div class="tc-hero__ctas">
        {%- if section.settings.cta_1_text and section.settings.cta_1_link -%}
          <a href="{{ section.settings.cta_1_link }}" class="tc-hero__button tc-hero__button--primary">
            {{ section.settings.cta_1_text }}
          </a>
        {%- endif -%}

        {%- if section.settings.cta_2_text and section.settings.cta_2_link -%}
          <a href="{{ section.settings.cta_2_link }}" class="tc-hero__button tc-hero__button--secondary">
            {{ section.settings.cta_2_text }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.trust_line -%}
        <p class="tc-hero__trust-line">
          {{ section.settings.trust_line }}
        </p>
      {%- endif -%}
    </div>

    {%- comment -%} Hero Background/Image {%- endcomment -%}
    <div class="tc-hero__visual">
      {%- if section.settings.art == 'hills' -%}
        <img src="{{ 'tc-hills-art.svg' | asset_url }}" alt="Illustration of women plucking tea on the misty hills of Munnar" width="1200" height="900" loading="eager" fetchpriority="high">
      {%- elsif section.settings.bg_image -%}
        {{
          section.settings.bg_image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            sizes: '(min-width: 990px) 50vw, 100vw',
            widths: '360,533,720,940,1200',
            alt: 'Kerala tea estate'
        }}
      {%- else -%}
        <img
          src="{{ 'tc-hero-bg.webp' | asset_url }}"
          alt="Kerala tea estate — Munnar tea gardens with jacaranda trees"
          loading="eager"
          width="1200"
          height="800"
        >
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%} Section Settings Schema {%- endcomment -%}

{% schema %}
{
  "name": "Tea & Coffee Hero",
  "settings": [
    { "type": "select", "id": "art", "label": "Banner picture", "default": "photo", "options": [ { "value": "photo", "label": "Photo" }, { "value": "hills", "label": "Tea hills illustration" } ] },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Kerala · Harvested Fresh"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tea & Coffee from Kerala"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Selected for the way you drink it."
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line (below CTAs)",
      "default": "Tea selected for taste, colour & aroma • Packed fresh • Delivery across India"
    },
    {
      "type": "text",
      "id": "cta_1_text",
      "label": "Primary CTA text",
      "default": "Shop Tea"
    },
    {
      "type": "text",
      "id": "cta_1_link",
      "label": "Primary CTA link (anchor or URL)",
      "default": "#tea-collection"
    },
    {
      "type": "text",
      "id": "cta_2_text",
      "label": "Secondary CTA text",
      "default": "Shop Coffee"
    },
    {
      "type": "text",
      "id": "cta_2_link",
      "label": "Secondary CTA link (anchor or URL)",
      "default": "#coffee-section"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    }
  ],
  "presets": [
    {
      "name": "Tea & Coffee Hero",
      "settings": {}
    }
  ]
}
{% endschema %}
