{%- comment -%}
Tea & Coffee Products Grid Section
- Display tea/coffee products in responsive grid
- Each card shows: image, title, description, variants, price, add-to-cart
- Uses metafields for tea-specific data (best_for, strength, etc.)
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'tc-design-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'tc-page.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'tc-product-card.css' | asset_url }}">
<script src="{{ 'tc-product-card.js' | asset_url }}" defer></script>
<script src="{{ 'tc-ajax-cart.js' | asset_url }}" defer></script>

<section class="tc-products" id="{{ section.settings.section_id }}">
  <div class="tc-products__container">
    <p class="tc-eyebrow tc-eyebrow--left"><i>01</i> / Our Teas</p>
    {%- if section.settings.heading -%}
      <h2 class="tc-products__heading tc-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.description -%}
      <p class="tc-products__description">{{ section.settings.description }}</p>
    {%- endif -%}

    {%- assign tc_handles = section.settings.product_handles | split: ',' -%}
    <div class="tc-products__grid" style="--columns-desktop: {{ section.settings.grid_columns_desktop }}; --columns-mobile: {{ section.settings.grid_columns_mobile }}">
      {%- for product_handle in tc_handles -%}
        {%- assign product_handle = product_handle | strip -%}
        {%- assign product = all_products[product_handle] -%}
        {%- if product -%}
          <div class="tc-products__item" data-product-handle="{{ product.handle }}">
            {%- render 'pureleven-tc-product-card', product: product, delivery_rule: 'two_items' -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%} Section Settings Schema {%- endcomment -%}

{% schema %}
{
  "name": "Tea & Coffee Products",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID (for anchor links)",
      "default": "tea-collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Our Teas"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Section description",
      "default": "Premium teas selected for the cup"
    },
    {
      "type": "text",
      "id": "product_handles",
      "label": "Product handles (comma-separated)",
      "default": "premium-milk-tea-powder,premium-black-tea-granules,orange-pekoe-powder,cardamom-tea",
      "info": "Enter product handles separated by commas"
    },
    {
      "type": "range",
      "id": "grid_columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 2
    },
    {
      "type": "select",
      "id": "grid_columns_mobile",
      "label": "Columns (mobile)",
      "default": "1",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tea & Coffee Products"
    }
  ]
}
{% endschema %}
