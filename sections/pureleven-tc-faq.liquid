{%- comment -%}
Tea & Coffee FAQ Section
- Native <details>/<summary> accordion — accessible, no JS required
- Each block = one Q&A pair
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'tc-design-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'tc-page.css' | asset_url }}">

<section class="tc-faq">
  <div class="tc-faq__container">
    <p class="tc-eyebrow"><i>09</i> / Questions</p>
    {%- if section.settings.heading -%}
      <h2 class="tc-faq__heading tc-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="tc-faq__list">
        {%- for block in section.blocks -%}
          <details class="tc-faq__item" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
            <summary class="tc-faq__question">
              {{ block.settings.question }}
              <span class="tc-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="tc-faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} FAQ Structured Data (SEO) {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ block.settings.answer | strip_html | json }}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "TC FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions about our tea & coffee?"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Which tea should I buy for normal milk tea?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Premium Milk Tea Powder is made for everyday milk tea — balanced strength, brews fast.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TC FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Which tea should I buy for normal milk tea?",
            "answer": "<p>Premium Milk Tea Powder is made for everyday milk tea — balanced strength, brews fast.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Which tea is suitable for black tea?",
            "answer": "<p>Premium Black Tea Granules or Orange Pekoe Powder both work well without milk.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is the difference between Milk Tea Powder and Black Tea Granules?",
            "answer": "<p>Milk Tea Powder is fine-milled for a quick, balanced milk tea. Black Tea Granules are BOP grade for a brighter, cleaner cup.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Does Cardamom Tea contain real cardamom?",
            "answer": "<p>Yes — black tea blended with whole green cardamom.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Does the coffee contain chicory?",
            "answer": "<p>No — Naadan Kerala Coffee is pure Robusta with no chicory.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How should I store tea and coffee?",
            "answer": "<p>Keep in an airtight container, away from direct sunlight and moisture.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How much tea should I use for one cup?",
            "answer": "<p>About 1 teaspoon per cup, adjust to taste.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What are the available pack sizes?",
            "answer": "<p>Most teas are available in 100g, 200g, 400/500g and 800g/1kg sizes.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "When do I get free delivery?",
            "answer": "<p>Add any 2 items and delivery is free — two different teas or coffees, two sizes, or 2 packs of the same one. Orders above ₹649 also ship free.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
