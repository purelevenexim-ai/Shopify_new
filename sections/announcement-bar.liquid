{{ 'announcement-bar-minimal.css' | asset_url | stylesheet_tag }}

<div
  id="announcement-bar-{{ section.id }}"
  class="announcement-bar-minimal"
  data-section-id="{{ section.id }}"
  data-section-type="announcement-bar"
  role="region"
  aria-label="Announcement"
>
  <p class="announcement-bar-minimal__message{% if section.blocks.size > 1 %} hh-ann{% endif %}">
    {%- if section.blocks.size > 0 -%}
      {%- for announcement in section.blocks limit: 3 -%}
        <span class="hh-ann__item" {{ announcement.shopify_attributes }}>
          {%- if announcement.settings.link != blank -%}
            <a href="{{ announcement.settings.link }}" class="announcement-bar-minimal__link">{{- announcement.settings.text | escape -}}</a>
          {%- else -%}
            {{- announcement.settings.text | escape -}}
          {%- endif -%}
        </span>
      {%- endfor -%}
    {%- else -%}
      {{- 'Fresh Kerala spices shipped across India. Free shipping on orders ₹649 and above.' | escape -}}
    {%- endif -%}
  </p>
  {%- if section.settings.fixed_text != blank -%}
    <p class="hh-ann-fixed">
      {%- if section.settings.fixed_link != blank -%}
        <a href="{{ section.settings.fixed_link }}"{% if section.settings.fixed_link contains 'wa.me' %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.fixed_text | escape }}</a>
      {%- else -%}
        {{- section.settings.fixed_text | escape -}}
      {%- endif -%}
    </p>
  {%- endif -%}
</div>
{%- if section.settings.fixed_text != blank -%}
  {%- style -%}
    html body .announcement-bar-minimal .hh-ann-fixed { margin: 5px auto 0; padding: 5px 12px 0; max-width: 520px; border-top: 1px solid rgba(255, 253, 247, 0.22); text-align: center; }
    html body .announcement-bar-minimal .hh-ann-fixed:not(#hh-a):not(#hh-b):not(#hh-c),
    html body .announcement-bar-minimal .hh-ann-fixed a:not(#hh-a):not(#hh-b):not(#hh-c) { color: #FCE477 !important; text-decoration: none; }
    html body .announcement-bar-minimal .hh-ann-fixed a:not(#hh-a):not(#hh-b):not(#hh-c):hover { text-decoration: underline; }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },    
    {
      "type": "text",
      "id": "fixed_text",
      "label": "Always-on line",
      "info": "Shown under the rotating messages on every page. Leave blank to hide."
    },
    {
      "type": "url",
      "id": "fixed_link",
      "label": "Always-on line link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },  
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.heading_utilities.content"
    },
    {
      "type": "paragraph",
         "content": "t:sections.announcement-bar.settings.paragraph.content"
    },             
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label",
      "info": "t:sections.announcement-bar.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_language_selector.info"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
