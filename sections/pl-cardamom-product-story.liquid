{%- if product.handle == 'kerala-cardamom' -%}
  {{ 'pl-product.css' | asset_url | stylesheet_tag }}

  <section class="pl-cardamom-story" aria-labelledby="pl-cardamom-story-title">
    <div class="pl-cardamom-story__inner page-width">
      <div class="pl-cardamom-story__header">
        <p class="pl-cardamom-story__eyebrow">Kerala green cardamom</p>
        <h2 id="pl-cardamom-story-title" class="pl-cardamom-story__title">
          Sweet, fragrant pods chosen for chai, biryani, and everyday spice boxes.
        </h2>
        <p class="pl-cardamom-story__lead">
          Pure Leven Spices & Tea Kerala Cardamom is selected as whole green pods so the natural aroma stays protected until you crush or open the pod in your kitchen.
        </p>
      </div>

      <div class="pl-cardamom-story__grid">
        <figure class="pl-cardamom-story__hero">
          <img
            src="{{ 'pl-cardamom-product.webp' | asset_url }}"
            alt="Pure Leven Spices & Tea Kerala cardamom whole pods packed with loose green cardamom"
            loading="lazy"
            width="1200"
            height="1200"
          >
          <figcaption>Whole pods packed to hold aroma longer.</figcaption>
        </figure>

        <div class="pl-cardamom-story__proof">
          <article class="pl-cardamom-story__proof-card">
            <img
              src="{{ 'pl-cardamom-pods.webp' | asset_url }}"
              alt="Close view of whole green cardamom pods"
              loading="lazy"
              width="1200"
              height="800"
            >
            <div>
              <span>Quality cue</span>
              <h3>Look for full green pods</h3>
              <p>Good cardamom should smell sweet, warm, and clean. Whole pods help protect the volatile oils that give chai and desserts their lift.</p>
            </div>
          </article>

          <article class="pl-cardamom-story__proof-card">
            <img
              src="{{ 'pl-cardamom-harvest.webp' | asset_url }}"
              alt="Cardamom harvesting in a Kerala spice garden"
              loading="lazy"
              width="1200"
              height="900"
            >
            <div>
              <span>Origin cue</span>
              <h3>Closer to the spice garden</h3>
              <p>Clearer sourcing and smaller packing cycles help the pods reach your kitchen with more of their original aroma intact.</p>
            </div>
          </article>
        </div>
      </div>

      <div class="pl-cardamom-story__answers" aria-label="Kerala cardamom buying answers">
        <article>
          <span>Best for</span>
          <strong>Masala chai, payasam, biryani, pulao, desserts, and warm spice blends.</strong>
        </article>
        <article>
          <span>How to use</span>
          <strong>Lightly crush the pod before cooking, or split it and use the seeds for stronger aroma.</strong>
        </article>
        <article>
          <span>How to store</span>
          <strong>Keep sealed in a cool, dry place away from sunlight, heat, and moisture.</strong>
        </article>
      </div>

      <div class="pl-cardamom-story__source">
        <img
          src="{{ 'pl-cardamom-growers.webp' | asset_url }}"
          alt="Pure Leven Spices & Tea growers with freshly collected Kerala cardamom"
          loading="lazy"
          width="1400"
          height="900"
        >
        <div class="pl-cardamom-story__source-copy">
          <p class="pl-cardamom-story__eyebrow">Source transparency</p>
          <h3>Real cardamom, real people, cleaner buying decisions.</h3>
          <p>
            We buy close to the spice gardens of Idukki and pack whole pods in small batches, so the aroma is still there when you open the pouch.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Pure Leven Spices & Tea Kerala Cardamom best used for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pure Leven Spices & Tea Kerala Cardamom is best used for masala chai, biryani, pulao, payasam, desserts, and warm spice blends where sweet natural aroma matters."
          }
        },
        {
          "@type": "Question",
          "name": "Why buy whole green cardamom pods instead of powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whole green cardamom pods protect aroma better than powder because the seeds stay enclosed until the pod is crushed or opened before cooking."
          }
        },
        {
          "@type": "Question",
          "name": "How should Kerala cardamom be stored?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Store Kerala cardamom in an airtight container in a cool, dry place away from heat, sunlight, and moisture to preserve aroma."
          }
        }
      ]
    }
  </script>
{%- endif -%}

{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{%- style -%}
  /* Spice story — skillies language, px only. Styles sit on the inner section so empty renders leave no trace. */
  #shopify-section-{{ section.id }} .pl-cardamom-story { display: block; padding: 56px 0; background: var(--sk-bg2) !important; border-top: 1px solid var(--sk-line); color: var(--sk-fg); font-family: var(--sk-sans); }
  #shopify-section-{{ section.id }} .pl-cardamom-story * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__inner { display: grid; gap: 28px; max-width: var(--sk-wrap) !important; margin: 0 auto; padding: 0 var(--sk-gutter) !important; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__header { display: grid; gap: 14px; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__header > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__eyebrow { margin: 0 !important; color: var(--sk-muted) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__title {
    max-width: 20ch; margin: 0 !important; color: var(--sk-fg) !important; font-family: var(--sk-sans) !important;
    font-size: clamp(30px, 3.8vw, 56px) !important; font-weight: 500 !important; line-height: 1.08 !important; letter-spacing: -0.05em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .pl-cardamom-story__lead { max-width: 58ch; color: var(--sk-muted) !important; font-size: 17px !important; line-height: 1.6 !important; letter-spacing: 0 !important; }

  #shopify-section-{{ section.id }} .pl-cardamom-story__grid { display: grid; gap: 12px; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__hero, #shopify-section-{{ section.id }} .pl-cardamom-story__video-card {
    position: relative; display: block; margin: 0; overflow: hidden;
    background: var(--sk-card) !important; border: 1px solid var(--sk-line) !important; border-radius: 3px !important; box-shadow: none !important;
  }
  #shopify-section-{{ section.id }} .pl-cardamom-story__hero img, #shopify-section-{{ section.id }} .pl-cardamom-story__video-card img, #shopify-section-{{ section.id }} .pl-cardamom-story__video-card video { display: block; width: 100%; aspect-ratio: 1 / 1; height: auto; object-fit: cover; border-radius: 0 !important; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__hero figcaption, #shopify-section-{{ section.id }} .pl-cardamom-story__video-card figcaption, #shopify-section-{{ section.id }} .pl-cardamom-story__video-card > span {
    display: block; width: auto !important; max-width: none !important; margin: 0 !important; padding: 10px 14px !important;
    border: 0 !important; border-top: 1px solid var(--sk-line) !important; border-radius: 0 !important; box-shadow: none !important;
    background: var(--sk-card) !important; backdrop-filter: none !important; transform: none !important;
    color: var(--sk-muted) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; font-size: 10.5px !important; letter-spacing: 0.08em !important;
    position: static !important; inset: auto !important;
  }
  #shopify-section-{{ section.id }} .pl-cardamom-story__proof { display: grid; gap: 12px; align-content: start; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__proof-card, #shopify-section-{{ section.id }} .pl-cardamom-story__copy-card {
    display: grid; grid-template-columns: 104px minmax(0, 1fr); align-items: stretch; overflow: hidden; margin: 0;
    background: var(--sk-card) !important; border: 1px solid var(--sk-line) !important; border-radius: 3px !important; box-shadow: none !important;
  }
  #shopify-section-{{ section.id }} .pl-cardamom-story__proof-card > img, #shopify-section-{{ section.id }} .pl-cardamom-story__proof-card > video { display: block; width: 104px; height: 100%; min-height: 104px; object-fit: cover; border-right: 1px solid var(--sk-line); border-radius: 0 !important; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__proof-card > div, #shopify-section-{{ section.id }} .pl-cardamom-story__copy-card { display: grid; gap: 4px; align-content: start; padding: 14px 16px; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__copy-card { grid-template-columns: 1fr; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__proof-card span, #shopify-section-{{ section.id }} .pl-cardamom-story__copy-card span { color: var(--sk-acc) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; font-size: 10.5px !important; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__proof-card h3, #shopify-section-{{ section.id }} .pl-cardamom-story__copy-card h3 { margin: 0 !important; color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: 17px !important; font-weight: 600 !important; line-height: 1.25 !important; letter-spacing: -0.02em !important; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__proof-card p, #shopify-section-{{ section.id }} .pl-cardamom-story__copy-card p { margin: 0 !important; color: var(--sk-muted) !important; font-size: 14px !important; line-height: 1.5 !important; letter-spacing: 0 !important; }

  #shopify-section-{{ section.id }} .pl-cardamom-story__answers { display: grid; margin: 0; background: var(--sk-card); border: 1px solid var(--sk-line); border-radius: 3px; overflow: hidden; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__answers article { display: grid; gap: 4px; padding: 14px 16px; margin: 0; background: none !important; border: 0 !important; border-radius: 0 !important; box-shadow: none !important; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__answers article + article { border-top: 1px solid var(--sk-line) !important; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__answers span { color: var(--sk-muted) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; font-size: 10.5px !important; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__answers strong { color: var(--sk-fg) !important; font-size: 15px !important; font-weight: 500 !important; line-height: 1.45 !important; letter-spacing: -0.01em !important; }

  #shopify-section-{{ section.id }} .pl-cardamom-story__source { display: grid; gap: 0; overflow: hidden; background: var(--sk-card); border: 1px solid var(--sk-line); border-radius: 3px; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__source > img { display: block; width: 100%; aspect-ratio: 16 / 10; height: auto; object-fit: cover; border-radius: 0 !important; border-bottom: 1px solid var(--sk-line); }
  #shopify-section-{{ section.id }} .pl-cardamom-story__source-copy { display: grid; gap: 8px; align-content: center; padding: 20px 18px; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__source-copy > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__source-copy h3 { color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: 24px !important; font-weight: 500 !important; line-height: 1.12 !important; letter-spacing: -0.035em !important; }
  #shopify-section-{{ section.id }} .pl-cardamom-story__source-copy p:not(#shopify-section-{{ section.id }} .pl-cardamom-story__eyebrow) { color: var(--sk-muted) !important; font-size: 15px !important; line-height: 1.6 !important; letter-spacing: 0 !important; }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pl-cardamom-story { padding: 88px 0; }
    #shopify-section-{{ section.id }} .pl-cardamom-story__inner { gap: 40px; }
    #shopify-section-{{ section.id }} .pl-cardamom-story__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; align-items: start; }
    #shopify-section-{{ section.id }} .pl-cardamom-story__answers { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #shopify-section-{{ section.id }} .pl-cardamom-story__answers article + article { border-top: 0 !important; border-left: 1px solid var(--sk-line) !important; }
    #shopify-section-{{ section.id }} .pl-cardamom-story__answers article { padding: 20px 22px; }
    #shopify-section-{{ section.id }} .pl-cardamom-story__source { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
    #shopify-section-{{ section.id }} .pl-cardamom-story__source > img { aspect-ratio: auto; height: 100%; min-height: 320px; border-bottom: 0; border-right: 1px solid var(--sk-line); }
    #shopify-section-{{ section.id }} .pl-cardamom-story__source-copy { padding: 40px; }
    #shopify-section-{{ section.id }} .pl-cardamom-story__source-copy h3 { font-size: 30px !important; }
  }
{%- endstyle -%}

