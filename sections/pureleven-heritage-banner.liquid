{%- liquid
  assign heritage_label = section.settings.title | strip_html | strip
  if heritage_label == blank
    assign heritage_label = section.settings.eyebrow | strip
  endif
  if heritage_label == blank
    assign heritage_label = 'Kerala heritage banner'
  endif

  assign has_spice_items = false
  assign has_pill_items = false
  for block in section.blocks
    if block.type == 'spice'
      assign has_spice_items = true
    endif
    if block.type == 'pill'
      assign has_pill_items = true
    endif
  endfor
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .pl-hb-{{ section.id }} {
    background: #0B4F45;
  }
  .pl-hb-{{ section.id }} .pl-hb__inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }
  .pl-hb-{{ section.id }} .pl-hb__eyebrow-wrap {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .pl-hb-{{ section.id }} .pl-hb__eyebrow-rule {
    width: 2px;
    height: 22px;
    background: #0EA888;
    border-radius: 1px;
    flex-shrink: 0;
  }
  .pl-hb-{{ section.id }} .pl-hb__eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0EA888;
  }
  .pl-hb-{{ section.id }} .pl-hb__title {
    margin: 0 0 16px;
    font-size: clamp(2.8rem, 4vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: #fff;
  }
  .pl-hb-{{ section.id }} .pl-hb__desc {
    margin: 0 0 32px;
    font-size: 15px;
    line-height: 1.75;
    color: rgba(255,255,255,0.7);
    max-width: 620px;
    margin-left: auto;
    margin-right: auto;
  }
  .pl-hb-{{ section.id }} .pl-hb__desc p { margin: 0 0 8px; }
  .pl-hb-{{ section.id }} .pl-hb__desc p:last-child { margin-bottom: 0; }
  .pl-hb-{{ section.id }} .pl-hb__spice-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 28px;
  }
  .pl-hb-{{ section.id }} .pl-hb__spice-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1.5px solid rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(4px);
  }
  .pl-hb-{{ section.id }} .pl-hb__spice-emoji {
    display: none;
  }
  .pl-hb-{{ section.id }} .pl-hb__spice-chip::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #0EA888;
    flex-shrink: 0;
  }
  .pl-hb-{{ section.id }} .pl-hb__spice-name {
    font-size: 12px;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .pl-hb-{{ section.id }} .pl-hb__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 36px;
  }
  .pl-hb-{{ section.id }} .pl-hb__pill {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(14,168,136,0.4);
    background: rgba(14,168,136,0.1);
    color: #0EA888;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .pl-hb-{{ section.id }} .pl-hb__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    border-radius: 6px;
    background: #fce477;
    color: #121212;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.18s, transform 0.12s;
    border: 1.5px solid #fce477;
  }
  .pl-hb-{{ section.id }} .pl-hb__cta:hover {
    background: #f4d138;
    transform: translateY(-1px);
  }
  .pl-hb-{{ section.id }} .pl-hb__cta svg {
    width: 16px;
    height: 16px;
  }
  .pl-hb-{{ section.id }} .pl-hb__guide-links {
    margin-top: 24px;
    font-size: 13.5px;
    color: rgba(255,255,255,0.5);
    line-height: 1.7;
  }
  .pl-hb-{{ section.id }} .pl-hb__guide-links a {
    color: rgba(255,255,255,0.75);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pl-hb-{{ section.id }} .pl-hb__guide-links a:hover { color: #fff; }
  @media screen and (max-width: 600px) {
    .pl-hb-{{ section.id }} .pl-hb__inner { padding: 0 20px; }
    .pl-hb-{{ section.id }} .pl-hb__spice-row { gap: 8px; }
    .pl-hb-{{ section.id }} .pl-hb__spice-chip { padding: 7px 12px; }
  }
{%- endstyle -%}

<section class="pl-hb-{{ section.id }}" aria-label="{{ heritage_label | escape }}">
  <div class="section-{{ section.id }}-padding">
    <div class="pl-hb__inner">

      {%- if section.settings.eyebrow != blank -%}
      <div class="pl-hb__eyebrow-wrap">
        <span class="pl-hb__eyebrow-rule"></span>
        <span class="pl-hb__eyebrow">{{ section.settings.eyebrow }}</span>
        <span class="pl-hb__eyebrow-rule"></span>
      </div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
      <h2 class="pl-hb__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if has_spice_items -%}
      <div class="pl-hb__spice-row" aria-label="Featured spices">
        {%- for block in section.blocks -%}
          {%- if block.type == 'spice' -%}
          <div class="pl-hb__spice-chip" {{ block.shopify_attributes }}>
            {%- if block.settings.emoji != blank -%}<span class="pl-hb__spice-emoji">{{ block.settings.emoji }}</span>{%- endif -%}
            {%- if block.settings.label != blank -%}<span class="pl-hb__spice-name">{{ block.settings.label }}</span>{%- endif -%}
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
      <div class="pl-hb__desc rte">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if has_pill_items -%}
      <div class="pl-hb__pills" aria-label="Trust highlights">
        {%- for block in section.blocks -%}
          {%- if block.type == 'pill' -%}
          <span class="pl-hb__pill" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="pl-hb__cta">
        {{ section.settings.button_label }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      {%- endif -%}

      {%- if request.page_type == 'index' -%}
      <p class="pl-hb__guide-links">
        Kitchen reading:
        <a href="/blogs/cooking-spices/kerala-spices-farm-origin-vs-retail">Farm-origin vs retail spices</a>,
        <a href="/blogs/cooking-spices/spice-checklist-how-to-check-quality-of-spices">how to check spice quality</a>, and
        <a href="/blogs/cooking-spices/how-to-store-spices">how to store spices at home</a>.
      </p>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pureleven Heritage Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the Hills of Kerala" },
    { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Build a better spice shelf." },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Fresh Kerala Spices" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "spice", "name": "Spice icon", "limit": 6,
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "🫙" },
        { "type": "text", "id": "label", "label": "Label", "default": "Cardamom" }
      ]
    },
    {
      "type": "pill", "name": "Trust pill", "limit": 8,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "No Preservatives" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pureleven Heritage Banner",
      "blocks": [
        { "type": "spice", "settings": { "emoji": "🫙", "label": "Cardamom" } },
        { "type": "spice", "settings": { "emoji": "🌶️", "label": "Black Pepper" } },
        { "type": "spice", "settings": { "emoji": "🌸", "label": "Cloves" } },
        { "type": "spice", "settings": { "emoji": "🫚", "label": "Turmeric" } },
        { "type": "pill", "settings": { "text": "No Preservatives" } },
        { "type": "pill", "settings": { "text": "Farm to Table" } },
        { "type": "pill", "settings": { "text": "FSSAI Certified" } },
        { "type": "pill", "settings": { "text": "Export Quality" } }
      ]
    }
  ]
}
{% endschema %}
