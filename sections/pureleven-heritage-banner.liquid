{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign heritage_label = section.settings.title | strip_html | strip
  if heritage_label == blank
    assign heritage_label = section.settings.eyebrow | strip
  endif
  if heritage_label == blank
    assign heritage_label = 'Kerala heritage banner'
  endif

  assign has_spice_items = false
  assign has_pill_items = false
  for block in section.blocks
    if block.type == 'spice'
      assign has_spice_items = true
    endif
    if block.type == 'pill'
      assign has_pill_items = true
    endif
  endfor
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Closing band — skillies dark band, px only. */
  #shopify-section-{{ section.id }} { background: #0B0B0F !important; color: #fff; font-family: var(--sk-sans); }
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .pl-hb-{{ section.id }} { background: transparent !important; }
  #shopify-section-{{ section.id }} .pl-hb__inner {
    display: grid; gap: 20px; justify-items: start; max-width: var(--sk-wrap) !important; margin: 0 auto; padding: 0 var(--sk-gutter) !important; text-align: left !important;
  }
  #shopify-section-{{ section.id }} .pl-hb__inner > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .pl-hb__eyebrow-wrap { display: block; }
  #shopify-section-{{ section.id }} .pl-hb__eyebrow-rule { display: none !important; }
  #shopify-section-{{ section.id }} .pl-hb__eyebrow {
    color: #9AA0AD !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important;
  }
  #shopify-section-{{ section.id }} .pl-hb__title {
    max-width: 16ch; color: #fff !important; text-align: left !important; font-family: var(--sk-sans) !important;
    font-size: clamp(34px, 4.2vw, 60px) !important; font-weight: 500 !important; line-height: 1.08 !important; letter-spacing: -0.055em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .pl-hb__spice-row, #shopify-section-{{ section.id }} .pl-hb__pills { display: flex; flex-wrap: wrap; justify-content: flex-start !important; gap: 6px; }
  #shopify-section-{{ section.id }} .pl-hb__spice-chip, #shopify-section-{{ section.id }} .pl-hb__pill {
    display: inline-flex; align-items: center; gap: 6px; margin: 0 !important; padding: 7px 9px !important;
    background: transparent !important; border: 1px solid rgba(255, 255, 255, 0.22) !important; border-radius: 2px !important; box-shadow: none !important;
    color: #fff !important; font: 400 10.5px/1.2 var(--sk-mono) !important; letter-spacing: 0.1em !important; text-transform: uppercase !important;
  }
  #shopify-section-{{ section.id }} .pl-hb__pill { color: #9AA0AD !important; }
  #shopify-section-{{ section.id }} .pl-hb__spice-chip::before, #shopify-section-{{ section.id }} .pl-hb__pill::before { content: none !important; }
  #shopify-section-{{ section.id }} .pl-hb__spice-emoji { display: none; }
  #shopify-section-{{ section.id }} .pl-hb__desc, #shopify-section-{{ section.id }} .pl-hb__desc p {
    max-width: 60ch; color: #9AA0AD !important; text-align: left !important; font-family: var(--sk-sans) !important;
    font-size: 15px !important; line-height: 1.65 !important; letter-spacing: 0 !important;
  }
  #shopify-section-{{ section.id }} .pl-hb__desc p { margin: 0 0 10px !important; }
  #shopify-section-{{ section.id }} .pl-hb__desc p:last-child { margin-bottom: 0 !important; }
  #shopify-section-{{ section.id }} .pl-hb__cta {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 14px 24px 14px 26px !important;
    background: #FCE477 !important; border: 1px solid #FCE477 !important; border-radius: 2px !important; box-shadow: none !important;
    color: #16140D !important; text-decoration: none !important; font-family: var(--sk-sans) !important; font-size: 13px !important;
    font-weight: 600 !important; line-height: 1.2 !important; letter-spacing: -0.01em !important; text-transform: none !important;
    transition: background-color 0.2s, transform 0.25s var(--sk-ease);
  }
  #shopify-section-{{ section.id }} .pl-hb__cta:hover { background: #F4D138 !important; border-color: #F4D138 !important; transform: translateY(-1px); }
  #shopify-section-{{ section.id }} .pl-hb__cta svg { width: 14px; height: 14px; transition: transform 0.25s var(--sk-ease); }
  #shopify-section-{{ section.id }} .pl-hb__cta:hover svg { transform: translate(2px, -2px); }
  #shopify-section-{{ section.id }} .pl-hb__guide-links {
    max-width: 60ch; padding-top: 16px; border-top: 1px solid rgba(255, 255, 255, 0.14); color: #9AA0AD !important;
    text-align: left !important; font-size: 14px !important; line-height: 1.7 !important; letter-spacing: 0 !important;
  }
  #shopify-section-{{ section.id }} .pl-hb__guide-links a { color: #fff !important; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255, 255, 255, 0.4); }
  #shopify-section-{{ section.id }} .pl-hb__guide-links a:hover { text-decoration-color: #fff; }
{%- endstyle -%}

<section class="pl-hb-{{ section.id }}" aria-label="{{ heritage_label | escape }}">
  <div class="section-{{ section.id }}-padding">
    <div class="pl-hb__inner">

      {%- if section.settings.eyebrow != blank -%}
      <div class="pl-hb__eyebrow-wrap">
        <span class="pl-hb__eyebrow-rule"></span>
        <span class="pl-hb__eyebrow">{{ section.settings.eyebrow }}</span>
        <span class="pl-hb__eyebrow-rule"></span>
      </div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
      <h2 class="pl-hb__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if has_spice_items -%}
      <div class="pl-hb__spice-row" aria-label="Featured spices">
        {%- for block in section.blocks -%}
          {%- if block.type == 'spice' -%}
          <div class="pl-hb__spice-chip" {{ block.shopify_attributes }}>
            {%- if block.settings.emoji != blank -%}<span class="pl-hb__spice-emoji">{{ block.settings.emoji }}</span>{%- endif -%}
            {%- if block.settings.label != blank -%}<span class="pl-hb__spice-name">{{ block.settings.label }}</span>{%- endif -%}
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
      <div class="pl-hb__desc rte">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if has_pill_items -%}
      <div class="pl-hb__pills" aria-label="Trust highlights">
        {%- for block in section.blocks -%}
          {%- if block.type == 'pill' -%}
          <span class="pl-hb__pill" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="pl-hb__cta">
        {{ section.settings.button_label }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      {%- endif -%}

      {%- if request.page_type == 'index' -%}
      <p class="pl-hb__guide-links">
        Kitchen reading:
        <a href="/blogs/cooking-spices/kerala-spices-farm-origin-vs-retail">Farm-origin vs retail spices</a>,
        <a href="/blogs/cooking-spices/spice-checklist-how-to-check-quality-of-spices">how to check spice quality</a>, and
        <a href="/blogs/cooking-spices/how-to-store-spices">how to store spices at home</a>.
      </p>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pureleven Heritage Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the Hills of Kerala" },
    { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Build a better spice shelf." },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Fresh Kerala Spices" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "spice", "name": "Spice icon", "limit": 6,
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "🫙" },
        { "type": "text", "id": "label", "label": "Label", "default": "Cardamom" }
      ]
    },
    {
      "type": "pill", "name": "Trust pill", "limit": 8,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "No Preservatives" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pureleven Heritage Banner",
      "blocks": [
        { "type": "spice", "settings": { "emoji": "🫙", "label": "Cardamom" } },
        { "type": "spice", "settings": { "emoji": "🌶️", "label": "Black Pepper" } },
        { "type": "spice", "settings": { "emoji": "🌸", "label": "Cloves" } },
        { "type": "spice", "settings": { "emoji": "🫚", "label": "Turmeric" } },
        { "type": "pill", "settings": { "text": "No Preservatives" } },
        { "type": "pill", "settings": { "text": "Farm to Table" } },
        { "type": "pill", "settings": { "text": "FSSAI Certified" } },
        { "type": "pill", "settings": { "text": "Export Quality" } }
      ]
    }
  ]
}
{% endschema %}
