{%- comment -%}
Tea & Coffee Drink Selector Section
- "How do you drink your tea?" with 4 product recommendation cards
- Each card: use-case → product recommendation
- Clickable cards that scroll to product or add to cart
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'tc-design-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'tc-page.css' | asset_url }}">

<section class="tc-drink-selector" id="tc-drink-selector-{{ section.id }}">
  <div class="tc-drink-selector__container">
    <p class="tc-eyebrow"><i>04</i> / Find Your Cup</p>
    {%- if section.settings.heading -%}
      <h2 class="tc-drink-selector__heading tc-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="tc-drink-selector__grid">
      {%- assign drinks = 'Milk Tea & Kadak Chai,BOP Black Tea,Elaichi / Cardamom Chai,Orange Pekoe Black Tea' | split: ',' -%}
      {%- assign products = 'premium-milk-tea-powder,premium-black-tea-granules,cardamom-tea,orange-pekoe-powder' | split: ',' -%}
      {%- assign icons = '☕,🍵,🧋,🫖' | split: ',' -%}

      {%- for i in (0..3) -%}
        <div class="tc-drink-selector__card" data-drink-index="{{ i }}">
          <div class="tc-drink-selector__icon">{{ icons[i] }}</div>
          <h3 class="tc-drink-selector__card-title">I drink…</h3>
          <p class="tc-drink-selector__card-use-case">{{ drinks[i] }}</p>
          <button class="tc-drink-selector__button" data-product-handle="{{ products[i] }}">
            Shop Now
          </button>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%} Drink Selector JavaScript (Click to scroll/select) {%- endcomment -%}
<script type="module">
  // Scoped to this section's own buttons only — the products grid reuses
  // [data-product-handle] on its wrapper divs for a different purpose, so a
  // bare `[data-product-handle]` selector here would wrongly attach to those too.
  document.querySelectorAll('.tc-drink-selector__button').forEach(button => {
    button.addEventListener('click', (e) => {
      const handle = e.currentTarget.dataset.productHandle;
      const card = e.currentTarget.closest('.tc-drink-selector__card');

      // Scroll to the matching product card in the grid (if it exists)
      const productSection = document.querySelector(`.tc-products__item[data-product-handle="${handle}"]`);
      if (productSection) {
        productSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      // Fire analytics event
      if (window.gtag && card) {
        gtag('event', 'tea_coffee_drink_selector_click', {
          drink_type: card.textContent.trim()
        });
      }
    });
  });
</script>

{%- comment -%} Section Settings Schema {%- endcomment -%}

{% schema %}
{
  "name": "TC Drink Selector",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "How do you drink your tea?"
    }
  ],
  "presets": [
    {
      "name": "TC Drink Selector"
    }
  ]
}
{% endschema %}
