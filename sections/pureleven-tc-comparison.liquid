{%- comment -%}
Tea & Coffee Comparison Table Section
- Displays: Best for | Strength | Cup type | Preparation | Available sizes
- Pulls data from product metafields
- Mobile: horizontal scroll or card stack option
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'tc-design-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'tc-page.css' | asset_url }}">

<section class="tc-comparison" id="tc-comparison-{{ section.id }}">
  <div class="tc-comparison__container">
    <p class="tc-eyebrow"><i>06</i> / Compare</p>
    {%- if section.settings.heading -%}
      <h2 class="tc-comparison__heading tc-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- assign products = 'premium-milk-tea-powder,premium-black-tea-granules,cardamom-tea,orange-pekoe-powder' | split: ',' -%}

    <div class="tc-comparison__table-wrapper">
      <table class="tc-comparison__table">
        <thead>
          <tr class="tc-comparison__header-row">
            <th class="tc-comparison__header-cell tc-comparison__header-cell--label">Tea</th>
            <th class="tc-comparison__header-cell">Best For</th>
            <th class="tc-comparison__header-cell">Strength</th>
            <th class="tc-comparison__header-cell">Cup Type</th>
            <th class="tc-comparison__header-cell">Preparation</th>
            {%- if section.settings.show_sizes -%}
              <th class="tc-comparison__header-cell">Sizes</th>
            {%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for product_handle in products -%}
            {%- assign product = all_products[product_handle] -%}
            {%- if product -%}
              {%- assign best_for = product.metafields.custom.best_for.value | default: '' -%}
              {%- assign strength = product.metafields.custom.strength.value | default: '' -%}
              {%- assign cup_type = product.metafields.custom.cup_type.value | default: '' -%}
              {%- assign brew_method = product.metafields.custom.brew_method.value | default: '' -%}

              <tr class="tc-comparison__body-row">
                <td class="tc-comparison__body-cell tc-comparison__body-cell--label">
                  <a href="{{ product.url }}" class="tc-comparison__product-link">
                    {{ product.title }}
                  </a>
                </td>
                <td class="tc-comparison__body-cell" data-label="Best for">{{ best_for | default: '—' }}</td>
                <td class="tc-comparison__body-cell" data-label="Strength">{{ strength | default: '—' }}</td>
                <td class="tc-comparison__body-cell" data-label="Cup">{{ cup_type | default: '—' }}</td>
                <td class="tc-comparison__body-cell" data-label="Preparation">{{ brew_method | default: '—' }}</td>
                {%- if section.settings.show_sizes -%}
                  <td class="tc-comparison__body-cell" data-label="Sizes">{% for v in product.variants %}{{ v.title }}{% unless forloop.last %}, {% endunless %}{% endfor %}</td>
                {%- endif -%}
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>

  </div>
</section>

{%- comment -%} Section Settings Schema {%- endcomment -%}

{% schema %}
{
  "name": "Tea & Coffee Comparison",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Which tea is right for you?"
    },
    {
      "type": "checkbox",
      "id": "show_sizes",
      "label": "Show available sizes note",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Tea & Coffee Comparison"
    }
  ]
}
{% endschema %}
