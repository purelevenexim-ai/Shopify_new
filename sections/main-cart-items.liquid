{{ 'pl-cart-b.css' | asset_url | stylesheet_tag }}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
<script src="{{ 'pl-cart-b.js' | asset_url }}" defer="defer"></script>

{%- liquid
  comment
    Totals are worked out once here and passed down, so the delivery panel, the
    summary and the checkout control can never disagree with each other.
    cmp_p is the compare-at saving; disc_p is any order-level discount.
    Delivery values come from Theme settings > PureLeven cart and checkout, the
    same place the checkout page reads them, so the two pages quote one number.

    Free delivery also comes from an item count (free_shipping_min_items). That
    mirrors the automatic free-shipping discount in Shopify admin, which does
    not combine with discount codes, so a code in the cart switches it off.
  endcomment
  assign threshold_p = settings.pl_free_shipping_threshold | default: 649 | times: 100

  assign total_p = cart.total_price
  assign disc_p = cart.items_subtotal_price | minus: cart.total_price

  assign cmp_p = 0
  for item in cart.items
    if item.variant.compare_at_price > item.final_price
      assign ls = item.variant.compare_at_price | minus: item.final_price | times: item.quantity
      assign cmp_p = cmp_p | plus: ls
    endif
  endfor
  assign mrp_p = cart.items_subtotal_price | plus: cmp_p

  assign min_items = section.settings.free_shipping_min_items | default: 0
  assign has_code = false
  for app in cart.discount_applications
    if app.type == 'discount_code'
      assign has_code = true
    endif
  endfor
  assign items_left = 0
  if min_items > 0 and has_code == false
    assign items_left = min_items | minus: cart.item_count
    if items_left < 0
      assign items_left = 0
    endif
  endif

  assign ship_free = false
  if total_p >= threshold_p
    assign ship_free = true
  elsif min_items > 0 and has_code == false and items_left == 0
    assign ship_free = true
  endif

  comment
    Delivery is charged by Shopify at checkout: Kerala from Rs 40, other states
    by weight on the India Post rate card. The cart cannot know the state, so it
    shows the total before delivery instead of guessing a number.
  endcomment
  assign grand_p = total_p

  assign remaining_p = threshold_p | minus: total_p
  if remaining_p < 0
    assign remaining_p = 0
  endif

  assign pct = 0
  if items_left > 0
    assign pct = cart.item_count | times: 100 | divided_by: min_items
  elsif threshold_p > 0
    assign pct = total_p | times: 100 | divided_by: threshold_p
    if pct > 100
      assign pct = 100
    endif
  endif
  if ship_free
    assign pct = 100
  endif

  comment
    Defaults are repeated here rather than left to the schema: the theme
    editor saves empty strings, and an empty string counts as "set".
  endcomment
  assign g_rating = section.settings.google_rating | default: '4.9'
  assign g_reviews = section.settings.google_review_count | default: '56'
  assign r_name = section.settings.review_name | default: 'Rony Mathew'
  assign r_date = section.settings.review_date | default: 'June 2026'
  assign r_rating = section.settings.review_rating | default: 5
  assign r_text = section.settings.review_text | default: 'Authentic Kerala spices... Courteous customer support and they ensured timely delivery though we are based in Western India... Keep it up'

  if section.settings.review_photo != blank
    assign r_photo = section.settings.review_photo | image_url: width: 120
  else
    assign r_photo = 'pl-review-rony.jpg' | asset_url
  endif
-%}

<cart-items class="plb{% if cart == empty %} is-empty{% endif %}" data-eta="{{ settings.pl_eta_days | default: 3 }}">
  {%- if cart != empty -%}
    <div class="page-width">
      <div class="plb-grid">

        <div class="plb-main">
          <header class="plb-head">
            <p class="plb-lbl">PureLeven / Cart</p>
            <h1>Your cart.</h1>
            <div class="plb-head__row">
              <p class="plb-sub">{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %} &middot; packed by hand in Idukki</p>
              <a href="{{ routes.all_products_collection_url }}">Keep shopping</a>
            </div>
          </header>

          <section class="plb-panel" aria-label="Items in your cart">
            <header class="plb-ph">
              <p class="plb-lbl"><i>01</i> / Your order</p>
              <p class="plb-ph__meta">{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}</p>
            </header>
            <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart__contents">
              <div id="main-cart-items" data-id="{{ section.id }}">
                <ul class="plb-items js-contents" role="list">
                  {%- for item in cart.items -%}
                    {% render 'plb-item', item: item %}
                  {%- endfor -%}
                </ul>
              </div>
              <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
              <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">
                {{ 'accessibility.loading' | t }}
              </p>
            </form>
          </section>

          {% render 'plb-goal',
            total_p: total_p, threshold_p: threshold_p, remaining_p: remaining_p,
            pct: pct, ship_free: ship_free,
            items_left: items_left, min_items: min_items %}
        </div>

        <aside class="plb-side" aria-label="Order summary">
          {%- comment -%} Required stub: cart.js resolves the section id from this. {%- endcomment -%}
          <div id="main-cart-footer" data-id="{{ section.id }}" hidden><div class="js-contents"></div></div>

          {% render 'plb-bill',
            mrp_p: mrp_p, cmp_p: cmp_p, disc_p: disc_p,
            ship_free: ship_free, grand_p: grand_p,
            rating: g_rating, reviews: g_reviews %}

          {%- if section.settings.show_review -%}
            {% render 'plb-review',
              name: r_name, date: r_date, rating: r_rating, text: r_text, photo: r_photo %}
          {%- endif -%}
        </aside>

      </div>
    </div>
  {%- else -%}

    <div class="page-width">
      <div class="plb-empty">
        <p class="plb-lbl">PureLeven / Cart</p>
        <h1>{{ 'sections.cart.empty' | t }}</h1>
        <p>Fresh from Idukki. Start with the pepper or the cardamom.</p>
        <a href="{{ routes.all_products_collection_url }}" class="plb-cta plb-cta--solo">{{ 'general.continue_shopping' | t }}</a>
      </div>
      <div id="main-cart-footer" data-id="{{ section.id }}" hidden><div class="js-contents"></div></div>
    </div>

  {%- endif -%}
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    { "type": "header", "content": "Free delivery" },
    {
      "type": "number",
      "id": "free_shipping_min_items",
      "label": "Free delivery from this many items (0 = off)",
      "info": "Must match the automatic free-shipping discount in Shopify admin.",
      "default": 2
    },
    { "type": "header", "content": "Trust line" },
    { "type": "text", "id": "google_rating", "label": "Google rating", "default": "4.9" },
    { "type": "text", "id": "google_review_count", "label": "Google review count", "default": "56" },
    { "type": "header", "content": "Customer review" },
    { "type": "checkbox", "id": "show_review", "label": "Show the review", "default": true },
    { "type": "text", "id": "review_name", "label": "Name", "default": "Rony Mathew" },
    { "type": "text", "id": "review_date", "label": "Date", "default": "June 2026" },
    { "type": "range", "id": "review_rating", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
    {
      "type": "textarea",
      "id": "review_text",
      "label": "Review text",
      "default": "Authentic Kerala spices... Courteous customer support and they ensured timely delivery though we are based in Western India... Keep it up"
    },
    { "type": "image_picker", "id": "review_photo", "label": "Photo", "info": "Leave empty to use the built-in photo." }
  ]
}
{% endschema %}
