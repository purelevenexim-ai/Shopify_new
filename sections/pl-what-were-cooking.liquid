{{ 'pl-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign h = product.handle

  # Per-product recipe data: name|icon triples separated by ~
  if h contains 'black-pepper' or h contains 'pepper-masala' or h contains 'white-pepper'
    if h contains 'white-pepper'
      assign recipes = "Cream of Tomato Soup|bowl~White Pepper Chicken|pan~Kerala Pepper Noodles|pan"
    else
      assign recipes = "Pepper Rasam|bowl~Black Pepper Chicken|pan~Kerala Pepper Curry|pot"
    endif
  elsif h contains 'cardamom'
    assign recipes = "Masala Chai|cup~Elaichi Kheer|bowl~Cardamom Biryani|pot"
  elsif h contains 'star-anise'
    assign recipes = "Dum Biryani|pot~Star Anise Chai|cup~Braised Mutton|pan"
  elsif h contains 'clove'
    assign recipes = "Biryani|pot~Mulled Spice Chai|cup~Kerala Beef Fry|pan"
  elsif h contains 'cinnamon'
    assign recipes = "Cinnamon Chai|cup~Rice Kheer|bowl~Cinnamon Oatmeal|bowl"
  elsif h contains 'turmeric'
    assign recipes = "Haldi Doodh (Golden Milk)|cup~Turmeric Rice|bowl~Golden Soup|bowl"
  elsif h contains 'coffee'
    assign recipes = "South Indian Filter Coffee|cup~Cold Brew Coffee|cup~Cardamom Coffee|cup"
  elsif h contains 'coriander'
    assign recipes = "Dal Tadka|pot~Coriander Chicken|pan~Fresh Coriander Chutney|bowl"
  elsif h contains 'chilly' or h contains 'chilli' or h contains 'chili'
    assign recipes = "Chicken Curry|pot~Chilli Paneer|pan~Kerala Egg Roast|pan"
  elsif h contains 'ginger'
    assign recipes = "Ginger Tea|cup~Ginger Chicken|pan~Ginger Lemonade|cup"
  else
    assign recipes = "Kerala Masala Curry|pot~Biryani|pot~Masala Chai|cup"
  endif

  assign recipe_parts = recipes | split: "~"
-%}

<section class="pl-cooking">
  <div class="pl-cooking__inner">
    <h2 class="pl-cooking__heading">{{ section.settings.heading | default: "What we're cooking" }}</h2>
    <div class="pl-cooking__list">
      {%- for item in recipe_parts -%}
        {%- assign parts = item | split: "|" -%}
        {%- assign rname = parts[0] -%}
        {%- assign ricon = parts[1] -%}
        <div class="pl-cooking__row">
          <span class="pl-cooking__icon">
            {%- case ricon -%}
              {%- when 'cup' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></svg>
              {%- when 'pot' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h18v7a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"/><line x1="1" y1="9" x2="3" y2="9"/><line x1="21" y1="9" x2="23" y2="9"/><path d="M8 6c0-1.5 1-2 2-2"/><path d="M14 6c0-1.5 1-2 2-2"/></svg>
              {%- when 'bowl' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 11h20a10 10 0 0 1-20 0z"/><path d="M7 7c0-1.5 1-2.5 2.5-2.5"/><path d="M12 6c0-1.5 1-2.5 2.5-2.5"/></svg>
              {%- when 'pan' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="13" r="7"/><line x1="16" y1="13" x2="23" y2="13"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
            {%- endcase -%}
          </span>
          <span class="pl-cooking__name">{{ rname }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{%- style -%}
  /* What we're cooking — skillies numbered list, px only. */
  #shopify-section-{{ section.id }} .pl-cooking { display: block; padding: 56px 0; background: var(--sk-bg2) !important; border-top: 1px solid var(--sk-line); color: var(--sk-fg); font-family: var(--sk-sans); }
  #shopify-section-{{ section.id }} .pl-cooking * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .pl-cooking__inner { display: grid; gap: 20px; max-width: var(--sk-wrap) !important; margin: 0 auto; padding: 0 var(--sk-gutter) !important; background: none !important; border: 0 !important; box-shadow: none !important; }
  #shopify-section-{{ section.id }} .pl-cooking__heading {
    margin: 0 !important; color: var(--sk-fg) !important; text-align: left !important; font-family: var(--sk-sans) !important;
    font-size: clamp(28px, 3.2vw, 44px) !important; font-weight: 500 !important; line-height: 1.1 !important; letter-spacing: -0.045em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .pl-cooking__heading::before { content: 'In the kitchen'; display: block; margin-bottom: 14px; color: var(--sk-muted); font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; }
  #shopify-section-{{ section.id }} .pl-cooking__list { display: grid; gap: 0 !important; margin: 0; padding: 0; background: var(--sk-card); border: 1px solid var(--sk-line); border-radius: 3px; overflow: hidden; counter-reset: ck; }
  #shopify-section-{{ section.id }} .pl-cooking__row {
    display: flex !important; align-items: center; gap: 14px; margin: 0 !important; padding: 16px !important;
    background: none !important; border: 0 !important; border-radius: 0 !important; box-shadow: none !important; counter-increment: ck;
  }
  #shopify-section-{{ section.id }} .pl-cooking__row + .pl-cooking__row { border-top: 1px solid var(--sk-line) !important; }
  #shopify-section-{{ section.id }} .pl-cooking__row::before { content: counter(ck, decimal-leading-zero); flex: none; width: 22px; color: var(--sk-acc); font: 700 11px/1 var(--sk-mono); }
  #shopify-section-{{ section.id }} .pl-cooking__icon {
    display: grid !important; place-items: center; flex: none; width: 36px; height: 36px;
    background: var(--sk-acc-soft) !important; border: 1px solid var(--sk-line) !important; border-radius: 2px !important; color: var(--sk-acc) !important;
  }
  #shopify-section-{{ section.id }} .pl-cooking__icon svg { width: 18px; height: 18px; }
  #shopify-section-{{ section.id }} .pl-cooking__name { color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: 16px !important; font-weight: 500 !important; letter-spacing: -0.01em !important; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pl-cooking { padding: 72px 0; }
    #shopify-section-{{ section.id }} .pl-cooking__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #shopify-section-{{ section.id }} .pl-cooking__row + .pl-cooking__row { border-top: 0 !important; border-left: 1px solid var(--sk-line) !important; }
    #shopify-section-{{ section.id }} .pl-cooking__row { padding: 20px 22px !important; }
  }
{%- endstyle -%}
{% schema %}
{
  "name": "What we're cooking",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What we're cooking"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "What we're cooking"
    }
  ]
}
{% endschema %}
