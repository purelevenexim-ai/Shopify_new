{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} { padding: 56px 0; background: var(--sk-bg2) !important; border-top: 1px solid var(--sk-line); color: var(--sk-fg); font-family: var(--sk-sans); }
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .hn-story { display: grid; gap: 56px; max-width: var(--sk-wrap); margin: 0 auto; padding: 0 var(--sk-gutter); }
  #shopify-section-{{ section.id }} .hn-story__top { display: grid; gap: 28px; }
  #shopify-section-{{ section.id }} .hn-story__top > div:first-child { display: grid; gap: 16px; align-content: start; }
  #shopify-section-{{ section.id }} .hn-story__top > div:first-child > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .hn-story__eyebrow, #shopify-section-{{ section.id }} .hn-types__eyebrow { color: var(--sk-muted) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; }
  #shopify-section-{{ section.id }} .hn-story__heading { max-width: 16ch; color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: clamp(34px, 4.2vw, 60px) !important; font-weight: 500 !important; line-height: 1.08 !important; letter-spacing: -0.055em !important; text-transform: none !important; }
  #shopify-section-{{ section.id }} .hn-story__body { max-width: 60ch; color: var(--sk-fg2) !important; font-family: var(--sk-sans) !important; font-size: 15px !important; line-height: 1.65 !important; letter-spacing: 0 !important; }
  #shopify-section-{{ section.id }} .hn-story__facts {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; margin-top: 8px !important;
    background: var(--sk-card); border: 1px solid var(--sk-line); border-radius: 3px; overflow: hidden;
  }
  #shopify-section-{{ section.id }} .hn-story__fact { padding: 12px 14px; background: none !important; border: 0 !important; border-radius: 0 !important; box-shadow: none !important; }
  #shopify-section-{{ section.id }} .hn-story__fact:nth-child(even) { border-left: 1px solid var(--sk-line) !important; }
  #shopify-section-{{ section.id }} .hn-story__fact:nth-child(n+3) { border-top: 1px solid var(--sk-line) !important; }
  #shopify-section-{{ section.id }} .hn-story__fact-label { color: var(--sk-muted) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.1em !important; text-transform: uppercase !important; }
  #shopify-section-{{ section.id }} .hn-story__fact-value { margin-top: 2px; color: var(--sk-fg) !important; font-size: 14px !important; font-weight: 600 !important; line-height: 1.35; letter-spacing: -0.01em; }
  #shopify-section-{{ section.id }} .hn-story__stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; align-content: start; }
  #shopify-section-{{ section.id }} .hn-stat {
    display: grid; gap: 8px; align-content: start; padding: 18px 16px; text-align: left !important;
    background: var(--sk-card) !important; border: 1px solid var(--sk-line) !important; border-radius: 3px !important; box-shadow: none !important;
  }
  #shopify-section-{{ section.id }} .hn-stat__num { color: var(--sk-acc) !important; font-family: var(--sk-sans) !important; font-size: 30px !important; font-weight: 500 !important; line-height: 1 !important; letter-spacing: -0.04em !important; }
  #shopify-section-{{ section.id }} .hn-stat__label { color: var(--sk-muted) !important; font-size: 13px !important; line-height: 1.45 !important; letter-spacing: 0 !important; }
  #shopify-section-{{ section.id }} .hn-stat--wide { grid-column: 1 / -1; display: block; }
  #shopify-section-{{ section.id }} .hn-stat__icon { display: none !important; }
  #shopify-section-{{ section.id }} .hn-stat--wide .hn-stat__body { display: grid; gap: 6px; }
  #shopify-section-{{ section.id }} .hn-stat--wide .hn-stat__num { color: var(--sk-fg) !important; font-size: 17px !important; font-weight: 600 !important; line-height: 1.3 !important; letter-spacing: -0.02em !important; }
  #shopify-section-{{ section.id }} .hn-types { display: grid; gap: 16px; }
  #shopify-section-{{ section.id }} .hn-types > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .hn-types__title { max-width: 18ch; color: var(--sk-fg) !important; text-align: left !important; font-family: var(--sk-sans) !important; font-size: clamp(28px, 3vw, 44px) !important; font-weight: 500 !important; line-height: 1.08 !important; letter-spacing: -0.05em !important; }
  #shopify-section-{{ section.id }} .hn-types__grid { display: grid; gap: 12px; margin-top: 12px !important; counter-reset: ht; }
  #shopify-section-{{ section.id }} .hn-type {
    display: grid; gap: 10px; align-content: start; padding: 20px 18px; counter-increment: ht;
    background: var(--sk-card) !important; border: 1px solid var(--sk-line) !important; border-radius: 3px !important; box-shadow: none !important;
  }
  #shopify-section-{{ section.id }} .hn-type::before { content: counter(ht, decimal-leading-zero); color: var(--sk-acc); font: 700 14px/1 var(--sk-mono); }
  #shopify-section-{{ section.id }} .hn-type__icon { display: none !important; }
  #shopify-section-{{ section.id }} .hn-type__name { color: var(--sk-fg) !important; font-size: 22px !important; font-weight: 500 !important; line-height: 1.12 !important; letter-spacing: -0.03em !important; }
  #shopify-section-{{ section.id }} .hn-type__desc { color: var(--sk-muted) !important; font-size: 15px !important; line-height: 1.45 !important; letter-spacing: 0 !important; }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} { padding: 88px 0; }
    #shopify-section-{{ section.id }} .hn-story { gap: 80px; }
    #shopify-section-{{ section.id }} .hn-story__top { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 56px; align-items: start; }
    #shopify-section-{{ section.id }} .hn-types__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  }
{%- endstyle -%}

<div class="hn-story">
  <div class="hn-story__top">
    <div>
      <p class="hn-story__eyebrow">From the Forests</p>
      <h2 class="hn-story__heading">From Idukki's High-Range Forests to Your Home</h2>
      <p class="hn-story__body">Kerala's forests — especially the high ranges of Idukki and the green hills of Wayanad — produce some of India's finest wild honey. The bees forage across cardamom estates, wild flora, and forest blooms.</p>
      <p class="hn-story__body">Our Naadan honey is collected by traditional beekeepers who have worked these forests for generations. Filtered, not heated — so the natural enzymes, pollen, and forest aroma stay in every jar.</p>
      <div class="hn-story__facts">
        <div class="hn-story__fact">
          <div class="hn-story__fact-label">Source</div>
          <div class="hn-story__fact-value">Idukki & Wayanad</div>
        </div>
        <div class="hn-story__fact">
          <div class="hn-story__fact-label">Type</div>
          <div class="hn-story__fact-value">Wild forest, Naadan</div>
        </div>
        <div class="hn-story__fact">
          <div class="hn-story__fact-label">Processing</div>
          <div class="hn-story__fact-value">Filtered, not heated</div>
        </div>
        <div class="hn-story__fact">
          <div class="hn-story__fact-label">Additives</div>
          <div class="hn-story__fact-value">None — pure honey</div>
        </div>
      </div>
    </div>
    <div class="hn-story__stats">
      <div class="hn-stat">
        <div class="hn-stat__num">800m+</div>
        <div class="hn-stat__label">Altitude in Idukki forests</div>
      </div>
      <div class="hn-stat">
        <div class="hn-stat__num">0</div>
        <div class="hn-stat__label">Added ingredients or preservatives</div>
      </div>
      <div class="hn-stat">
        <div class="hn-stat__num">100%</div>
        <div class="hn-stat__label">Natural, raw honey from Kerala</div>
      </div>
      <div class="hn-stat">
        <div class="hn-stat__num">3rd Gen</div>
        <div class="hn-stat__label">Kerala beekeepers supplying us</div>
      </div>
      <div class="hn-stat hn-stat--wide">
        <span class="hn-stat__icon">🍯</span>
        <div class="hn-stat__body">
          <div class="hn-stat__num">Why does it crystallise?</div>
          <div class="hn-stat__label">Crystallisation is the proof it was never heated. Raw honey naturally solidifies — it's a quality signal, not spoilage.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="hn-types">
    <p class="hn-types__eyebrow">Know Your Honey</p>
    <h3 class="hn-types__title">Understanding Kerala Honey</h3>
    <div class="hn-types__grid">
      <div class="hn-type">
        <div class="hn-type__icon">🌳</div>
        <div class="hn-type__name">Wild Forest Honey</div>
        <div class="hn-type__desc">From wild bee colonies in Idukki and Wayanad forests. Darker, richer, with a complex flavour from diverse forest flora. The most prized variety.</div>
      </div>
      <div class="hn-type">
        <div class="hn-type__icon">🍯</div>
        <div class="hn-type__name">Naadan Honey</div>
        <div class="hn-type__desc">Traditional Kerala honey from local beekeepers. Lighter, milder, and great for everyday use in tea, food, or eating directly. The household favourite.</div>
      </div>
      <div class="hn-type">
        <div class="hn-type__icon">⚗️</div>
        <div class="hn-type__name">Processed vs Raw</div>
        <div class="hn-type__desc">Processed honey is heated to stop crystallisation — this destroys enzymes and strips the aroma. Ours is filtered only, so everything the bees put in stays in.</div>
      </div>
    </div>
  </div>
</div>

