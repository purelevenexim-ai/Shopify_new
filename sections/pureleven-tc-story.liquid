{%- comment -%}
Tea & Coffee Sourcing Story Section
- "Selected for the cup" — 3-step visual: Source → Evaluate → Pack
- Fixed 3-column layout, avoids generic "organic" claims per brief
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'tc-design-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'tc-page.css' | asset_url }}">

<section class="tc-story">
  <div class="tc-story__container">
    <p class="tc-eyebrow"><i>08</i> / Our Story</p>
    {%- if section.settings.heading -%}
      <h2 class="tc-story__heading tc-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.intro -%}
      <p class="tc-story__intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    <div class="tc-story__steps">
      <div class="tc-story__step">
        <div class="tc-story__step-number">01</div>
        <h3 class="tc-story__step-title">{{ section.settings.step_1_title }}</h3>
        <p class="tc-story__step-copy">{{ section.settings.step_1_copy }}</p>
      </div>

      <div class="tc-story__connector" aria-hidden="true"></div>

      <div class="tc-story__step">
        <div class="tc-story__step-number">02</div>
        <h3 class="tc-story__step-title">{{ section.settings.step_2_title }}</h3>
        <p class="tc-story__step-copy">{{ section.settings.step_2_copy }}</p>
      </div>

      <div class="tc-story__connector" aria-hidden="true"></div>

      <div class="tc-story__step">
        <div class="tc-story__step-number">03</div>
        <h3 class="tc-story__step-title">{{ section.settings.step_3_title }}</h3>
        <p class="tc-story__step-copy">{{ section.settings.step_3_copy }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TC Sourcing Story",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Selected for the cup"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro copy",
      "default": "We don't choose tea from a photograph. It's selected by checking what matters in the cup — taste, colour, aroma and how it performs when brewed."
    },
    {
      "type": "text",
      "id": "step_1_title",
      "label": "Step 1 title",
      "default": "Source"
    },
    {
      "type": "textarea",
      "id": "step_1_copy",
      "label": "Step 1 copy",
      "default": "We search for teas that perform beautifully in the cup."
    },
    {
      "type": "text",
      "id": "step_2_title",
      "label": "Step 2 title",
      "default": "Evaluate"
    },
    {
      "type": "textarea",
      "id": "step_2_copy",
      "label": "Step 2 copy",
      "default": "Checked for taste, colour, aroma and brew consistency."
    },
    {
      "type": "text",
      "id": "step_3_title",
      "label": "Step 3 title",
      "default": "Pack"
    },
    {
      "type": "textarea",
      "id": "step_3_copy",
      "label": "Step 3 copy",
      "default": "Packed fresh in small batches to preserve quality."
    }
  ],
  "presets": [
    { "name": "TC Sourcing Story" }
  ]
}
{% endschema %}
