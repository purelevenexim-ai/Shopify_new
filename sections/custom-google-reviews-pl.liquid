{% comment %} Custom Google Reviews — Google-authentic design {% endcomment %}

{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
<style>
  /* Google reviews strip — skillies language, px only. */
  html body .pl-gr-{{ section.id }} { max-width: var(--sk-wrap) !important; margin: 0 auto; padding: 0 var(--sk-gutter) !important; color: var(--sk-fg); font-family: var(--sk-sans); }
  html body .pl-gr-{{ section.id }} * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} { background: var(--sk-bg) !important; border-bottom: 1px solid var(--sk-line); }
  html body .pl-gr-{{ section.id }} .pl-gr-wrapper { padding: 36px 0 32px !important; background: none !important; border: 0 !important; box-shadow: none !important; }
  html body .pl-gr-{{ section.id }} .pl-gr-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 16px; margin: 0 0 18px; padding: 0; border: 0; }
  html body .pl-gr-{{ section.id }} .pl-gr-summary { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  html body .pl-gr-{{ section.id }} .pl-gr-stars-group { display: flex; gap: 1px; }
  html body .pl-gr-{{ section.id }} .pl-gr-star { color: var(--sk-acc); font-size: 14px; line-height: 1; }
  html body .pl-gr-{{ section.id }} .pl-gr-big-num { color: var(--sk-fg); font-size: 20px; font-weight: 600; line-height: 1; letter-spacing: -0.03em; }
  html body .pl-gr-{{ section.id }} .pl-gr-dot { color: var(--sk-faint); }
  html body .pl-gr-{{ section.id }} .pl-gr-rev-count,
  html body .pl-gr-{{ section.id }} .pl-gr-leave-link {
    color: var(--sk-fg2) !important; text-decoration: none !important; border-bottom: 1px solid var(--sk-line2); padding-bottom: 1px;
    font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important;
    transition: color 0.2s, border-color 0.2s;
  }
  html body .pl-gr-{{ section.id }} .pl-gr-leave-link { color: var(--sk-acc) !important; border-color: currentColor; }
  html body .pl-gr-{{ section.id }} .pl-gr-rev-count:hover, html body .pl-gr-{{ section.id }} .pl-gr-leave-link:hover { color: var(--sk-acc-hover) !important; }
  html body .pl-gr-{{ section.id }} .pl-gr-summary svg { height: 18px; width: auto; }

  html body .pl-gr-{{ section.id }} .pl-gr-carousel {
    display: flex; gap: 12px; margin: 0 calc(var(--sk-gutter) * -1); padding: 0 var(--sk-gutter) 2px;
    overflow-x: auto; scroll-behavior: smooth; scroll-snap-type: x mandatory; scroll-padding: 0 var(--sk-gutter);
    -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  html body .pl-gr-{{ section.id }} .pl-gr-carousel::-webkit-scrollbar { display: none; }
  html body .pl-gr-{{ section.id }} .pl-gr-card {
    flex: none; width: 264px; display: grid; grid-template-columns: 40px minmax(0, 1fr); align-content: start; gap: 0 12px;
    padding: 16px; background: var(--sk-card) !important; border: 1px solid var(--sk-line) !important; border-radius: 3px !important;
    box-shadow: none !important; scroll-snap-align: start; overflow: hidden;
  }
  html body .pl-gr-{{ section.id }} .pl-gr-avatar-area { grid-row: span 3; display: block; height: auto; padding: 0; background: none !important; }
  html body .pl-gr-{{ section.id }} .pl-gr-avatar,
  html body .pl-gr-{{ section.id }} .pl-gr-avatar-init {
    display: grid; place-items: center; width: 40px; height: 40px; margin: 0; border-radius: 50%; border: 1px solid var(--sk-line);
    object-fit: cover; color: #fff; font-size: 15px; font-weight: 600;
  }
  html body .pl-gr-{{ section.id }} .pl-gr-card-body { display: contents; }
  html body .pl-gr-{{ section.id }} .pl-gr-card-stars { grid-column: 2; display: flex; gap: 1px; margin: 0; text-align: left; }
  html body .pl-gr-{{ section.id }} .pl-gr-card-star { color: var(--sk-acc); font-size: 12px; line-height: 1; }
  html body .pl-gr-{{ section.id }} .pl-gr-card-name {
    grid-column: 2; margin: 4px 0 0 !important; text-align: left; color: var(--sk-fg);
    font-family: var(--sk-sans) !important; font-size: 14px !important; font-weight: 600 !important; line-height: 1.3 !important; letter-spacing: -0.01em !important;
  }
  html body .pl-gr-{{ section.id }} .pl-gr-card-date {
    grid-column: 2; margin: 2px 0 0 !important; text-align: left; color: var(--sk-muted);
    font: 400 10.5px/1.4 var(--sk-mono) !important; letter-spacing: 0.1em !important; text-transform: uppercase !important;
  }
  html body .pl-gr-{{ section.id }} .pl-gr-divider { grid-column: 1 / -1; height: 1px; margin: 14px 0 12px; background: var(--sk-line); }
  html body .pl-gr-{{ section.id }} .pl-gr-card-text {
    grid-column: 1 / -1; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden;
    min-height: 0; margin: 0 !important; text-align: left; color: var(--sk-fg2);
    font-family: var(--sk-sans) !important; font-size: 14px !important; line-height: 1.6 !important; letter-spacing: 0 !important;
  }
  html body .pl-gr-{{ section.id }} .pl-gr-posted-on {
    grid-column: 1 / -1; display: flex; align-items: center; justify-content: flex-start; gap: 6px; margin-top: 12px;
    color: var(--sk-muted); font: 400 11px/1 var(--sk-mono); letter-spacing: 0.1em; text-transform: uppercase;
  }
  html body .pl-gr-{{ section.id }} .pl-gr-posted-on svg { height: 12px; width: auto; }

  html body .pl-gr-{{ section.id }} .pl-gr-nav-row { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
  html body .pl-gr-{{ section.id }} .pl-gr-nav-btn {
    display: grid; place-items: center; width: 40px; height: 40px; min-height: 0; padding: 0; margin: 0;
    background: var(--sk-card) !important; border: 1px solid var(--sk-line2) !important; border-radius: 2px !important; box-shadow: none !important;
    color: var(--sk-fg); cursor: pointer; transition: background-color 0.2s, border-color 0.2s;
  }
  html body .pl-gr-{{ section.id }} .pl-gr-nav-btn:hover { background: var(--sk-bg2) !important; border-color: var(--sk-fg) !important; }
  html body .pl-gr-{{ section.id }} .pl-gr-nav-btn svg { width: 16px; height: 16px; }

  @media screen and (min-width: 990px) {
    html body .pl-gr-{{ section.id }} .pl-gr-wrapper { padding: 56px 0 48px !important; }
    html body .pl-gr-{{ section.id }} .pl-gr-card { width: 320px; padding: 18px; }
    html body .pl-gr-{{ section.id }} .pl-gr-header { margin-bottom: 24px; }
  }
</style>

{%- assign avatar_colors = '#4285F4,#EA4335,#FBBC04,#34A853,#1a73e8,#e52592,#fa7b17,#137333' | split: ',' -%}

<div class="pl-gr-{{ section.id }} page-width">
  <div class="pl-gr-wrapper">

    <!-- Header -->
    <div class="pl-gr-header">
      <div class="pl-gr-summary">
        <div class="pl-gr-stars-group" aria-label="{{ section.settings.overall_rating }} out of 5 stars">
          <span class="pl-gr-star">★</span><span class="pl-gr-star">★</span><span class="pl-gr-star">★</span><span class="pl-gr-star">★</span><span class="pl-gr-star">★</span>
        </div>
        <span class="pl-gr-big-num">{{ section.settings.overall_rating }}</span>
        <span class="pl-gr-dot">·</span>
        {%- if section.settings.review_url != blank -%}
          <a href="{{ section.settings.review_url }}" class="pl-gr-rev-count" target="_blank" rel="noopener noreferrer">{{ section.settings.review_count }} reviews</a>
        {%- else -%}
          <span class="pl-gr-rev-count" style="cursor:default;">{{ section.settings.review_count }} reviews</span>
        {%- endif -%}
        <svg class="pl-gr-google-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 272.9 92.3" aria-label="Google" role="img">
          <path fill="#4285F4" d="M35.3 41.5V32h32.6c.3 1.6.5 3.5.5 5.6 0 6.8-1.9 15.2-7.9 21.2-5.9 6.1-13.4 9.3-23.3 9.3C17.2 68.1 0 51.3 0 31.3 0 11.3 17.2-1.5 37.2-1.5c10.2 0 17.5 4 23 9.1L53.7 14c-3.9-3.7-9.2-6.5-16.5-6.5-13.5 0-24 10.9-24 24.3s10.5 24.3 24 24.3c8.7 0 13.7-3.5 16.9-6.7 2.6-2.6 4.3-6.3 4.9-11.5H35.3z"/>
          <path fill="#EA4335" d="M115.8 46.6c0 12.8-10 22.1-22.3 22.1S71.2 59.4 71.2 46.6s10-22.1 22.3-22.1 22.3 9.3 22.3 22.1zm-9.8 0c0-8-5.8-13.5-12.5-13.5S81 38.6 81 46.6s5.8 13.5 12.5 13.5 12.5-5.5 12.5-13.5z"/>
          <path fill="#FBBC05" d="M161.1 46.6c0 12.8-10 22.1-22.3 22.1s-22.3-9.3-22.3-22.1 10-22.1 22.3-22.1 22.3 9.3 22.3 22.1zm-9.8 0c0-8-5.8-13.5-12.5-13.5s-12.5 5.5-12.5 13.5 5.8 13.5 12.5 13.5 12.5-5.5 12.5-13.5z"/>
          <path fill="#4285F4" d="M204.3 25.8v40c0 16.5-9.7 23.2-21.2 23.2-10.8 0-17.3-7.2-19.7-13.1l8.5-3.5c1.5 3.6 5.2 7.9 11.2 7.9 7.3 0 11.8-4.5 11.8-13v-3.2h-.3c-2.2 2.7-6.4 5-11.7 5-11.1 0-21.3-9.7-21.3-22.1 0-12.5 10.2-22.2 21.3-22.2 5.3 0 9.5 2.3 11.7 4.9h.3V26h9.4zm-8.7 20.9c0-7.8-5.2-13.5-11.8-13.5-6.7 0-12.3 5.7-12.3 13.5s5.6 13.3 12.3 13.3c6.6 0 11.8-5.5 11.8-13.3z"/>
          <path fill="#34A853" d="M219.6 3.1v64.8h-9.5V3.1z"/>
          <path fill="#EA4335" d="M257.2 54.9l7.6 5.1c-2.5 3.6-8.4 9.8-18.7 9.8-12.7 0-22.2-9.8-22.2-22.1 0-13.2 9.5-22.1 21.1-22.1 11.6 0 17.3 9.1 19.1 14l1 2.5-29.9 12.4c2.3 4.5 5.8 6.8 10.8 6.8s8.5-2.5 11.2-6.4zm-23.5-8.1l20-8.3c-1.1-2.8-4.4-4.7-8.3-4.7-5 0-12 4.4-11.7 13z"/>
        </svg>
      </div>
      {%- if section.settings.review_url != blank -%}
        <a href="{{ section.settings.review_url }}" class="pl-gr-leave-link" target="_blank" rel="noopener noreferrer">Write a review &rarr;</a>
      {%- endif -%}
    </div>

    <!-- Cards -->
    <div class="pl-gr-carousel" id="pl-gr-c-{{ section.id }}">
      {%- for block in section.blocks limit: 5 -%}
        {%- assign star_count = block.settings.rating | default: 5 -%}
        {%- assign color_index = forloop.index0 | modulo: 8 -%}
        {%- assign init_color = avatar_colors[color_index] -%}
        <div class="pl-gr-card" {{ block.shopify_attributes }}>
          <div class="pl-gr-avatar-area">
            {%- if block.settings.avatar_url != blank -%}
              {%- capture pl_av -%}{% render 'pl-avatar-url', url: block.settings.avatar_url, px: 96 %}{%- endcapture -%}
              <img src="{{ pl_av | strip }}" alt="{{ block.settings.name | escape }}" class="pl-gr-avatar" loading="lazy" decoding="async" width="48" height="48">
            {%- else -%}
              <div class="pl-gr-avatar-init" style="background:{{ init_color }}">{{ block.settings.name | slice: 0 | upcase }}</div>
            {%- endif -%}
          </div>
          <div class="pl-gr-card-body">
            <div class="pl-gr-card-stars" aria-label="{{ star_count }} stars">
              {%- if star_count >= 1 -%}<span class="pl-gr-card-star">★</span>{%- endif -%}
              {%- if star_count >= 2 -%}<span class="pl-gr-card-star">★</span>{%- endif -%}
              {%- if star_count >= 3 -%}<span class="pl-gr-card-star">★</span>{%- endif -%}
              {%- if star_count >= 4 -%}<span class="pl-gr-card-star">★</span>{%- endif -%}
              {%- if star_count >= 5 -%}<span class="pl-gr-card-star">★</span>{%- endif -%}
            </div>
            <p class="pl-gr-card-name">{{ block.settings.name }}</p>
            <p class="pl-gr-card-date">{{ block.settings.date }}</p>
            <div class="pl-gr-divider"></div>
            <p class="pl-gr-card-text">{{ block.settings.text }}</p>
            <div class="pl-gr-posted-on">
              <span>Posted on</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 272.9 92.3" role="img" aria-label="Google">
                <path fill="#4285F4" d="M35.3 41.5V32h32.6c.3 1.6.5 3.5.5 5.6 0 6.8-1.9 15.2-7.9 21.2-5.9 6.1-13.4 9.3-23.3 9.3C17.2 68.1 0 51.3 0 31.3 0 11.3 17.2-1.5 37.2-1.5c10.2 0 17.5 4 23 9.1L53.7 14c-3.9-3.7-9.2-6.5-16.5-6.5-13.5 0-24 10.9-24 24.3s10.5 24.3 24 24.3c8.7 0 13.7-3.5 16.9-6.7 2.6-2.6 4.3-6.3 4.9-11.5H35.3z"/>
                <path fill="#EA4335" d="M115.8 46.6c0 12.8-10 22.1-22.3 22.1S71.2 59.4 71.2 46.6s10-22.1 22.3-22.1 22.3 9.3 22.3 22.1zm-9.8 0c0-8-5.8-13.5-12.5-13.5S81 38.6 81 46.6s5.8 13.5 12.5 13.5 12.5-5.5 12.5-13.5z"/>
                <path fill="#FBBC05" d="M161.1 46.6c0 12.8-10 22.1-22.3 22.1s-22.3-9.3-22.3-22.1 10-22.1 22.3-22.1 22.3 9.3 22.3 22.1zm-9.8 0c0-8-5.8-13.5-12.5-13.5s-12.5 5.5-12.5 13.5 5.8 13.5 12.5 13.5 12.5-5.5 12.5-13.5z"/>
                <path fill="#4285F4" d="M204.3 25.8v40c0 16.5-9.7 23.2-21.2 23.2-10.8 0-17.3-7.2-19.7-13.1l8.5-3.5c1.5 3.6 5.2 7.9 11.2 7.9 7.3 0 11.8-4.5 11.8-13v-3.2h-.3c-2.2 2.7-6.4 5-11.7 5-11.1 0-21.3-9.7-21.3-22.1 0-12.5 10.2-22.2 21.3-22.2 5.3 0 9.5 2.3 11.7 4.9h.3V26h9.4zm-8.7 20.9c0-7.8-5.2-13.5-11.8-13.5-6.7 0-12.3 5.7-12.3 13.5s5.6 13.3 12.3 13.3c6.6 0 11.8-5.5 11.8-13.3z"/>
                <path fill="#34A853" d="M219.6 3.1v64.8h-9.5V3.1z"/>
                <path fill="#EA4335" d="M257.2 54.9l7.6 5.1c-2.5 3.6-8.4 9.8-18.7 9.8-12.7 0-22.2-9.8-22.2-22.1 0-13.2 9.5-22.1 21.1-22.1 11.6 0 17.3 9.1 19.1 14l1 2.5-29.9 12.4c2.3 4.5 5.8 6.8 10.8 6.8s8.5-2.5 11.2-6.4zm-23.5-8.1l20-8.3c-1.1-2.8-4.4-4.7-8.3-4.7-5 0-12 4.4-11.7 13z"/>
              </svg>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <!-- Nav -->
    <div class="pl-gr-nav-row">
      <button class="pl-gr-nav-btn" id="pl-gr-prev-{{ section.id }}" aria-label="Previous reviews">
        <svg width="16" height="16" viewBox="0 0 24 24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="pl-gr-nav-btn" id="pl-gr-next-{{ section.id }}" aria-label="Next reviews">
        <svg width="16" height="16" viewBox="0 0 24 24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>

  </div>
</div>

<script>
(function () {
  var c = document.getElementById('pl-gr-c-{{ section.id }}');
  if (!c) return;
  var step = (c.querySelector('.pl-gr-card') || {offsetWidth: 240}).offsetWidth + 12;
  document.getElementById('pl-gr-prev-{{ section.id }}').addEventListener('click', function () {
    c.scrollBy({ left: -step, behavior: 'smooth' });
  });
  document.getElementById('pl-gr-next-{{ section.id }}').addEventListener('click', function () {
    if (c.scrollLeft + c.clientWidth >= c.scrollWidth - 8) {
      c.scrollTo({ left: 0, behavior: 'smooth' });
    } else {
      c.scrollBy({ left: step, behavior: 'smooth' });
    }
  });
})();
</script>

{% schema %}
{
  "name": "Google Reviews (Custom)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "business_name",
      "label": "Business name",
      "default": "Pure Leven Exim"
    },
    {
      "type": "text",
      "id": "overall_rating",
      "label": "Overall rating",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count label",
      "default": "503"
