{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding pl-dish-moment">
  <div class="page-width pl-dish-moment__wrap">
    <div class="pl-dish-moment__media">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1600 }}"
          alt="{{ section.settings.image.alt | default: section.settings.caption }}"
          loading="lazy"
          decoding="async"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {% else %}
        <div class="pl-dish-moment__placeholder">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </div>
    {% if section.settings.caption != blank %}
      <p class="pl-dish-moment__caption">{{ section.settings.caption }}</p>
    {% endif %}
  </div>
</div>

<style>
  .pl-dish-moment {
    background: var(--pl-cream, #f8f5ee);
  }

  .pl-dish-moment__wrap {
    text-align: center;
  }

  .pl-dish-moment__media {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: 0 10px 26px rgba(27, 58, 48, 0.12);
    max-width: 900px;
    margin: 0 auto;
  }

  .pl-dish-moment__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pl-dish-moment__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #ede4d3;
    height: 100%;
    width: 100%;
  }

  .pl-dish-moment__placeholder .placeholder-svg {
    width: 100%;
    height: 100%;
    max-width: 220px;
    opacity: 0.5;
  }

  .pl-dish-moment__caption {
    margin: 12px 0 0;
    font-family: var(--font-fraunces, 'Fraunces', serif) !important;
    font-style: italic;
    font-size: 15px;
    color: var(--pl-near-black, #1a1a1a);
  }

  @media screen and (min-width: 750px) {
    .pl-dish-moment__media {
      aspect-ratio: 21 / 8;
    }

    .pl-dish-moment__caption {
      font-size: 18px;
      margin-top: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Dish Moment",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Dish photo"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "This is what fresh spice tastes like."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Dish Moment"
    }
  ]
}
{% endschema %}
