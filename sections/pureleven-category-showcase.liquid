{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{{ 'tc-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'tc-product-card.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'tc-ajax-cart.js' | asset_url }}" defer="defer"></script>

{%- assign cat_blocks = section.blocks | where: 'type', 'category' -%}
{%- liquid
  if cat_blocks.size > 0
    assign group_total = cat_blocks.size
  else
    assign group_total = 2
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} { background-color: var(--sk-bg, #F9F9F6) !important; color: var(--sk-fg, #0B0B0F); }
  #shopify-section-{{ section.id }} .gradient,
  #shopify-section-{{ section.id }} .collection { background: transparent !important; }

  #shopify-section-{{ section.id }} .collection__title { margin: 0 0 24px !important; text-align: left; }
  {%- if section.settings.eyebrow != blank -%}
  #shopify-section-{{ section.id }} .collection__title::before {
    content: '{{ section.settings.eyebrow | escape }}';
    display: block;
    margin-bottom: 14px;
    font: 400 11px/1.5 var(--sk-mono) !important;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sk-muted);
  }
  {%- endif -%}
  #shopify-section-{{ section.id }} .collection__title .title {
    margin: 0 !important;
    font-family: var(--sk-sans) !important;
    font-size: clamp(34px, 4.2vw, 60px) !important;
    font-weight: 500 !important;
    line-height: 1.08 !important;
    letter-spacing: -0.055em !important;
    text-transform: none !important;
    color: var(--sk-fg) !important;
  }
  #shopify-section-{{ section.id }} .collection__description,
  #shopify-section-{{ section.id }} .collection__description p {
    max-width: 58ch;
    margin: 12px 0 0 !important;
    font-family: var(--sk-sans) !important;
    font-size: 15px !important;
    line-height: 1.6 !important;
    letter-spacing: 0 !important;
    color: var(--sk-muted) !important;
    opacity: 1;
  }

  /* category rail: large image cards, swipeable when there are more than fit */
  .pl-cat__rail {
    display: grid; grid-auto-flow: column; grid-auto-columns: 46%; gap: 10px;
    margin: 0 0 32px; padding: 0 0 4px;
    overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -webkit-overflow-scrolling: touch; list-style: none;
  }
  .pl-cat__rail::-webkit-scrollbar { display: none; }
  .pl-cat__card {
    display: flex; flex-direction: column; min-width: 0; margin: 0; padding: 0; overflow: hidden; scroll-snap-align: start;
    background: var(--sk-card) !important; border: 1px solid var(--sk-line) !important; border-radius: 3px !important;
    box-shadow: none !important; color: var(--sk-fg) !important; cursor: pointer; text-align: left;
    font-family: var(--sk-sans) !important; letter-spacing: 0 !important; text-transform: none !important;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .pl-cat__card:hover { border-color: #BFC3CC !important; }
  .pl-cat__card:focus-visible { outline: 2px solid var(--sk-acc); outline-offset: 2px; }
  .pl-cat__card-img { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--sk-bg2); border-bottom: 1px solid var(--sk-line); }
  .pl-cat__card-img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--sk-ease); }
  .pl-cat__card:hover .pl-cat__card-img img { transform: scale(1.03); }
  .pl-cat__card-body { display: grid; gap: 2px; padding: 10px 12px 12px; transition: background-color 0.2s; }
  .pl-cat__card-num { color: var(--sk-acc); font: 700 10.5px/1.4 var(--sk-mono) !important; letter-spacing: 0.08em !important; }
  .pl-cat__card-name { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--sk-fg); font-size: 15px !important; font-weight: 600 !important; line-height: 1.3 !important; letter-spacing: -0.01em !important; }
  .pl-cat__card-meta { color: var(--sk-muted); font: 400 10.5px/1.5 var(--sk-mono) !important; letter-spacing: 0.08em !important; text-transform: uppercase !important; }
  .pl-cat__card[aria-pressed='true'] { border-color: var(--sk-acc) !important; box-shadow: inset 0 0 0 1px var(--sk-acc) !important; }
  .pl-cat__card[aria-pressed='true'] .pl-cat__card-body { background: var(--sk-acc-soft); }
  .pl-cat__card[aria-pressed='true'] .pl-cat__card-name { color: var(--sk-acc); }
  @media screen and (min-width: 750px) {
    .pl-cat__rail { grid-auto-columns: calc((100% - 30px) / 4); gap: 10px; margin-bottom: 40px; scrollbar-width: thin; }
    .pl-cat__card-body { padding: 14px 16px 16px; }
    .pl-cat__card-name { font-size: 17px !important; }
  }

  .pl-cat__groups { display: flex; flex-direction: column; counter-reset: plcat; }
  .pl-cat__group { counter-increment: plcat; }
  .pl-cat__group:not(:first-child) {
    margin-top: 48px; padding: 44px 0 52px;
    background: var(--sk-bg2); border-top: 1px solid var(--sk-line);
  }
  .pl-cat__group:nth-child(odd):not(:first-child) { background: var(--sk-bg); }
  .pl-cat__group:first-child .pl-cat__intro { display: none; }
  .pl-cat__group:not(:first-child) .pl-cat__group-head { display: none; }
  {%- if group_total > 1 -%}
  #shopify-section-{{ section.id }} .section-{{ section.id }}-padding { padding-bottom: 0 !important; }
  {%- endif -%}

  #shopify-section-{{ section.id }} .pl-cat__intro { margin-bottom: 24px; }
  #shopify-section-{{ section.id }} .pl-cat__intro-grid { display: grid; gap: 24px; padding: 0 8px; }
  #shopify-section-{{ section.id }} .pl-cat__intro-eyebrow {
    margin: 0 0 12px !important; color: var(--sk-muted) !important;
    font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important;
  }
  #shopify-section-{{ section.id }} .pl-cat__intro-num { font-style: normal; color: var(--sk-acc); }
  #shopify-section-{{ section.id }} .pl-cat__intro-num::before { content: counter(plcat, decimal-leading-zero); }
  #shopify-section-{{ section.id }} .pl-cat__intro-title {
    margin: 0 !important; color: var(--sk-fg) !important;
    font-family: var(--sk-sans) !important; font-size: clamp(34px, 4.2vw, 60px) !important; font-weight: 500 !important;
    line-height: 1.06 !important; letter-spacing: -0.055em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .pl-cat__intro-copy {
    max-width: 560px; margin: 14px 0 0 !important; color: var(--sk-fg2) !important;
    font-family: var(--sk-sans) !important; font-size: 15px !important; line-height: 1.65 !important; letter-spacing: -0.005em !important;
  }
  #shopify-section-{{ section.id }} .pl-cat__intro-link {
    display: inline-block; margin-top: 18px; padding-bottom: 2px; border-bottom: 1px solid currentColor;
    color: var(--sk-acc) !important; text-decoration: none !important;
    font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important;
  }
  #shopify-section-{{ section.id }} .pl-cat__intro-link:hover { color: var(--sk-acc-hover) !important; }
  #shopify-section-{{ section.id }} .pl-cat__intro-link span { display: inline-block; transition: transform 0.2s var(--sk-ease); }
  #shopify-section-{{ section.id }} .pl-cat__intro-link:hover span { transform: translateX(3px); }
  #shopify-section-{{ section.id }} .pl-cat__intro-media { display: none; }
  @media screen and (min-width: 750px) {
    .pl-cat__group:not(:first-child) { margin-top: 72px; padding: 80px 0 88px; }
    #shopify-section-{{ section.id }} .pl-cat__intro { margin-bottom: 40px; }
    #shopify-section-{{ section.id }} .pl-cat__intro-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: end; gap: 56px; padding: 0; }
    #shopify-section-{{ section.id }} .pl-cat__intro-media {
      display: block; aspect-ratio: 16 / 10; overflow: hidden;
      border: 1px solid var(--sk-line); border-radius: 3px; background: var(--sk-bg2);
    }
    #shopify-section-{{ section.id }} .pl-cat__intro-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  }

  .pl-cat__group-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 16px; margin-bottom: 16px; padding-top: 16px; border-top: 1px solid var(--sk-line);
  }
  .pl-cat__group-label {
    margin: 0 !important;
    font-family: var(--sk-sans) !important; font-size: 22px !important; font-weight: 500 !important;
    line-height: 1.15 !important; letter-spacing: -0.035em !important; text-transform: none !important;
    color: var(--sk-fg) !important;
  }
  .pl-cat__group-link {
    flex: none; padding-bottom: 2px; border-bottom: 1px solid currentColor;
    color: var(--sk-acc) !important; text-decoration: none !important; white-space: nowrap;
    font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important;
  }
  .pl-cat__group-link:hover { color: var(--sk-acc-hover) !important; }
  @media screen and (min-width: 750px) { .pl-cat__group-label { font-size: 28px !important; } }

  .plc-grid {
    display: grid; gap: 12px; list-style: none; margin: 0; padding: 0;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
  }
  .plc-grid > * { min-width: 0; }
  @media screen and (min-width: 750px) {
    .plc-grid { gap: 20px; grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr)); }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="collection section-{{ section.id }}-padding" id="collection-{{ section.id }}">
    <div class="page-width">
      {%- if section.settings.title != blank or section.settings.description != blank -%}
        <div class="collection__title title-wrapper title-wrapper--no-top-margin">
          {%- if section.settings.title != blank -%}
            <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <div class="collection__description body rte">{{ section.settings.description }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

{%- capture pl_cat_label -%}{{ section.settings.title | strip_html | default: 'Product categories' }}{%- endcapture -%}
      <div class="pl-cat__rail" role="group" aria-label="{{ pl_cat_label | escape }}">
        {%- if cat_blocks.size > 0 -%}
          {%- for block in cat_blocks -%}
            {%- assign cat = block.settings.collection -%}
            {%- assign cat_img = block.settings.image | default: cat.image | default: cat.products.first.featured_image -%}
            <button type="button" class="pl-cat__card" id="pl-cat-tab-{{ section.id }}-{{ forloop.index }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="pl-cat-group-{{ section.id }}-{{ forloop.index }}" data-pl-cat-chip="{{ forloop.index }}" {{ block.shopify_attributes }}>
              <span class="pl-cat__card-img">
                {%- if cat_img != blank -%}
                  {{ cat_img | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240,360,480,640', sizes: '(min-width: 750px) 25vw, 46vw', alt: '' }}
                {%- endif -%}
              </span>
              <span class="pl-cat__card-body">
                <span class="pl-cat__card-num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                <span class="pl-cat__card-name">{{ block.settings.label | default: cat.title }}</span>
                {%- if cat != blank -%}<span class="pl-cat__card-meta">{{ cat.products_count }} products</span>{%- endif -%}
              </span>
            </button>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..2) -%}
            {%- if forloop.first -%}{%- assign cat = section.settings.collection_a -%}{%- assign cat_label = section.settings.label_a | default: cat.title -%}
            {%- else -%}{%- assign cat = section.settings.collection_b -%}{%- assign cat_label = section.settings.label_b | default: cat.title -%}{%- endif -%}
            {%- assign cat_img = cat.image | default: cat.products.first.featured_image -%}
            <button type="button" class="pl-cat__card" id="pl-cat-tab-{{ section.id }}-{{ i }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="pl-cat-group-{{ section.id }}-{{ i }}" data-pl-cat-chip="{{ i }}">
              <span class="pl-cat__card-img">
                {%- if cat_img != blank -%}
                  {{ cat_img | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240,360,480,640', sizes: '(min-width: 750px) 25vw, 46vw', alt: '' }}
                {%- endif -%}
              </span>
              <span class="pl-cat__card-body">
                <span class="pl-cat__card-num">0{{ i }}</span>
                <span class="pl-cat__card-name">{{ cat_label }}</span>
                {%- if cat != blank -%}<span class="pl-cat__card-meta">{{ cat.products_count }} products</span>{%- endif -%}
              </span>
            </button>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="pl-cat__groups" data-pl-cat-groups>
      {%- liquid
        if cat_blocks.size > 0
          assign group_count = cat_blocks.size
        else
          assign group_count = 2
        endif
      -%}
      {%- for n in (1..group_count) -%}
        {%- liquid
          if cat_blocks.size > 0
            assign b = cat_blocks[forloop.index0]
            assign current = b.settings.collection
            assign current_label = b.settings.label | default: current.title
          elsif forloop.first
            assign current = section.settings.collection_a
            assign current_label = section.settings.label_a | default: current.title
          else
            assign current = section.settings.collection_b
            assign current_label = section.settings.label_b | default: current.title
          endif
        -%}
        {%- liquid
          if cat_blocks.size > 0
            assign current_img = b.settings.image | default: current.image | default: current.products.first.featured_image
            assign current_intro = b.settings.intro
          else
            assign current_img = current.image | default: current.products.first.featured_image
            assign current_intro = ''
          endif
          if current_intro == blank and current != blank
            capture current_intro
              render 'sk-category-copy', handle: current.handle, part: 'text', collection: current
            endcapture
          endif
        -%}
        <div class="pl-cat__group" id="pl-cat-group-{{ section.id }}-{{ n }}" aria-labelledby="pl-cat-title-{{ section.id }}-{{ n }}" data-group="{{ n }}">
          <div class="pl-cat__intro">
            <div class="page-width">
              <div class="pl-cat__intro-grid">
                <div class="pl-cat__intro-text">
                  <p class="pl-cat__intro-eyebrow"><i class="pl-cat__intro-num"></i> / {{ section.settings.also_label | escape }}</p>
                  <h3 class="pl-cat__intro-title" id="pl-cat-title-{{ section.id }}-{{ n }}">{{ current_label }}</h3>
                  {%- if current_intro != blank -%}<p class="pl-cat__intro-copy">{{ current_intro | strip | escape }}</p>{%- endif -%}
                  {%- if current != blank -%}
                    <a href="{{ current.url }}" class="pl-cat__intro-link">Shop all {{ current_label }} <span aria-hidden="true">&rarr;</span></a>
                  {%- endif -%}
                </div>
                {%- if current_img != blank -%}
                  <div class="pl-cat__intro-media">
                    {{ current_img | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '550,800,1100', sizes: '(min-width: 750px) 45vw, 100vw', alt: '' }}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
          <div class="page-width">
            <div class="pl-cat__group-head">
              <h3 class="pl-cat__group-label">{{ current_label }}</h3>
              {%- if current != blank -%}
                <a href="{{ current.url }}" class="pl-cat__group-link link">{{ 'sections.featured_collection.view_all' | t }}</a>
              {%- endif -%}
            </div>
          </div>
          <div class="page-width">
            {%- if current != blank and current.products.size > 0 -%}
              <div class="plc-grid" role="list">
                {%- assign _shown = 0 -%}
                {%- for product in current.products -%}
                  {%- if _shown >= section.settings.products_to_show -%}{%- break -%}{%- endif -%}
                  {%- assign _skip = false -%}
                  {%- if cat_blocks.size > 1 -%}
                    {%- assign _phs = product.collections | map: 'handle' -%}
                    {%- for ob in cat_blocks -%}
                      {%- assign oc = ob.settings.collection -%}
                      {%- if oc != blank and oc.handle != current.handle and oc.products_count < current.products_count and _phs contains oc.handle -%}
                        {%- assign _skip = true -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                  {%- if _skip -%}{%- continue -%}{%- endif -%}
                  {%- assign _shown = _shown | plus: 1 -%}
                  <div role="listitem">
                    {%- render 'pureleven-tc-product-card', product: product -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- else -%}
              <p class="collection__description body rte">No products in this category yet.</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var chips = root.querySelectorAll('[data-pl-cat-chip]');
    var wrap = root.querySelector('[data-pl-cat-groups]');
    if (!wrap) return;
    var groups = Array.prototype.slice.call(wrap.querySelectorAll(':scope > .pl-cat__group'));
    // The chosen category moves to the top; the others follow in their usual order, each with its intro.
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var key = chip.dataset.plCatChip;
        chips.forEach(function (c) { c.setAttribute('aria-pressed', String(c === chip)); });
        var picked = groups.filter(function (g) { return g.dataset.group === key; });
        picked.concat(groups.filter(function (g) { return g.dataset.group !== key; })).forEach(function (g) { wrap.appendChild(g); });
        chip.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Category Showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "FRESH ESSENTIALS"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Our top spices"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Extra large"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "also_label",
      "label": "Label above the other categories",
      "default": "Also from Pure Leven Spices & Tea"
    },
    {
      "type": "header",
      "content": "Fallback (used when no category blocks)"
    },
    {
      "type": "collection",
      "id": "collection_a",
      "label": "Collection A"
    },
    {
      "type": "text",
      "id": "label_a",
      "label": "Label A",
      "default": "Kerala Spices"
    },
    {
      "type": "header",
      "content": "Category B"
    },
    {
      "type": "collection",
      "id": "collection_b",
      "label": "Collection B"
    },
    {
      "type": "text",
      "id": "label_b",
      "label": "Label B",
      "default": "Tea & Coffee"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "label": "Max products per category",
      "default": 12
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Category Showcase"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (defaults to collection title)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image (defaults to collection image)"
        },
        {
          "type": "textarea",
          "id": "intro",
          "label": "Two-line intro (shown when this category is not the chosen one)"
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
