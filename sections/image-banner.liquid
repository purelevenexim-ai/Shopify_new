{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign is_pureleven_home_hero = false
  if request.page_type == 'index' and section.id contains 'image_banner_DiNdUj'
    assign is_pureleven_home_hero = true
  endif
-%}

{%- if section.settings.image_height == 'adapt' and section.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before,
      #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- style -%}
  {%- if is_pureleven_home_hero -%}
    #Banner-{{ section.id }}::after {
      opacity: 0.25;
    }
  {%- else -%}
    #Banner-{{ section.id }}::after {
      opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
    }
  {%- endif -%}
{%- endstyle -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  if section.settings.image_behavior == 'ambient'
    assign half_width = '60vw'
    assign full_width = '120vw'
    assign stacked_sizes = '(min-width: 750px) 60vw, 120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
  elsif section.settings.image_behavior == 'fixed' or section.settings.image_behavior == 'zoom-in'
    assign half_width = '100vw'
    assign stacked_sizes = '100vw'
  else
    assign half_width = '50vw'
    assign stacked_sizes = '(min-width: 750px) 50vw, 100vw'
  endif
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- if is_pureleven_home_hero -%}
  <style>
    .banner--pureleven-home-hero .banner__media {
      background: linear-gradient(135deg, #f8f5ee 0%, #e8f1ed 100%);
    }

    .banner--pureleven-home-hero .banner__video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .banner--pureleven-home-hero .banner__video-loader {
      --progress: 0%;
      position: absolute;
      inset: 0;
      z-index: 2;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, #f8f5ee 0%, #e8f1ed 100%);
      color: var(--pl-primary-dark, #154039);
      transition: opacity 0.35s ease, visibility 0.35s ease;
      pointer-events: none;
    }

    .banner--pureleven-home-hero .banner__video-loader-card {
      position: relative;
      width: min(28rem, calc(100vw - 5rem));
      padding: 2rem 2.2rem 1.8rem;
      border: 1px solid rgba(27, 94, 86, 0.12);
      border-radius: 2.2rem;
      background: rgba(255, 252, 244, 0.82);
      box-shadow: 0 1.8rem 4rem rgba(21, 64, 57, 0.12);
      text-align: center;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .banner--pureleven-home-hero .banner__video-loader-eyebrow {
      display: block;
      margin-bottom: 1.2rem;
      font-family: 'Fustat', 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(21, 64, 57, 0.72);
    }

    .banner--pureleven-home-hero .banner__video-loader-spices {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.9rem;
      margin-bottom: 1.4rem;
    }

    .banner--pureleven-home-hero .banner__video-loader-spice {
      width: 1.4rem;
      aspect-ratio: 1;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #fce477 0 18%, #9b6b35 19% 50%, #3f2618 51% 100%);
      box-shadow: 0 0.45rem 0.9rem rgba(63, 38, 24, 0.18);
      animation: pl-spice-breathe 1.25s ease-in-out infinite;
    }

    .banner--pureleven-home-hero .banner__video-loader-spice:nth-child(2) {
      width: 1.8rem;
      background: radial-gradient(circle at 34% 28%, #d9f0a3 0 16%, #2e7d6e 17% 52%, #154039 53% 100%);
      animation-delay: 0.16s;
    }

    .banner--pureleven-home-hero .banner__video-loader-spice:nth-child(3) {
      background: radial-gradient(circle at 35% 30%, #f8c7a1 0 17%, #9a3f2e 18% 52%, #3a1c17 53% 100%);
      animation-delay: 0.32s;
    }

    .banner--pureleven-home-hero .banner__video-loader-track {
      position: relative;
      height: 0.6rem;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(21, 64, 57, 0.12);
    }

    .banner--pureleven-home-hero .banner__video-loader-fill {
      display: block;
      width: var(--progress);
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #1b5e56, #f0bb45);
      transition: width 0.22s ease;
    }

    .banner--pureleven-home-hero .banner__video-loader-percent {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .banner--pureleven-home-hero .banner__video-loader-label {
      margin-top: 1.2rem;
      font-family: 'Fustat', 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      color: #1e2f2b;
    }

    @keyframes pl-spice-breathe {
      0%, 100% {
        transform: translateY(0) scale(0.9);
        opacity: 0.62;
      }

      45% {
        transform: translateY(-0.45rem) scale(1);
        opacity: 1;
      }
    }

    .banner--pureleven-home-hero.is-video-ready .banner__video-loader {
      opacity: 0;
      visibility: hidden;
    }

    /* Desktop hero refinements */
    @media screen and (min-width: 750px) {
      .banner--pureleven-home-hero {
        --overlay-opacity: 0.25;
      }

      .banner--pureleven-home-hero .banner__box {
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        background: rgba(248, 245, 238, 0.92) !important;
        border: 1px solid rgba(27, 94, 86, 0.1) !important;
        border-radius: 2rem !important;
        box-shadow: 0 2rem 5rem rgba(27, 94, 86, 0.08) !important;
        padding: 3.2rem 4rem !important;
      }

      .banner--pureleven-home-hero .banner__heading.h1 {
        font-family: 'p22-mackinac-pro', serif !important;
        font-size: clamp(4.8rem, 12vw, 6.4rem) !important;
        font-weight: 800 !important;
        line-height: 1.08 !important;
        letter-spacing: -0.04em !important;
        text-wrap: balance;
        margin-bottom: 1.6rem !important;
      }

      .banner--pureleven-home-hero .banner__text p {
        font-family: 'Fustat', 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
        font-size: 1.35rem !important;
        font-weight: 400 !important;
        line-height: 1.8 !important;
        color: var(--pl-primary, #2E7D6E) !important;
        opacity: 0.75 !important;
        max-width: 55ch;
        margin-bottom: 2.4rem !important;
      }

      .banner--pureleven-home-hero .banner__buttons {
        display: flex !important;
        gap: 1.4rem;
        flex-wrap: wrap;
      }

      .banner--pureleven-home-hero .banner__buttons .button,
      .banner--pureleven-home-hero .banner__buttons button,
      .banner--pureleven-home-hero .banner__buttons a.button,
      .banner--pureleven-home-hero .banner__buttons a {
        font-family: 'Fustat', 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
        font-size: 1.15rem !important;
        font-weight: 600 !important;
        letter-spacing: 0.02em !important;
        min-height: 5rem;
        padding: 1.2rem 2.4rem !important;
        border-radius: 4rem !important;
        text-transform: uppercase;
      }

      .banner--pureleven-home-hero .banner__buttons > *:first-child {
        background: #FCE477 !important;
        color: #1A1A1A !important;
        border: none !important;
      }

      .banner--pureleven-home-hero .banner__buttons > *:last-child {
        background: transparent !important;
        color: var(--pl-primary, #2E7D6E) !important;
        border: 2px solid var(--pl-primary, #2E7D6E) !important;
      }
    }

    /* Mobile hero */
    @media screen and (max-width: 749px) {
      .banner--pureleven-home-hero:not(.banner--mobile-bottom) .banner__content {
        min-height: clamp(42rem, 112vw, 55rem);
        align-items: flex-end;
        padding: 1.6rem;
      }

      .banner--pureleven-home-hero:not(.banner--mobile-bottom) .banner__box {
        width: 100%;
        max-width: none;
        padding: 2.2rem 1.8rem 2rem !important;
        border: 1px solid rgba(74, 52, 39, 0.14) !important;
        border-radius: 1.8rem !important;
        background: rgba(248, 244, 238, 0.95) !important;
        box-shadow: 0 1.4rem 3.4rem rgba(55, 43, 32, 0.12) !important;
        color: #1e2f2b !important;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }

      .banner--pureleven-home-hero.banner--mobile-bottom .banner__content {
        display: block;
        min-height: auto;
        margin-top: -3.2rem;
        padding: 0 1.6rem 2.2rem;
      }

      .banner--pureleven-home-hero.banner--mobile-bottom .banner__box {
        width: 100%;
        max-width: none;
        margin: 0 auto;
        padding: 2.3rem 1.9rem 2.1rem !important;
        border: 1px solid rgba(74, 52, 39, 0.13) !important;
        border-radius: 2rem !important;
        background: linear-gradient(180deg, rgba(252, 249, 243, 0.98), rgba(248, 244, 238, 0.96)) !important;
        box-shadow: 0 1.6rem 3.8rem rgba(55, 43, 32, 0.12) !important;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
      }

      .banner--pureleven-home-hero.banner--mobile-bottom .banner__heading.h1 {
        max-width: 11.5ch;
        margin-left: auto;
        margin-right: auto;
        font-size: clamp(3rem, 9vw, 4.1rem) !important;
        line-height: 1.02 !important;
        letter-spacing: -0.034em !important;
        text-wrap: balance;
      }

      .banner--pureleven-home-hero.banner--mobile-bottom .banner__text p {
        max-width: 30ch;
        font-size: 1.6rem !important;
        line-height: 1.58 !important;
      }

      .banner--pureleven-home-hero .banner__buttons {
        display: grid !important;
        width: 100%;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.8rem;
      }

      .banner--pureleven-home-hero .banner__buttons > *:nth-child(2) {
        background: rgba(27, 94, 86, 0.08) !important;
        color: var(--pl-primary-dark, #154039) !important;
        border: 1px solid rgba(21, 64, 57, 0.16) !important;
        box-shadow: none !important;
      }

      .banner--pureleven-home-hero .banner__buttons .button,
      .banner--pureleven-home-hero .banner__buttons button,
      .banner--pureleven-home-hero .banner__buttons a.button,
      .banner--pureleven-home-hero .banner__buttons a {
        width: 100% !important;
        min-width: 0;
        min-height: 4.4rem;
        border-radius: 1.4rem !important;
        padding: 0.95rem 1rem !important;
      }

      .banner--pureleven-home-hero.banner--mobile-bottom .banner__buttons .button,
      .banner--pureleven-home-hero.banner--mobile-bottom .banner__buttons button,
      .banner--pureleven-home-hero.banner--mobile-bottom .banner__buttons a.button,
      .banner--pureleven-home-hero.banner--mobile-bottom .banner__buttons a {
        min-height: 4.4rem;
        font-size: 1.35rem !important;
        font-weight: 600 !important;
        letter-spacing: 0 !important;
      }

      @media screen and (max-width: 359px) {
        .banner--pureleven-home-hero .banner__buttons {
          grid-template-columns: minmax(0, 1fr);
        }
      }
    }
  </style>
{%- endif -%}

{%- if is_pureleven_home_hero -%}
  <span hidden data-homepage-render-version="20260621-compressed-video-progress"></span>
{%- endif -%}

<div
  id="Banner-{{ section.id }}"
  class="banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner--{{ section.settings.image_height }}{% if section.settings.stack_images_on_mobile and section.settings.image != blank and section.settings.image_2 != blank %} banner--stacked{% endif %}{% if section.settings.image_height == 'adapt' and section.settings.image != blank %} banner--adapt{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{%- endif -%}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if is_pureleven_home_hero %} banner--pureleven-home-hero{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  {%- if is_pureleven_home_hero -%}
    <div class="banner__media media{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <video
        class="banner__video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-label="Pure Leven Spices & Tea farm origin video"
      >
        <source src="{{ 'pl-home-hero-mobile.mp4' | asset_url }}" type="video/mp4" media="(max-width: 749px)">
        <source src="{{ 'pl-home-hero-desktop.mp4' | asset_url }}" type="video/mp4">
      </video>
      <div class="banner__video-loader" aria-live="polite">
        <div class="banner__video-loader-card">
          <span class="banner__video-loader-eyebrow">Pure Leven Spices & Tea harvest</span>
          <div class="banner__video-loader-spices" aria-hidden="true">
            <span class="banner__video-loader-spice"></span>
            <span class="banner__video-loader-spice"></span>
            <span class="banner__video-loader-spice"></span>
          </div>
          <div class="banner__video-loader-track" aria-hidden="true">
            <span class="banner__video-loader-fill"></span>
          </div>
          <span class="banner__video-loader-percent">0%</span>
          <div class="banner__video-loader-label">Preparing fresh Kerala spices</div>
        </div>
      </div>
    </div>
  {%- elsif section.settings.image != blank -%}
    <div class="banner__media media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
        if section.settings.image_2 != blank
          assign image_class = 'banner__media-image-half'
        endif
        if section.settings.image_2 != blank and section.settings.stack_images_on_mobile
          assign sizes = stacked_sizes
        elsif section.settings.image_2 != blank
          assign sizes = half_width
        else
          assign sizes = full_width
        endif
      -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: image_height,
          class: image_class,
          sizes: sizes,
          widths: widths,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- elsif section.settings.image_2 == blank -%}
    <div class="banner__media media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}
  {%- if section.settings.image_2 != blank -%}
    <div class="banner__media media{% if section.settings.image != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign image_height_2 = section.settings.image_2.width | divided_by: section.settings.image_2.aspect_ratio
        if section.settings.image != blank
          assign image_class_2 = 'banner__media-image-half'
        endif
        if section.settings.image != blank and section.settings.stack_images_on_mobile
          assign sizes = stacked_sizes
        elsif section.settings.image_2 != blank
          assign sizes = half_width
        else
          assign sizes = full_width
        endif
      -%}
      {{
        section.settings.image_2
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_2.width,
          height: image_height_2,
          class: image_class_2,
          sizes: sizes,
          widths: widths,
          fetchpriority: fetch_priority,
          loading: 'lazy'
      }}
    </div>
  {%- endif -%}
  <div class="banner__content banner__content--{{ section.settings.desktop_content_position }} page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="banner__box content-container content-container--full-width-mobile color-{{ section.settings.color_scheme }} gradient">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if block.settings.heading_size == 'h1' -%}
              <h1
                class="banner__heading inline-richtext h1"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.heading }}
              </h1>
            {%- else -%}
              <h2
                class="banner__heading inline-richtext {{ block.settings.heading_size }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}
          {%- when 'text' -%}
            <div class="banner__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- when 'buttons' -%}
            <div
              class="banner__buttons{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} banner__buttons--multiple{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  {% if block.settings.button_link_1 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_1 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{- block.settings.button_label_1 | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  {% if block.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_2 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{- block.settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if is_pureleven_home_hero -%}
  <style>
    #Banner-{{ section.id }} .banner__heading,
    #Banner-{{ section.id }} .banner__heading.h1,
    #Banner-{{ section.id }} .banner__text,
    #Banner-{{ section.id }} .banner__text p {
      font-family: var(--pl-font-body, "Manrope", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif) !important;
    }

    #Banner-{{ section.id }} .banner__heading,
    #Banner-{{ section.id }} .banner__heading.h1 {
      font-weight: 800 !important;
      letter-spacing: -0.03em !important;
      line-height: 1.05 !important;
    }

    #Banner-{{ section.id }} .banner__buttons .button,
    #Banner-{{ section.id }} .banner__buttons button,
    #Banner-{{ section.id }} .banner__buttons a {
      font-family: var(--pl-font-body, "Manrope", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif) !important;
      letter-spacing: normal !important;
      text-transform: none !important;
    }

    #Banner-{{ section.id }} .banner__buttons .button--primary,
    #Banner-{{ section.id }} .banner__buttons > *:first-child {
      background: var(--pl-yellow, #FCE477) !important;
      border-color: var(--pl-yellow, #FCE477) !important;
      color: var(--pl-charcoal, #212121) !important;
    }

    #Banner-{{ section.id }} .banner__buttons .button--primary:hover,
    #Banner-{{ section.id }} .banner__buttons > *:first-child:hover {
      background: var(--pl-yellow-hover, #F4D138) !important;
      border-color: var(--pl-yellow-hover, #F4D138) !important;
      color: var(--pl-charcoal, #212121) !important;
    }

    #Banner-{{ section.id }} .banner__buttons .button--secondary,
    #Banner-{{ section.id }} .banner__buttons > *:last-child {
      background: transparent !important;
      border-color: var(--pl-teal, #004438) !important;
      color: var(--pl-teal, #004438) !important;
    }
  </style>
  <script>
    (function() {
      var banner = document.getElementById('Banner-{{ section.id }}');
      if (!banner) return;

      var video = banner.querySelector('.banner__video');
      var loader = banner.querySelector('.banner__video-loader');
      var percent = banner.querySelector('.banner__video-loader-percent');
      if (!video || !loader || !percent) return;

      function setProgress(value) {
        var safeValue = Math.max(0, Math.min(100, Math.round(value || 0)));
        loader.style.setProperty('--progress', safeValue + '%');
        percent.textContent = safeValue + '%';
      }

      function updateBufferedProgress() {
        if (!video.duration || !video.buffered || !video.buffered.length) {
          setProgress(video.readyState >= 2 ? 45 : 12);
          return;
        }

        var bufferedEnd = video.buffered.end(video.buffered.length - 1);
        setProgress((bufferedEnd / video.duration) * 100);
      }

      function markReady() {
        setProgress(100);
        banner.classList.add('is-video-ready');
      }

      video.addEventListener('loadstart', function() { setProgress(8); });
      video.addEventListener('loadedmetadata', function() { setProgress(25); });
      video.addEventListener('progress', updateBufferedProgress);
      video.addEventListener('canplay', markReady);
      video.addEventListener('playing', markReady);
      video.addEventListener('waiting', function() {
        banner.classList.remove('is-video-ready');
        updateBufferedProgress();
      });

      if (video.readyState >= 3) {
        markReady();
      } else {
        updateBufferedProgress();
      }
    })();
  </script>
{%- endif -%}

