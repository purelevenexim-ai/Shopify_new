{%- comment -%}
Tea & Coffee Trial Pack Section
- "Still not sure? Try all four"
- Shows trial pack with component products listed
- Dynamic pricing from Shopify variant
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'tc-design-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'tc-page.css' | asset_url }}">
<script src="{{ 'tc-ajax-cart.js' | asset_url }}" defer></script>

<section class="tc-trial-pack" id="trial-pack">
  <div class="tc-trial-pack__container">
    {%- assign product = all_products[section.settings.product_handle] -%}

    {%- if product -%}
      <div class="tc-trial-pack__wrapper">
        {%- comment -%} Text Content {%- endcomment -%}
        <div class="tc-trial-pack__content">
          <p class="tc-eyebrow tc-eyebrow--left"><i>02</i> / Tea Combo</p>
          {%- if section.settings.heading -%}
            <h2 class="tc-trial-pack__heading tc-h2">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.subheading -%}
            <p class="tc-trial-pack__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}

          {%- comment -%} Trial Pack Contents {%- endcomment -%}
          <div class="tc-trial-pack__contents">
            <div class="tc-trial-pack__content-item">
              <span class="tc-trial-pack__content-icon">🍵</span>
              <span class="tc-trial-pack__content-text">Milk Tea 100g</span>
            </div>
            <div class="tc-trial-pack__content-item">
              <span class="tc-trial-pack__content-icon">🫖</span>
              <span class="tc-trial-pack__content-text">Black Tea 100g</span>
            </div>
            <div class="tc-trial-pack__content-item">
              <span class="tc-trial-pack__content-icon">🧋</span>
              <span class="tc-trial-pack__content-text">Cardamom Tea 100g</span>
            </div>

          </div>

          {%- assign first_variant = product.first_available_variant | default: product.variants.first -%}

          {%- if first_variant -%}
            <div class="tc-trial-pack__pricing">
              <div class="tc-trial-pack__price-display">
                {%- if first_variant.compare_at_price > first_variant.price -%}
                  <s class="tc-trial-pack__price-original">&#8377;{{ first_variant.compare_at_price | divided_by: 100 }}</s>
                {%- endif -%}
                <strong class="tc-trial-pack__price-current">&#8377;{{ first_variant.price | divided_by: 100 }}</strong>
              </div>
            </div>
          {%- endif -%}

          {%- comment -%} Add to Cart Form {%- endcomment -%}
          {%- assign tc_trial_form_id = 'trial-pack-form-' | append: section.id -%}
          {%- form 'product', product, id: tc_trial_form_id, class: 'tc-trial-pack-form', novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ first_variant.id }}" />
            <button
              type="submit"
              class="tc-trial-pack__button"
              name="add"
              {%- unless first_variant.available %} disabled {% endunless -%}
            >
              {%- if first_variant.available -%}
                {{ section.settings.button_text }}
              {%- else -%}
                Sold Out
              {%- endif -%}
            </button>
          {%- endform -%}
        </div>

        {%- comment -%} Trial Pack Image {%- endcomment -%}
        <div class="tc-trial-pack__visual tc-tea-combo">
          {%- assign combo_handles = 'premium-milk-tea-powder,premium-black-tea-granules,cardamom-tea' | split: ',' -%}
          {%- for combo_handle in combo_handles -%}
            {%- assign combo_product = all_products[combo_handle] -%}
            {{ combo_product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '160,240,400', sizes: '(min-width: 990px) 15vw, 30vw', alt: combo_product.title }}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} Section Settings Schema {%- endcomment -%}

{% schema %}
{
  "name": "Tea & Coffee Trial Pack",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still not sure which one you'll like?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Try all four first."
    },
    {
      "type": "text",
      "id": "product_handle",
      "label": "Trial pack product handle",
      "default": "starter-trial-pack-4-varieties"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Try All Four"
    }
  ],
  "presets": [
    {
      "name": "Tea & Coffee Trial Pack"
    }
  ]
}
{% endschema %}
