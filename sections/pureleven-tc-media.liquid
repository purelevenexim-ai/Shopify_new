<section class="tc-campaign-video" aria-labelledby="tc-media-{{ section.id }}">
  <h2 id="tc-media-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  <video controls muted playsinline preload="none" width="540" height="960" poster="{{ 'tc-harvest-poster.webp' | asset_url }}" aria-label="{{ 'tc_campaign.farm_video' | t }}">
    <source src="{{ 'tc-cardamom-harvest.mp4' | asset_url }}" type="video/mp4">
    <a href="{{ 'tc-cardamom-harvest.mp4' | asset_url }}">{{ 'tc_campaign.video_fallback' | t }}</a>
  </video>
</section>
{% schema %}
{"name":"Cardamom harvest media","settings":[{"type":"text","id":"heading","label":"Heading","default":"A closer look at our cardamom"}],"presets":[{"name":"Cardamom harvest media"}]}
{% endschema %}
