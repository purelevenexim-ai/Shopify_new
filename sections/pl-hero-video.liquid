{% comment %}PureLeven Custom Hero — text left, video right (desktop) / video top (mobile){% endcomment %}

<style>
/* Hero: "Hills & Hands" design system (assets/pl-hills.css). Literal values so first paint never waits on a stylesheet. px only. */
html body .sk-hero { width: 100%; background: #FFFDF7; color: #1F1B16; font-family: 'Nunito', 'Segoe UI', system-ui, sans-serif; }
html body .sk-hero * { box-sizing: border-box; }
html body .sk-hero .pl-announcement { display: none; }
html body .sk-hero .pl-hero-section { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 48px; max-width: 1200px; margin: 0 auto; padding: 56px 32px 40px; background: transparent; }
html body .sk-hero .pl-hero-left { display: flex; flex-direction: column; gap: 18px; padding: 0; background: transparent; }
html body .sk-hero .pl-hero-left > * { margin: 0 !important; }
html body .sk-hero .pl-eyebrow-rule { display: none; }
html body .sk-hero .pl-eyebrow-text { color: #8E6420; font: 800 13px/1.3 'Nunito', sans-serif !important; letter-spacing: 0.06em !important; text-transform: uppercase !important; }
html body .sk-hero .pl-hero-heading { max-width: 15ch; color: #1F1B16 !important; font-family: 'Nunito', sans-serif !important; font-size: 46px !important; font-weight: 800 !important; line-height: 1.12 !important; letter-spacing: -0.015em !important; text-transform: none !important; }
html body .sk-hero .pl-hero-sub { max-width: 44ch; color: #3D3730; font: 500 18px/1.55 'Nunito', sans-serif !important; letter-spacing: 0 !important; }
html body .sk-hero .pl-hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
html body .sk-hero .pl-btn-primary, html body .sk-hero .pl-btn-secondary { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 14px 26px !important; border-radius: 12px !important; box-shadow: none !important; font: 800 16px/1.2 'Nunito', sans-serif !important; letter-spacing: 0 !important; text-transform: none !important; text-decoration: none !important; transition: background-color .2s, transform .2s; }
html body .sk-hero .pl-btn-primary { background: #FCE477 !important; border: 1.5px solid #FCE477 !important; color: #1A1A1A !important; }
html body .sk-hero .pl-btn-primary:hover { background: #F4D138 !important; border-color: #F4D138 !important; transform: translateY(-1px); }
html body .sk-hero .pl-btn-secondary { background: #fff !important; border: 1.5px solid #24503F !important; color: #24503F !important; }
html body .sk-hero .pl-btn-secondary:hover { background: #EEF4EF !important; transform: translateY(-1px); }
html body .sk-hero .pl-stat-card { display: none; }
html body .sk-hero .pl-hero-right { position: relative; overflow: hidden; aspect-ratio: 4 / 3; border-radius: 22px; background: #E7EFE7; box-shadow: 0 2px 4px rgba(31,27,22,.05), 0 18px 44px rgba(31,27,22,.11); }
html body .sk-hero .pl-hero-right video, html body .sk-hero .pl-hero-right img.pl-hero-poster { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
html body .sk-hero .pl-hero-play { position: absolute; left: 50%; top: 50%; z-index: 2; transform: translate(-50%, -50%); display: grid; place-items: center; width: 58px; height: 58px; padding: 0; background: rgba(255, 253, 247, 0.9); border: 0; border-radius: 50%; color: #24503F; font-size: 16px; line-height: 1; cursor: pointer; box-shadow: 0 4px 14px rgba(0,0,0,.18); }
html body .sk-hero .pl-hero-play[hidden] { display: none; }
html body .sk-hero .pl-hero-play:focus-visible { outline: 2px solid #FCE477; outline-offset: 3px; }
html body .sk-hero .pl-trust-bar { background: transparent; border: 0; }
html body .sk-hero .pl-trust-inner { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; max-width: 1200px; margin: 0 auto; padding: 0 32px 24px; }
html body .sk-hero .pl-trust-item { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 14px 16px; border: 0; border-radius: 16px; background: #fff; box-shadow: 0 1px 2px rgba(31,27,22,.05), 0 8px 24px rgba(31,27,22,.07); }
html body .sk-hero .pl-trust-icon { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: #EEF4EF; color: #24503F; }
html body .sk-hero .pl-trust-icon svg { width: 24px; height: 24px; }
html body .sk-hero .pl-trust-text { min-width: 0; }
html body .sk-hero .pl-trust-text strong { display: block; color: #1F1B16; font: 800 14.5px/1.3 'Nunito', sans-serif; letter-spacing: 0; }
html body .sk-hero .pl-trust-text span { display: block; margin-top: 2px; color: #5A534A; font: 600 13px/1.35 'Nunito', sans-serif; letter-spacing: 0; text-transform: none; }
@media screen and (max-width: 749px) {
  html body .sk-hero .pl-hero-section { grid-template-columns: 1fr; gap: 20px; padding: 16px 16px 24px; }
  html body .sk-hero .pl-hero-right { order: -1; aspect-ratio: 16 / 10; border-radius: 18px; }
  html body .sk-hero .pl-hero-left { gap: 14px; }
  html body .sk-hero .pl-hero-heading { font-size: 30px !important; line-height: 1.15 !important; }
  html body .sk-hero .pl-hero-sub { font-size: 16px !important; }
  html body .sk-hero .pl-hero-ctas { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  html body .sk-hero .pl-btn-primary, html body .sk-hero .pl-btn-secondary { padding: 12px 8px !important; font-size: 15px !important; }
  html body .sk-hero .pl-trust-inner { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; padding: 0 16px 16px; }
  html body .sk-hero .pl-trust-item { flex-direction: column; align-items: flex-start; gap: 8px; padding: 12px; }
  html body .sk-hero .pl-trust-text strong { font-size: 14px; }
  html body .sk-hero .pl-trust-text span { font-size: 12.5px; }
}
@media (prefers-reduced-motion: reduce) {
  html body .sk-hero .pl-btn-primary, html body .sk-hero .pl-btn-secondary { transition: none; }
}
</style>

<div class="pl-hero-wrap sk-hero">

  {%- if section.settings.show_announcement and section.settings.announcement_text != blank -%}
  <div class="pl-announcement">{{ section.settings.announcement_text }}</div>
  {%- endif -%}

  <div class="pl-hero-section">

    <div class="pl-hero-left">
      {%- if section.settings.eyebrow != blank -%}
      <div class="pl-eyebrow-wrap">
        <span class="pl-eyebrow-rule"></span>
        <span class="pl-eyebrow-text">{{ section.settings.eyebrow }}</span>
      </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
      <h1 class="pl-hero-heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
      <p class="pl-hero-sub">{{ section.settings.subtext }}</p>
      {%- endif -%}

      <div class="pl-hero-ctas">
        {%- if section.settings.cta1_label != blank -%}
        <a href="{{ section.settings.cta1_url | default: '/collections/all' }}" class="pl-btn-primary">{{- section.settings.cta1_label -}}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
        <a href="{{ section.settings.cta2_url | default: '/blogs/cooking-spices' }}" class="pl-btn-secondary">{{- section.settings.cta2_label -}}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.stat_number != blank -%}
      <div class="pl-stat-card">
        <div class="pl-stat-num">{{ section.settings.stat_number }}</div>
        <div class="pl-stat-meta">
          <span class="pl-stat-label">{{ section.settings.stat_label }}</span>
          <span class="pl-stat-place">{{ section.settings.stat_place }}</span>
        </div>
      </div>
      {%- endif -%}
    </div>

    <div class="pl-hero-right">
      {%- if section.settings.video != blank -%}
        {%- comment -%}
          Shopify only exposes two sources to the storefront for this video and
          both are 1080p — the 480p and 720p renditions exist in the CDN but a
          theme cannot reach them. So the lever is *when* the bytes arrive, not
          which file.

          Phones get the poster and nothing else until they tap: 2.7 MB of
          decoration is not worth a mobile data plan. Desktop keeps the ambient
          loop but only after load, so it never competes with LCP.

          If the source video is ever re-uploaded at 720p, every visitor gets the
          smaller file automatically and this still holds.
        {%- endcomment -%}
        {%- comment -%}
          The poster is the largest thing on the first screen, so the browser is
          told about it now, at high priority, instead of finding it late.
          900px covers a phone at 2x and a laptop column at 1.5x.
        {%- endcomment -%}
        {%- capture pl_hero_video_html -%}
          {{- section.settings.video
              | video_tag: loop: true, muted: true, playsinline: true,
                           preload: 'none', class: 'pl-hero-video', image_size: '900x' -}}
        {%- endcapture -%}
        {%- assign pl_poster = pl_hero_video_html | split: 'poster="' | last | split: '"' | first -%}
        {%- if pl_hero_video_html contains 'poster="' and pl_poster != blank -%}
          <link rel="preload" as="image" href="{{ pl_poster }}" fetchpriority="high">
        {%- endif -%}
        {{- pl_hero_video_html -}}
        <button type="button" class="pl-hero-play" aria-label="Play the film">
          <span aria-hidden="true">&#9654;</span>
        </button>
        <script>
          (function () {
            var wrap = document.currentScript.parentNode;
            var v = wrap.querySelector('video.pl-hero-video');
            var btn = wrap.querySelector('.pl-hero-play');
            if (!v) return;

            // Detach the sources so preload="none" cannot be second-guessed.
            var held = [].slice.call(v.querySelectorAll('source'));
            held.forEach(function (s) { s.parentNode.removeChild(s); });

            var started = false;
            function start() {
              if (started) return;
              started = true;
              if (btn) btn.hidden = true;
              held.forEach(function (s) { v.appendChild(s); });
              v.load();
              var p = v.play();
              if (p && p.catch) p.catch(function () { if (btn) btn.hidden = false; started = false; });
            }

            var slow = navigator.connection && (navigator.connection.saveData ||
                       /2g/.test(navigator.connection.effectiveType || ''));

            if (slow) {
              // Data saver / 2G only: poster, the visitor decides.
              if (btn) btn.hidden = false;
              btn && btn.addEventListener('click', start);
              v.addEventListener('click', start);
            } else {
              if (btn) btn.hidden = true;
              var kick = function () {
                if (window.requestIdleCallback) requestIdleCallback(start, { timeout: 2000 });
                else setTimeout(start, 600);
              };
              if (document.readyState === 'complete') kick();
              else window.addEventListener('load', kick);
            }
          })();
        </script>
      {%- elsif section.settings.cover_image != blank -%}
        <img src="{{ section.settings.cover_image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" class="pl-hero-poster" loading="eager">
      {%- endif -%}
    </div>

  </div>

  {%- if section.blocks.size > 0 -%}
  <div class="pl-trust-bar">
    <div class="pl-trust-inner">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_item' -%}
        <div class="pl-trust-item" {{ block.shopify_attributes }}>
          <span class="pl-trust-icon" aria-hidden="true">{%- render 'tcx-icon', name: block.settings.icon -%}</span>
          <div class="pl-trust-text">
            <strong>{{ block.settings.title }}</strong>
            <span>{{ block.settings.subtitle }}</span>
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "PL Hero Video",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type": "header", "content": "Announcement"},
    {"type": "checkbox", "id": "show_announcement", "label": "Show announcement bar", "default": false},
    {"type": "text", "id": "announcement_text", "label": "Announcement text", "default": "Farm-to-Home Spices from Kerala · Free Shipping on orders above ₹649"},
    {"type": "header", "content": "Video"},
    {"type": "video", "id": "video", "label": "Video (Shopify-hosted)"},
    {"type": "image_picker", "id": "cover_image", "label": "Fallback image (shown if no video)"},
    {"type": "header", "content": "Content"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Kerala · Harvested to order"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Fresh Spices, Chosen at Origin"},
    {"type": "textarea", "id": "subtext", "label": "Subtext", "default": "We source directly from small-batch farms in Idukki and Wayanad — no middlemen, no warehouse months."},
    {"type": "header", "content": "CTAs"},
    {"type": "text", "id": "cta1_label", "label": "Primary button label", "default": "Shop Spices"},
    {"type": "url", "id": "cta1_url", "label": "Primary button URL"},
    {"type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "Read our guides"},
    {"type": "url", "id": "cta2_url", "label": "Secondary button URL"},
    {"type": "header", "content": "Provenance stat"},
    {"type": "text", "id": "stat_number", "label": "Stat number", "default": "12+"},
    {"type": "text", "id": "stat_label", "label": "Stat label", "default": "Farm partners"},
    {"type": "text", "id": "stat_place", "label": "Location", "default": "Idukki & Wayanad"}
  ],
  "blocks": [
    {
      "name": "Trust item",
      "type": "trust_item",
      "limit": 4,
      "settings": [
        {"type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🌿"},
        {"type": "text", "id": "title", "label": "Title", "default": "No middlemen"},
        {"type": "text", "id": "subtitle", "label": "Subtitle", "default": "Farm → your door"}
      ]
    }
  ],
  "presets": [
    {
      "name": "PL Hero Video",
      "blocks": [
        {"type": "trust_item", "settings": {"icon": "🌿", "title": "No middlemen", "subtitle": "Farm → your door"}},
        {"type": "trust_item", "settings": {"icon": "📦", "title": "Free shipping", "subtitle": "Orders above ₹649"}},
        {"type": "trust_item", "settings": {"icon": "⚡", "title": "Dispatched in 24h", "subtitle": "Mon – Sat"}},
        {"type": "trust_item", "settings": {"icon": "✦", "title": "Small batch only", "subtitle": "Seasonal harvests"}}
      ]
    }
  ]
}
{% endschema %}