{% comment %}PureLeven Custom Hero — text left, video right (desktop) / video top (mobile){% endcomment %}

<style>
/* Hero — skillies language, px only. Literal values (no token file) so first paint never waits on a stylesheet. */
html body .sk-hero { width: 100%; background: #F9F9F6; color: #0B0B0F; font-family: 'Manrope', 'Segoe UI', Helvetica, Arial, sans-serif; }
html body .sk-hero * { box-sizing: border-box; }
html body .sk-hero .pl-announcement {
  padding: 10px 16px; background: #0B0B0F; color: #fff; text-align: center;
  font: 400 11px/1.5 ui-monospace, 'SF Mono', Menlo, Consolas, monospace !important; letter-spacing: 0.12em !important; text-transform: uppercase !important;
}
html body .sk-hero .pl-hero-section { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); min-height: 560px; background: #F9F9F6; }
html body .sk-hero .pl-hero-left {
  display: flex; flex-direction: column; justify-content: center; gap: 20px;
  padding: 72px clamp(20px, 4vw, 56px); background: transparent;
}
html body .sk-hero .pl-hero-left > * { margin: 0 !important; }
html body .sk-hero .pl-eyebrow-wrap { display: block; }
html body .sk-hero .pl-eyebrow-rule { display: none; }
html body .sk-hero .pl-eyebrow-text {
  color: #1F6B5C; font: 400 11px/1.5 ui-monospace, 'SF Mono', Menlo, Consolas, monospace !important;
  letter-spacing: 0.12em !important; text-transform: uppercase !important;
}
html body .sk-hero .pl-hero-heading {
  max-width: 14ch; color: #0B0B0F !important;
  font-family: 'Manrope', 'Segoe UI', Helvetica, Arial, sans-serif !important; font-size: clamp(40px, 4.8vw, 76px) !important;
  font-weight: 600 !important; line-height: 1.02 !important; letter-spacing: -0.05em !important; text-transform: none !important;
}
html body .sk-hero .pl-hero-sub { max-width: 46ch; color: #5F6470; font-size: 17px !important; line-height: 1.6 !important; letter-spacing: 0 !important; }
html body .sk-hero .pl-hero-ctas { display: flex; flex-wrap: wrap; gap: 10px; }
html body .sk-hero .pl-btn-primary, html body .sk-hero .pl-btn-secondary {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px;
  padding: 14px 24px 14px 26px !important; border: 1px solid #17191A !important; border-radius: 2px !important; box-shadow: none !important;
  font-family: 'Manrope', 'Segoe UI', Helvetica, Arial, sans-serif !important; font-size: 13px !important; font-weight: 600 !important;
  line-height: 1.2 !important; letter-spacing: -0.01em !important; text-transform: none !important; text-decoration: none !important;
  transition: background-color 0.2s, border-color 0.2s, color 0.2s, transform 0.25s cubic-bezier(0.2, 0.65, 0.2, 1);
}
html body .sk-hero .pl-btn-primary { background: #17191A !important; color: #fff !important; }
html body .sk-hero .pl-btn-primary:hover { background: #004438 !important; border-color: #004438 !important; transform: translateY(-1px); }
html body .sk-hero .pl-btn-secondary { background: transparent !important; color: #0B0B0F !important; }
html body .sk-hero .pl-btn-secondary:hover { background: #17191A !important; color: #fff !important; transform: translateY(-1px); }
html body .sk-hero .pl-stat-card {
  display: flex; align-items: center; gap: 14px; width: fit-content; padding: 14px 18px 14px 16px;
  background: #fff; border: 1px solid #DEDEDB; border-radius: 3px; box-shadow: none;
}
html body .sk-hero .pl-stat-num { color: #1F6B5C; font-size: 32px; font-weight: 600; line-height: 1; letter-spacing: -0.04em; }
html body .sk-hero .pl-stat-meta { display: flex; flex-direction: column; gap: 2px; }
html body .sk-hero .pl-stat-label { color: #5F6470; font: 400 10.5px/1.4 ui-monospace, 'SF Mono', Menlo, Consolas, monospace !important; letter-spacing: 0.1em !important; text-transform: uppercase !important; }
html body .sk-hero .pl-stat-place { color: #3D4250; font-size: 13px; font-weight: 500; }

html body .sk-hero .pl-hero-right { position: relative; overflow: hidden; background: #101314; border-left: 1px solid #DEDEDB; }
html body .sk-hero .pl-hero-right video,
html body .sk-hero .pl-hero-right img.pl-hero-poster { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
html body .sk-hero .pl-hero-play {
  position: absolute; left: 50%; top: 50%; z-index: 2; transform: translate(-50%, -50%);
  display: grid; place-items: center; width: 56px; height: 56px; padding: 0;
  background: rgba(11, 11, 15, 0.6); border: 1px solid rgba(255, 255, 255, 0.45); border-radius: 2px;
  color: #fff; font-size: 16px; line-height: 1; cursor: pointer; backdrop-filter: blur(6px);
}
html body .sk-hero .pl-hero-play[hidden] { display: none; }
html body .sk-hero .pl-hero-play:focus-visible { outline: 2px solid #FCE477; outline-offset: 3px; }

html body .sk-hero .pl-trust-bar { background: #F1F1ED; border-top: 1px solid #DEDEDB; border-bottom: 1px solid #DEDEDB; }
html body .sk-hero .pl-trust-inner { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); max-width: 1440px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 56px); }
html body .sk-hero .pl-trust-item { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 18px 16px; border: 0; border-left: 1px solid #DEDEDB; }
html body .sk-hero .pl-trust-item:first-child { border-left: 0; padding-left: 0; }
html body .sk-hero .pl-trust-icon { flex: none; font-size: 18px; line-height: 1; }
html body .sk-hero .pl-trust-text { min-width: 0; }
html body .sk-hero .pl-trust-text strong { display: block; color: #0B0B0F; font-size: 13px; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }
html body .sk-hero .pl-trust-text span { display: block; margin-top: 2px; color: #5F6470; font: 400 10.5px/1.4 ui-monospace, 'SF Mono', Menlo, Consolas, monospace; letter-spacing: 0.08em; text-transform: uppercase; }

@media screen and (max-width: 749px) {
  html body .sk-hero .pl-hero-section { grid-template-columns: 1fr; min-height: 0; }
  html body .sk-hero .pl-hero-right { order: -1; aspect-ratio: 16 / 9; border-left: 0; border-bottom: 1px solid #DEDEDB; }
  html body .sk-hero .pl-hero-left { gap: 16px; padding: 28px 20px 32px; }
  html body .sk-hero .pl-hero-sub { font-size: 16px !important; }
  html body .sk-hero .pl-hero-ctas { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  html body .sk-hero .pl-btn-primary, html body .sk-hero .pl-btn-secondary { padding: 12px 10px !important; }
  html body .sk-hero .pl-stat-card { width: 100%; }
  html body .sk-hero .pl-trust-inner { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 0 20px; }
  html body .sk-hero .pl-trust-item { gap: 10px; padding: 14px 10px 14px 12px; }
  html body .sk-hero .pl-trust-item:nth-child(odd) { border-left: 0; padding-left: 0; }
  html body .sk-hero .pl-trust-item:nth-child(n+3) { border-top: 1px solid #DEDEDB; }
  html body .sk-hero .pl-trust-text strong { font-size: 12.5px; }
  html body .sk-hero .pl-trust-text span { font-size: 10.5px; letter-spacing: 0.05em; }
}
@media (prefers-reduced-motion: reduce) {
  html body .sk-hero .pl-btn-primary, html body .sk-hero .pl-btn-secondary { transition: none; }
}
</style>

<div class="pl-hero-wrap sk-hero">

  {%- if section.settings.show_announcement and section.settings.announcement_text != blank -%}
  <div class="pl-announcement">{{ section.settings.announcement_text }}</div>
  {%- endif -%}

  <div class="pl-hero-section">

    <div class="pl-hero-left">
      {%- if section.settings.eyebrow != blank -%}
      <div class="pl-eyebrow-wrap">
        <span class="pl-eyebrow-rule"></span>
        <span class="pl-eyebrow-text">{{ section.settings.eyebrow }}</span>
      </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
      <h1 class="pl-hero-heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
      <p class="pl-hero-sub">{{ section.settings.subtext }}</p>
      {%- endif -%}

      <div class="pl-hero-ctas">
        {%- if section.settings.cta1_label != blank -%}
        <a href="{{ section.settings.cta1_url | default: '/collections/all' }}" class="pl-btn-primary">{{- section.settings.cta1_label -}}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
        <a href="{{ section.settings.cta2_url | default: '/blogs/cooking-spices' }}" class="pl-btn-secondary">{{- section.settings.cta2_label -}}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.stat_number != blank -%}
      <div class="pl-stat-card">
        <div class="pl-stat-num">{{ section.settings.stat_number }}</div>
        <div class="pl-stat-meta">
          <span class="pl-stat-label">{{ section.settings.stat_label }}</span>
          <span class="pl-stat-place">{{ section.settings.stat_place }}</span>
        </div>
      </div>
      {%- endif -%}
    </div>

    <div class="pl-hero-right">
      {%- if section.settings.video != blank -%}
        {%- comment -%}
          Shopify only exposes two sources to the storefront for this video and
          both are 1080p — the 480p and 720p renditions exist in the CDN but a
          theme cannot reach them. So the lever is *when* the bytes arrive, not
          which file.

          Phones get the poster and nothing else until they tap: 2.7 MB of
          decoration is not worth a mobile data plan. Desktop keeps the ambient
          loop but only after load, so it never competes with LCP.

          If the source video is ever re-uploaded at 720p, every visitor gets the
          smaller file automatically and this still holds.
        {%- endcomment -%}
        {%- comment -%}
          The poster is the largest thing on the first screen, so the browser is
          told about it now, at high priority, instead of finding it late.
          900px covers a phone at 2x and a laptop column at 1.5x.
        {%- endcomment -%}
        {%- capture pl_hero_video_html -%}
          {{- section.settings.video
              | video_tag: loop: true, muted: true, playsinline: true,
                           preload: 'none', class: 'pl-hero-video', image_size: '900x' -}}
        {%- endcapture -%}
        {%- assign pl_poster = pl_hero_video_html | split: 'poster="' | last | split: '"' | first -%}
        {%- if pl_hero_video_html contains 'poster="' and pl_poster != blank -%}
          <link rel="preload" as="image" href="{{ pl_poster }}" fetchpriority="high">
        {%- endif -%}
        {{- pl_hero_video_html -}}
        <button type="button" class="pl-hero-play" aria-label="Play the film">
          <span aria-hidden="true">&#9654;</span>
        </button>
        <script>
          (function () {
            var wrap = document.currentScript.parentNode;
            var v = wrap.querySelector('video.pl-hero-video');
            var btn = wrap.querySelector('.pl-hero-play');
            if (!v) return;

            // Detach the sources so preload="none" cannot be second-guessed.
            var held = [].slice.call(v.querySelectorAll('source'));
            held.forEach(function (s) { s.parentNode.removeChild(s); });

            var started = false;
            function start() {
              if (started) return;
              started = true;
              if (btn) btn.hidden = true;
              held.forEach(function (s) { v.appendChild(s); });
              v.load();
              var p = v.play();
              if (p && p.catch) p.catch(function () { if (btn) btn.hidden = false; started = false; });
            }

            var slow = navigator.connection && (navigator.connection.saveData ||
                       /2g/.test(navigator.connection.effectiveType || ''));

            if (slow) {
              // Data saver / 2G only: poster, the visitor decides.
              if (btn) btn.hidden = false;
              btn && btn.addEventListener('click', start);
              v.addEventListener('click', start);
            } else {
              if (btn) btn.hidden = true;
              var kick = function () {
                if (window.requestIdleCallback) requestIdleCallback(start, { timeout: 2000 });
                else setTimeout(start, 600);
              };
              if (document.readyState === 'complete') kick();
              else window.addEventListener('load', kick);
            }
          })();
        </script>
      {%- elsif section.settings.cover_image != blank -%}
        <img src="{{ section.settings.cover_image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" class="pl-hero-poster" loading="eager">
      {%- endif -%}
    </div>

  </div>

  {%- if section.blocks.size > 0 -%}
  <div class="pl-trust-bar">
    <div class="pl-trust-inner">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_item' -%}
        <div class="pl-trust-item" {{ block.shopify_attributes }}>
          <span class="pl-trust-icon">{{ block.settings.icon }}</span>
          <div class="pl-trust-text">
            <strong>{{ block.settings.title }}</strong>
            <span>{{ block.settings.subtitle }}</span>
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "PL Hero Video",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type": "header", "content": "Announcement"},
    {"type": "checkbox", "id": "show_announcement", "label": "Show announcement bar", "default": false},
    {"type": "text", "id": "announcement_text", "label": "Announcement text", "default": "Farm-to-Home Spices from Kerala · Free Shipping on orders above ₹649"},
    {"type": "header", "content": "Video"},
    {"type": "video", "id": "video", "label": "Video (Shopify-hosted)"},
    {"type": "image_picker", "id": "cover_image", "label": "Fallback image (shown if no video)"},
    {"type": "header", "content": "Content"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Kerala · Harvested to order"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Fresh Spices, Chosen at Origin"},
    {"type": "textarea", "id": "subtext", "label": "Subtext", "default": "We source directly from small-batch farms in Idukki and Wayanad — no middlemen, no warehouse months."},
    {"type": "header", "content": "CTAs"},
    {"type": "text", "id": "cta1_label", "label": "Primary button label", "default": "Shop Spices"},
    {"type": "url", "id": "cta1_url", "label": "Primary button URL"},
    {"type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "Read our guides"},
    {"type": "url", "id": "cta2_url", "label": "Secondary button URL"},
    {"type": "header", "content": "Provenance stat"},
    {"type": "text", "id": "stat_number", "label": "Stat number", "default": "12+"},
    {"type": "text", "id": "stat_label", "label": "Stat label", "default": "Farm partners"},
    {"type": "text", "id": "stat_place", "label": "Location", "default": "Idukki & Wayanad"}
  ],
  "blocks": [
    {
      "name": "Trust item",
      "type": "trust_item",
      "limit": 4,
      "settings": [
        {"type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🌿"},
        {"type": "text", "id": "title", "label": "Title", "default": "No middlemen"},
        {"type": "text", "id": "subtitle", "label": "Subtitle", "default": "Farm → your door"}
      ]
    }
  ],
  "presets": [
    {
      "name": "PL Hero Video",
      "blocks": [
        {"type": "trust_item", "settings": {"icon": "🌿", "title": "No middlemen", "subtitle": "Farm → your door"}},
        {"type": "trust_item", "settings": {"icon": "📦", "title": "Free shipping", "subtitle": "Orders above ₹649"}},
        {"type": "trust_item", "settings": {"icon": "⚡", "title": "Dispatched in 24h", "subtitle": "Mon – Sat"}},
        {"type": "trust_item", "settings": {"icon": "✦", "title": "Small batch only", "subtitle": "Seasonal harvests"}}
      ]
    }
  ]
}
{% endschema %}