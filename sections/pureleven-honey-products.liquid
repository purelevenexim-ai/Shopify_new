{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{{ 'tc-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'tc-product-card.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'tc-ajax-cart.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding: {{ section.settings.padding_top | times: 0.7 | round }}px 0 {{ section.settings.padding_bottom | times: 0.7 | round }}px;
    background: var(--sk-bg) !important; color: var(--sk-fg); font-family: var(--sk-sans);
  }
  #shopify-section-{{ section.id }} .hn-products { max-width: var(--sk-wrap); margin: 0 auto; padding: 0 var(--sk-gutter); }
  #shopify-section-{{ section.id }} .hn-products__head { margin: 0 0 24px; text-align: left; }
  #shopify-section-{{ section.id }} .hn-products__head > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .hn-products__eyebrow { display: block; margin-bottom: 16px !important; color: var(--sk-muted) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; }
  #shopify-section-{{ section.id }} .hn-products__title { max-width: 18ch; color: var(--sk-fg) !important; text-align: left !important; font-family: var(--sk-sans) !important; font-size: clamp(34px, 4.2vw, 60px) !important; font-weight: 500 !important; line-height: 1.08 !important; letter-spacing: -0.055em !important; text-transform: none !important; }
  #shopify-section-{{ section.id }} .hn-products__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  #shopify-section-{{ section.id }} .hn-products__grid > * { min-width: 0; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
    #shopify-section-{{ section.id }} .hn-products__head { margin-bottom: 40px; }
    #shopify-section-{{ section.id }} .hn-products__grid { grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr)); gap: 20px; }
  }
{%- endstyle -%}

<div id="honey-products">
  <div class="hn-products">
    <div class="hn-products__head">
      <p class="hn-products__eyebrow">KERALA HONEY</p>
      <h2 class="hn-products__title">{{ section.settings.heading | default: 'Shop Kerala Honey' }}</h2>
    </div>
    <div class="hn-products__grid">
      {%- assign handles = section.settings.product_handles | split: ',' -%}
      {%- for handle in handles -%}
        {%- assign handle_clean = handle | strip -%}
        {%- assign prod = all_products[handle_clean] -%}
        {%- if prod != empty -%}
          {%- render 'pureleven-tc-product-card', product: prod -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Honey Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop Kerala Honey" },
    { "type": "text", "id": "product_handles", "label": "Product handles (comma-separated)", "default": "naadan-pure-honey" },
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 4, "step": 1, "label": "Columns desktop", "default": 2 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
  ],
  "presets": [{ "name": "Honey Products" }]
}
{% endschema %}
