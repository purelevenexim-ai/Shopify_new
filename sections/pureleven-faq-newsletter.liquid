{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding pl-faq-newsletter">
  <div class="page-width">
    <div class="pl-faq-newsletter__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pl-faq-newsletter__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pl-faq-newsletter__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="pl-faq-newsletter__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="pl-faq-newsletter__faq">
        <div class="pl-faq-newsletter__accordion">
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq-item' -%}
              <div class="pl-faq-newsletter__item" data-accordion-id="{{ forloop.index }}">
                <button class="pl-faq-newsletter__trigger" aria-expanded="false" aria-controls="panel-{{ forloop.index }}">
                  <span class="pl-faq-newsletter__question">{{ block.settings.question }}</span>
                  <svg class="pl-faq-newsletter__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 9l6 6 6-6"></path>
                  </svg>
                </button>
                <div class="pl-faq-newsletter__content" id="panel-{{ forloop.index }}" hidden>
                  <div class="pl-faq-newsletter__answer">{{ block.settings.answer }}</div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.newsletter_heading != blank -%}
      <div class="pl-faq-newsletter__newsletter">
        <div class="pl-faq-newsletter__newsletter-inner">
          <div class="pl-faq-newsletter__newsletter-content">
            <h3 class="pl-faq-newsletter__newsletter-heading">{{ section.settings.newsletter_heading }}</h3>
            {%- if section.settings.newsletter_description != blank -%}
              <p class="pl-faq-newsletter__newsletter-description">{{ section.settings.newsletter_description }}</p>
            {%- endif -%}
          </div>
          <form class="pl-faq-newsletter__form" action="/contact#contact" method="post">
            <input type="email" name="contact[email]" placeholder="your@email.com" class="pl-faq-newsletter__input" required>
            <button type="submit" class="pl-faq-newsletter__submit">Subscribe</button>
          </form>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .pl-faq-newsletter {
    background: #fff;
  }

  .pl-faq-newsletter__header {
    text-align: center;
    margin-bottom: 3.2rem;
  }

  .pl-faq-newsletter__eyebrow {
    display: inline-block;
    margin: 0 0 0.8rem;
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pl-teal-mid, #2e7d6e);
  }

  .pl-faq-newsletter__heading {
    margin: 0 0 1.2rem;
    font-family: var(--font-fraunces, 'Fraunces', serif) !important;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 400;
    color: var(--pl-near-black, #1a1a1a);
  }

  .pl-faq-newsletter__description {
    margin: 0;
    max-width: 600px;
    font-family: 'Inter', sans-serif;
    font-size: 1.3rem;
    line-height: 1.6;
    color: var(--pl-text-muted, #5c5648);
  }

  .pl-faq-newsletter__faq {
    margin-bottom: 4rem;
  }

  .pl-faq-newsletter__accordion {
    max-width: 800px;
    margin: 0 auto;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 1.2rem;
    overflow: hidden;
  }

  .pl-faq-newsletter__item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .pl-faq-newsletter__item:last-child {
    border-bottom: none;
  }

  .pl-faq-newsletter__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1.6rem;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  @media screen and (min-width: 750px) {
    .pl-faq-newsletter__trigger {
      padding: 2rem;
    }
  }

  .pl-faq-newsletter__trigger:hover {
    background: rgba(46, 125, 110, 0.05);
  }

  .pl-faq-newsletter__trigger[aria-expanded="true"] {
    background: rgba(46, 125, 110, 0.08);
  }

  .pl-faq-newsletter__question {
    flex: 1;
    text-align: left;
    font-family: 'Inter', sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--pl-near-black, #1a1a1a);
  }

  .pl-faq-newsletter__icon {
    width: 20px;
    height: 20px;
    margin-left: 1rem;
    color: var(--pl-teal-mid, #2e7d6e);
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .pl-faq-newsletter__trigger[aria-expanded="true"] .pl-faq-newsletter__icon {
    transform: rotate(180deg);
  }

  .pl-faq-newsletter__content[hidden] {
    display: none;
  }

  .pl-faq-newsletter__answer {
    padding: 0 1.6rem 1.6rem;
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--pl-text-muted, #5c5648);
  }

  @media screen and (min-width: 750px) {
    .pl-faq-newsletter__answer {
      padding: 0 2rem 2rem;
    }
  }

  .pl-faq-newsletter__newsletter {
    background: linear-gradient(135deg, rgba(31, 94, 86, 0.08), rgba(244, 217, 118, 0.08));
    border-radius: 1.6rem;
    padding: 2.4rem 1.6rem;
  }

  @media screen and (min-width: 750px) {
    .pl-faq-newsletter__newsletter {
      padding: 3.2rem 2.4rem;
    }
  }

  .pl-faq-newsletter__newsletter-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .pl-faq-newsletter__newsletter-heading {
    margin: 0 0 1rem;
    font-family: var(--font-fraunces, 'Fraunces', serif) !important;
    font-size: 1.8rem;
    font-weight: 400;
    color: var(--pl-near-black, #1a1a1a);
  }

  .pl-faq-newsletter__newsletter-description {
    margin: 0 0 1.6rem;
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--pl-text-muted, #5c5648);
  }

  .pl-faq-newsletter__form {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  @media screen and (min-width: 750px) {
    .pl-faq-newsletter__form {
      flex-wrap: nowrap;
    }
  }

  .pl-faq-newsletter__input {
    flex: 1 1 200px;
    padding: 12px 16px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    color: var(--pl-near-black, #1a1a1a);
  }

  .pl-faq-newsletter__input::placeholder {
    color: rgba(0, 0, 0, 0.4);
  }

  .pl-faq-newsletter__submit {
    flex: 1 1 140px;
    padding: 12px 24px;
    background: var(--pl-gold, #f4d976);
    color: var(--pl-near-black, #1a1a1a);
    border: none;
    border-radius: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .pl-faq-newsletter__submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(244, 217, 118, 0.4);
  }
</style>

<script>
  (function() {
    const triggers = document.querySelectorAll('.pl-faq-newsletter__trigger');
    triggers.forEach(trigger => {
      trigger.addEventListener('click', function() {
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        const panelId = this.getAttribute('aria-controls');
        const panel = document.getElementById(panelId);

        this.setAttribute('aria-expanded', !isExpanded);
        panel.hidden = isExpanded;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ + Newsletter",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "name": "FAQ Item",
      "type": "faq-item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your answer here.</p>"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Questions?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Newsletter Settings"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Stay updated with fresh spice tips"
    },
    {
      "type": "text",
      "id": "newsletter_description",
      "label": "Newsletter Description",
      "default": "Get recipes, sourcing stories, and spice guides delivered to your inbox."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "PureLeven FAQ + Newsletter"
    }
  ]
}
{% endschema %}
