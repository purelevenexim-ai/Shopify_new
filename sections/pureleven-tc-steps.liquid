{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{{ 'tc-campaign.css' | asset_url | stylesheet_tag }}

<section class="tcx-steps" id="{{ section.settings.anchor | default: 'how-to-brew' }}">
  <div class="tcx-steps__wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="tcx-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="tcx-h2">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.lede != blank -%}<p class="tcx-lede">{{ section.settings.lede | escape }}</p>{%- endif -%}
    <ol class="tcx-steps__list">
      {%- for block in section.blocks -%}
        <li class="tcx-step" {{ block.shopify_attributes }}>
          <span class="tcx-step__num" aria-hidden="true">{{ forloop.index }}</span>
          <div>
            <p class="tcx-step__title">{{ block.settings.title | escape }}</p>
            {%- if block.settings.text != blank -%}<p class="tcx-step__text">{{ block.settings.text | escape }}</p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.help != blank -%}<p class="tcx-steps__help">{{ section.settings.help }}</p>{%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <a class="tcx-steps__btn" href="{{ section.settings.button_link | default: '#cardamom-tea' }}">{{ section.settings.button_text | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brew steps",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "how-to-brew" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "03 / How to brew" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cardamom chai in 3 steps." },
    { "type": "text", "id": "lede", "label": "Intro" },
    { "type": "inline_richtext", "id": "help", "label": "Help line" },
    { "type": "text", "id": "button_text", "label": "Button text" },
    { "type": "text", "id": "button_link", "label": "Button link (anchor or URL)", "default": "#cardamom-tea" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text" } ] }
  ],
  "presets": [{ "name": "Brew steps" }]
}
{% endschema %}
