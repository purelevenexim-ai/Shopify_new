{{ 'pl-product.css' | asset_url | stylesheet_tag }}
{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tc-ajax-cart.js' | asset_url }}" defer></script>
{%- liquid
  assign source = product.collections.first
  unless source and source.products.size > 1
    assign source = collections.all
  endunless
  assign rec_products = source.products
-%}
{%- if rec_products.size > 1 -%}
<section class="pl-fbt">
  <div class="pl-fbt__inner">
    <div class="pl-fbt__head">
      <h2 class="pl-fbt__heading">{{ section.settings.heading | default: 'Customers Also Love' }}</h2>
      <div class="pl-fbt__nav">
        <button type="button" aria-label="Previous" data-fbt-prev>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" aria-label="Next" data-fbt-next>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>
    <div class="pl-fbt__track" data-fbt-track>
      {%- for item in rec_products limit: 8 -%}
        {%- unless item.id == product.id -%}
          {%- assign fv = item.selected_or_first_available_variant -%}
          <div class="pl-fbt__card">
            <a href="{{ item.url }}" class="pl-fbt__card-img-link">
              <img class="pl-fbt__card-img" src="{{ item.featured_image | image_url: width: 500 }}" alt="{{ item.featured_image.alt | escape }}" loading="lazy" width="500" height="500">
            </a>
            <div class="pl-fbt__card-body">
              <h3 class="pl-fbt__card-name"><a href="{{ item.url }}">{{ item.title | split: ' | ' | first }}</a></h3>
              <div class="pl-fbt__card-meta">
                <span class="pl-fbt__card-price" data-fbt-price>{{ fv.price | money_without_currency | remove: '.00' | prepend: '₹' }}</span>
                {%- if fv.compare_at_price > fv.price -%}
                  <span class="pl-fbt__card-compare" data-fbt-compare>{{ fv.compare_at_price | money_without_currency | remove: '.00' | prepend: '₹' }}</span>
                  {%- assign pct = fv.compare_at_price | minus: fv.price | times: 100 | divided_by: fv.compare_at_price -%}
                  <span class="pl-fbt__card-save-badge" data-fbt-save>{{ pct }}% off</span>
                {%- endif -%}
                <span class="pl-fbt__card-weight" data-fbt-weight>{{ fv.title }}</span>
              </div>
              {%- if item.description != blank -%}
                <p class="pl-fbt__card-desc">{{ item.description | strip_html | truncatewords: 14 }}</p>
              {%- endif -%}
              {%- if item.variants.size > 1 -%}
                <div class="pl-fbt__card-vars">
                  {%- for v in item.variants limit: 4 -%}
                    <button
                      type="button"
                      class="pl-fbt__card-var{% if forloop.first %} is-active{% endif %}"
                      data-vid="{{ v.id }}"
                      data-price="{{ v.price | money_without_currency | remove: '.00' | prepend: '₹' }}"
                      data-compare="{{ v.compare_at_price | money_without_currency | remove: '.00' | prepend: '₹' }}"
                      data-has-compare="{% if v.compare_at_price > v.price %}true{% else %}false{% endif %}"
                      data-save="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price }}{% endif %}"
                      data-weight="{{ v.title }}"
                      {% unless v.available %}disabled{% endunless %}
                    >{{ v.title }}</button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
            <form method="post" action="{{ routes.cart_add_url }}" class="pl-fbt__card-form tc-product-form">
              <input type="hidden" name="id" value="{{ fv.id }}" class="pl-fbt__vid">
              <button type="submit" name="add" class="pl-fbt__add-btn" {% unless item.available %}disabled{% endunless %}>
                {%- if item.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
              </button>
            </form>
          </div>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  /* Customers also love — same card as the rest of the store, px only. */
  #shopify-section-{{ section.id }} .pl-fbt { display: block; padding: 56px 0; background: var(--sk-bg) !important; border-top: 1px solid var(--sk-line); color: var(--sk-fg); font-family: var(--sk-sans); }
  #shopify-section-{{ section.id }} .pl-fbt * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .pl-fbt__inner { display: grid; gap: 20px; max-width: var(--sk-wrap) !important; margin: 0 auto; padding: 0 var(--sk-gutter) !important; }
  #shopify-section-{{ section.id }} .pl-fbt__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin: 0 !important; }
  #shopify-section-{{ section.id }} .pl-fbt__heading {
    margin: 0 !important; color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: clamp(28px, 3.2vw, 44px) !important;
    font-weight: 500 !important; line-height: 1.1 !important; letter-spacing: -0.045em !important; text-transform: none !important; text-align: left !important;
  }
  #shopify-section-{{ section.id }} .pl-fbt__heading::before { content: 'Pairs well'; display: block; margin-bottom: 14px; color: var(--sk-muted); font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; }
  #shopify-section-{{ section.id }} .pl-fbt__nav { display: flex; gap: 8px; }
  #shopify-section-{{ section.id }} .pl-fbt__nav button {
    display: grid; place-items: center; width: 40px; height: 40px; min-height: 0; margin: 0; padding: 0;
    background: var(--sk-card) !important; border: 1px solid var(--sk-line2) !important; border-radius: 2px !important; box-shadow: none !important; color: var(--sk-fg) !important; cursor: pointer;
  }
  #shopify-section-{{ section.id }} .pl-fbt__nav button:hover { border-color: var(--sk-fg) !important; }
  #shopify-section-{{ section.id }} .pl-fbt__nav svg { width: 16px; height: 16px; }
  #shopify-section-{{ section.id }} .pl-fbt__track {
    display: grid !important; grid-auto-flow: column; grid-auto-columns: 46%; gap: 12px !important; margin: 0 !important; padding: 0 0 4px !important;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
  }
  #shopify-section-{{ section.id }} .pl-fbt__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .pl-fbt__card {
    display: flex !important; flex-direction: column; min-width: 0; width: auto !important; margin: 0 !important; padding: 0 !important; overflow: hidden; scroll-snap-align: start;
    background: var(--sk-card) !important; border: 1px solid var(--sk-line) !important; border-radius: 3px !important; box-shadow: none !important;
  }
  #shopify-section-{{ section.id }} .pl-fbt__card-img-link { display: block; aspect-ratio: 1 / 1; overflow: hidden; background: var(--sk-bg2); border-bottom: 1px solid var(--sk-line); border-radius: 0 !important; }
  #shopify-section-{{ section.id }} .pl-fbt__card-img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 0 !important; }
  #shopify-section-{{ section.id }} .pl-fbt__card-body { display: flex; flex-direction: column; gap: 6px; flex: 1; padding: 12px !important; }
  #shopify-section-{{ section.id }} .pl-fbt__card-body > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .pl-fbt__card-name {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
    font-family: var(--sk-sans) !important; font-size: 15px !important; font-weight: 600 !important; line-height: 1.3 !important; letter-spacing: -0.01em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .pl-fbt__card-name a { color: var(--sk-fg) !important; text-decoration: none !important; font: inherit !important; }
  #shopify-section-{{ section.id }} .pl-fbt__card-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; }
  #shopify-section-{{ section.id }} .pl-fbt__card-price { color: var(--sk-fg) !important; font-size: 17px !important; font-weight: 600 !important; letter-spacing: -0.02em !important; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ section.id }} .pl-fbt__card-compare { color: var(--sk-faint) !important; font-size: 12px !important; text-decoration: line-through; }
  #shopify-section-{{ section.id }} .pl-fbt__card-save-badge { padding: 0 !important; background: none !important; border: 0 !important; color: var(--sk-acc) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; font-size: 10px !important; letter-spacing: 0.06em !important; font-weight: 700 !important; }
  #shopify-section-{{ section.id }} .pl-fbt__card-weight { flex-basis: 100%; color: var(--sk-muted) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; font-size: 10px !important; }
  #shopify-section-{{ section.id }} .pl-fbt__card-desc { display: none; }
  #shopify-section-{{ section.id }} .pl-fbt__card-vars {
    display: flex; flex-wrap: wrap; gap: 1px !important; margin-top: 2px !important;
    background: var(--sk-line2); border: 1px solid var(--sk-line2); border-radius: 2px; overflow: hidden;
  }
  #shopify-section-{{ section.id }} .pl-fbt__card-var {
    flex: 1 1 0; min-width: calc(33.333% - 1px); min-height: 34px; margin: 0 !important; padding: 4px !important; white-space: normal !important; overflow-wrap: anywhere; line-height: 1.25 !important;
    background: #fff !important; border: 0 !important; border-radius: 0 !important; box-shadow: none !important; color: var(--sk-fg) !important; cursor: pointer;
    font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; font-size: 10.5px !important; letter-spacing: 0.04em !important;
  }
  #shopify-section-{{ section.id }} .pl-fbt__card-var.is-active { background: var(--sk-acc-soft) !important; color: var(--sk-acc) !important; font-weight: 700 !important; box-shadow: inset 0 0 0 1px var(--sk-acc) !important; }
  #shopify-section-{{ section.id }} .pl-fbt__card-var:disabled { color: var(--sk-faint) !important; text-decoration: line-through; cursor: not-allowed; }
  #shopify-section-{{ section.id }} .pl-fbt__card-form { margin: 0 !important; padding: 0 12px 12px !important; }
  #shopify-section-{{ section.id }} .pl-fbt__add-btn {
    display: flex; align-items: center; justify-content: center; width: 100%; min-height: 44px; margin: 0 !important; padding: 10px 12px !important;
    background: var(--sk-yellow) !important; border: 1px solid var(--sk-yellow) !important; border-radius: 2px !important; box-shadow: none !important;
    color: var(--sk-on-yellow) !important; cursor: pointer; font-family: var(--sk-sans) !important; font-size: 13px !important; font-weight: 600 !important;
    letter-spacing: -0.01em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .pl-fbt__add-btn:hover:not(:disabled) { background: var(--sk-yellow-hover) !important; border-color: var(--sk-yellow-hover) !important; }
  #shopify-section-{{ section.id }} .pl-fbt__add-btn:disabled { background: var(--sk-bg2) !important; border-color: var(--sk-line) !important; color: var(--sk-faint) !important; cursor: not-allowed; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pl-fbt { padding: 80px 0; }
    #shopify-section-{{ section.id }} .pl-fbt__track { grid-auto-columns: calc((100% - 36px) / 4); gap: 12px !important; }
    #shopify-section-{{ section.id }} .pl-fbt__card-body { padding: 16px 18px !important; gap: 8px; }
    #shopify-section-{{ section.id }} .pl-fbt__card-desc { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; color: var(--sk-muted) !important; font-size: 14px !important; line-height: 1.5 !important; }
    #shopify-section-{{ section.id }} .pl-fbt__card-form { padding: 0 18px 18px !important; }
  }
#shopify-section-{{ section.id }} .pl-fbt__card-weight, #shopify-section-{{ section.id }} .pl-fbt__card-save-badge { font-size: 11px !important; }
</style>

<script>
(function () {
  var s = document.currentScript.previousElementSibling.previousElementSibling;
  if (!s || !s.classList.contains('pl-fbt')) return;
  var track = s.querySelector('[data-fbt-track]');
  if (!track) return;

  // Carousel nav
  var cardWidth = function () {
    var c = track.querySelector('.pl-fbt__card');
    return c ? c.offsetWidth + 20 : 320;
  };
  s.querySelector('[data-fbt-prev]').addEventListener('click', function () {
    track.scrollBy({ left: -cardWidth(), behavior: 'smooth' });
  });
  s.querySelector('[data-fbt-next]').addEventListener('click', function () {
    track.scrollBy({ left: cardWidth(), behavior: 'smooth' });
  });

  // Variant switching
  track.addEventListener('click', function (e) {
    var btn = e.target.closest('.pl-fbt__card-var');
    if (!btn || btn.disabled) return;
    var card = btn.closest('.pl-fbt__card');

    // Update active state
    card.querySelectorAll('.pl-fbt__card-var').forEach(function (b) { b.classList.remove('is-active'); });
    btn.classList.add('is-active');

    // Update hidden input
    card.querySelector('.pl-fbt__vid').value = btn.dataset.vid;

    // Update price
    card.querySelector('[data-fbt-price]').textContent = btn.dataset.price;

    // Update weight
    card.querySelector('[data-fbt-weight]').textContent = btn.dataset.weight;

    // Update compare/save
    var compareEl = card.querySelector('[data-fbt-compare]');
    var saveEl = card.querySelector('[data-fbt-save]');
    if (btn.dataset.hasCompare === 'true') {
      if (compareEl) compareEl.textContent = btn.dataset.compare;
      if (saveEl) saveEl.textContent = btn.dataset.save + '% off';
    } else {
      if (compareEl) compareEl.textContent = '';
      if (saveEl) saveEl.textContent = '';
    }
  });

})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Frequently bought",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customers Also Love"
    }
  ],
  "presets": [
    { "name": "Frequently bought" }
  ]
}
{% endschema %}
