{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{%- if product.description != blank -%}
{%- liquid
  assign desc_title = product.title | downcase
  assign desc_asset_image = blank
  assign desc_asset_alt = 'Close view of PureLeven spice'
  if section.settings.image == blank
    if product.handle contains 'black-pepper' or desc_title contains 'black pepper'
      assign desc_asset_image = 'pl-prod-black-pepper-closeup.webp'
      assign desc_asset_alt = 'Close view of whole Kerala black peppercorns'
    elsif product.handle contains 'kerala-white-pepper' or desc_title contains 'white pepper'
      assign desc_asset_image = 'pl-prod-white-pepper-closeup.webp'
      assign desc_asset_alt = 'Close view of whole white peppercorns'
    elsif product.handle contains 'premium-cassia-cinnamon' or desc_title contains 'cassia'
      assign desc_asset_image = 'pl-prod-cassia-closeup.webp'
      assign desc_asset_alt = 'Close view of cassia cinnamon sticks'
    elsif product.handle contains 'aromatic-true-cinnamon-ceylon' or desc_title contains 'ceylon'
      assign desc_asset_image = 'pl-prod-ceylon-closeup.webp'
      assign desc_asset_alt = 'Close view of Ceylon cinnamon sticks'
    elsif product.handle contains 'kerala-adimali-clove' or desc_title contains 'clove'
      assign desc_asset_image = 'pl-prod-clove-closeup.webp'
      assign desc_asset_alt = 'Close view of whole clove buds'
    elsif product.handle contains 'star-anise' or desc_title contains 'star anise'
      assign desc_asset_image = 'pl-prod-star-anise-process.webp'
      assign desc_asset_alt = 'Close view of whole star anise pods'
    elsif product.handle contains 'turmeric' or desc_title contains 'turmeric'
      assign desc_asset_image = 'pl-prod-turmeric-closeup.webp'
      assign desc_asset_alt = 'Close view of turmeric roots'
    endif
  endif
-%}
<section class="pl-desc-section">
  <div class="pl-desc-container{% if section.settings.image == blank and desc_asset_image == blank %} pl-desc-container--no-img{% endif %}">

    {%- if section.settings.image != blank -%}
    <div class="pl-desc-image-col">
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          alt="{{ section.settings.image.alt | default: product.title | escape }}"
          width="900"
          height="{{ 900 | divided_by: section.settings.image.aspect_ratio | round }}"
          loading="lazy"
          class="pl-desc-img"
        >
    </div>
    {%- elsif desc_asset_image != blank -%}
    <div class="pl-desc-image-col">
        <img
          src="{{ desc_asset_image | asset_url }}"
          alt="{{ desc_asset_alt | escape }}"
          width="1200"
          height="900"
          loading="lazy"
          class="pl-desc-img"
        >
    </div>
    {%- elsif request.design_mode -%}
    <div class="pl-desc-image-col">
        <div class="pl-desc-img-placeholder">
          <span>Add image in theme editor</span>
        </div>
    </div>
    {%- endif -%}

    <div class="pl-desc-text-col">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pl-desc-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pl-desc-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="pl-desc-body rte">{{ product.description }}</div>
      <button type="button" class="pl-desc-more" hidden>Read full description</button>
    </div>

  </div>
</section>
{%- endif -%}

<style>
  /* Product description — skillies language, px only. */
  #shopify-section-{{ section.id }} .pl-desc-section { display: block; padding: 56px 0; background: var(--sk-bg) !important; border-top: 1px solid var(--sk-line); color: var(--sk-fg); font-family: var(--sk-sans); }
  #shopify-section-{{ section.id }} .pl-desc-section * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .pl-desc-container { display: grid; gap: 24px; max-width: var(--sk-wrap); margin: 0 auto; padding: 0 var(--sk-gutter); }
  #shopify-section-{{ section.id }} .pl-desc-image-col { margin: 0; overflow: hidden; background: var(--sk-bg2); border: 1px solid var(--sk-line); border-radius: 3px; }
  #shopify-section-{{ section.id }} .pl-desc-img { display: block; width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0 !important; }
  #shopify-section-{{ section.id }} .pl-desc-img-placeholder { display: grid; place-items: center; aspect-ratio: 4 / 3; color: var(--sk-muted); font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; }
  #shopify-section-{{ section.id }} .pl-desc-text-col { display: grid; gap: 14px; align-content: start; min-width: 0; }
  #shopify-section-{{ section.id }} .pl-desc-text-col > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .pl-desc-eyebrow { color: var(--sk-muted) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; }
  #shopify-section-{{ section.id }} .pl-desc-heading {
    max-width: 20ch; color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: clamp(28px, 3.2vw, 44px) !important;
    font-weight: 500 !important; line-height: 1.1 !important; letter-spacing: -0.045em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .pl-desc-body, #shopify-section-{{ section.id }} .pl-desc-body p, #shopify-section-{{ section.id }} .pl-desc-body li {
    max-width: 68ch; color: var(--sk-fg2) !important; font-family: var(--sk-sans) !important; font-size: 16px !important; line-height: 1.7 !important; letter-spacing: 0 !important;
  }
  #shopify-section-{{ section.id }} .pl-desc-body > * + * { margin-top: 14px !important; }
  #shopify-section-{{ section.id }} .pl-desc-body h2, #shopify-section-{{ section.id }} .pl-desc-body h3, #shopify-section-{{ section.id }} .pl-desc-body h4 {
    margin: 24px 0 8px !important; color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: 19px !important; font-weight: 600 !important; line-height: 1.3 !important; letter-spacing: -0.02em !important;
  }
  #shopify-section-{{ section.id }} .pl-desc-body strong { color: var(--sk-fg); font-weight: 600; }
  #shopify-section-{{ section.id }} .pl-desc-body ul, #shopify-section-{{ section.id }} .pl-desc-body ol { padding-left: 20px !important; }
  #shopify-section-{{ section.id }} .pl-desc-body a { color: var(--sk-acc) !important; text-decoration: underline; text-underline-offset: 3px; }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .pl-desc-section { padding: 88px 0; }
    #shopify-section-{{ section.id }} .pl-desc-container { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 56px; align-items: start; }
    #shopify-section-{{ section.id }} .pl-desc-container--no-img { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .pl-desc-image-col { position: sticky; top: 110px; }
  }
  #shopify-section-{{ section.id }} .pl-desc-more {
    justify-self: start; margin: 0 !important; padding: 0 0 2px !important; background: none !important; border: 0 !important;
    border-bottom: 1px solid currentColor !important; border-radius: 0 !important; box-shadow: none !important; min-height: 0 !important;
    color: var(--sk-acc) !important; cursor: pointer; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .pl-desc-body.is-clamped {
      max-height: 240px; overflow: hidden;
      -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent 100%); mask-image: linear-gradient(180deg, #000 70%, transparent 100%);
    }
  }
</style>
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    var body = root && root.querySelector('.pl-desc-body');
    var more = root && root.querySelector('.pl-desc-more');
    if (!body || !more || !window.matchMedia('(max-width: 749px)').matches) return;
    body.classList.add('is-clamped');
    if (body.scrollHeight <= body.clientHeight + 24) { body.classList.remove('is-clamped'); return; }
    more.hidden = false;
    more.addEventListener('click', function () { body.classList.remove('is-clamped'); more.hidden = true; });
  })();
</script>

{% schema %}
{
  "name": "Product Description",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "placeholder": "e.g. About this spice"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (leave blank to use product title)"
    }
  ],
  "presets": [
    {
      "name": "Product Description"
    }
  ]
}
{% endschema %}
