{%- liquid
  assign pepper_title = product.title | downcase
  assign is_black_pepper_product = false
  if product.handle contains 'black-pepper' or pepper_title contains 'black pepper'
    assign is_black_pepper_product = true
  endif
-%}

{%- if is_black_pepper_product -%}
  <section class="pl-pepper-story" aria-labelledby="pl-pepper-story-title">
    <div class="pl-pepper-story__inner page-width">
      <div class="pl-pepper-story__header">
        <p class="pl-pepper-story__eyebrow">Kerala black pepper</p>
        <h2 id="pl-pepper-story-title" class="pl-pepper-story__title">
          Bold whole peppercorns with a warm bite and cleaner aroma.
        </h2>
        <p class="pl-pepper-story__lead">
          Whole pepper keeps more of its natural oils protected until grinding, giving everyday cooking a brighter finish than tired pre-ground pepper.
        </p>
      </div>

      <div class="pl-pepper-story__grid">
        <figure class="pl-pepper-story__hero">
          <img
            src="{{ 'pl-prod-black-pepper-hero.webp' | asset_url }}"
            alt="Pure Leven Spices & Tea Kerala black pepper whole peppercorns with product pouch"
            loading="lazy"
            width="1200"
            height="1200"
          >
          <figcaption>Whole peppercorns packed for strong kitchen aroma.</figcaption>
        </figure>

        <div class="pl-pepper-story__proof">
          <article class="pl-pepper-story__proof-card">
            <img
              src="{{ 'pl-prod-black-pepper-process.webp' | asset_url }}"
              alt="Whole black peppercorns drying after harvest"
              loading="lazy"
              width="1100"
              height="1100"
            >
            <div>
              <span>Quality cue</span>
              <h3>Sun-dried whole berries</h3>
              <p>Real drying and sorting visuals help shoppers see the ingredient before it becomes a kitchen pack.</p>
            </div>
          </article>

          <article class="pl-pepper-story__proof-card">
            <img
              src="{{ 'pl-prod-black-pepper-vine.webp' | asset_url }}"
              alt="Fresh black pepper vine growing in a Kerala spice garden"
              loading="lazy"
              width="1200"
              height="800"
            >
            <div>
              <span>Origin cue</span>
              <h3>Grown as pepper spikes</h3>
              <p>Real pepper begins on the vine, not in a supermarket shaker. Better sourcing helps the spice arrive with more character.</p>
            </div>
          </article>

          <article class="pl-pepper-story__proof-card pl-pepper-story__proof-card--video">
            <video
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster="{{ 'pl-prod-black-pepper-hero.webp' | asset_url }}"
              aria-label="Short product video of Kerala black pepper"
            >
              <source src="{{ 'pl-prod-black-pepper-video.mp4' | asset_url }}" type="video/mp4">
            </video>
            <div>
              <span>Up close</span>
              <h3>Dense, dark berries</h3>
              <p>Whole peppercorns with a sharp, piney aroma, packed before the oils fade.</p>
            </div>
          </article>
        </div>
      </div>

      <div class="pl-pepper-story__answers" aria-label="Kerala black pepper buying answers">
        <article>
          <span>Best for</span>
          <strong>Rasam, soups, eggs, marinades, stir-fries, pepper chicken, and finishing hot food.</strong>
        </article>
        <article>
          <span>How to use</span>
          <strong>Crush or grind near the end of cooking for a brighter, warmer pepper finish.</strong>
        </article>
        <article>
          <span>How to store</span>
          <strong>Keep sealed, dry, and away from sunlight so the natural oils stay protected.</strong>
        </article>
      </div>

      <div class="pl-pepper-story__source">
        <img
          src="{{ 'pl-prod-black-pepper-closeup.webp' | asset_url }}"
          alt="Fresh green pepper harvest being sorted in Kerala"
          loading="lazy"
          width="1400"
          height="900"
        >
        <div class="pl-pepper-story__source-copy">
          <p class="pl-pepper-story__eyebrow">Source transparency</p>
          <h3>From vine to kitchen, with less guesswork.</h3>
          <p>
            We buy close to the pepper gardens of Idukki and pack in small batches, so the pepper reaches your kitchen with its oils and heat intact.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Pure Leven Spices & Tea Kerala Black Pepper best used for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pure Leven Spices & Tea Kerala Black Pepper is best used for rasam, soups, eggs, marinades, pepper chicken, stir-fries, and finishing hot food where a warm pepper bite matters."
          }
        },
        {
          "@type": "Question",
          "name": "Why buy whole black peppercorns instead of pepper powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whole black peppercorns protect natural oils better than pre-ground pepper powder, so they release fresher aroma and flavor when crushed or ground before use."
          }
        },
        {
          "@type": "Question",
          "name": "How should black pepper be stored?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Store black pepper in an airtight container in a cool, dry place away from sunlight, heat, and moisture to preserve aroma."
          }
        }
      ]
    }
  </script>
{%- endif -%}

{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{%- style -%}
  /* Spice story — skillies language, px only. Styles sit on the inner section so empty renders leave no trace. */
  #shopify-section-{{ section.id }} .pl-pepper-story { display: block; padding: 56px 0; background: var(--sk-bg2) !important; border-top: 1px solid var(--sk-line); color: var(--sk-fg); font-family: var(--sk-sans); }
  #shopify-section-{{ section.id }} .pl-pepper-story * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .pl-pepper-story__inner { display: grid; gap: 28px; max-width: var(--sk-wrap) !important; margin: 0 auto; padding: 0 var(--sk-gutter) !important; }
  #shopify-section-{{ section.id }} .pl-pepper-story__header { display: grid; gap: 14px; }
  #shopify-section-{{ section.id }} .pl-pepper-story__header > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .pl-pepper-story__eyebrow { margin: 0 !important; color: var(--sk-muted) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; }
  #shopify-section-{{ section.id }} .pl-pepper-story__title {
    max-width: 20ch; margin: 0 !important; color: var(--sk-fg) !important; font-family: var(--sk-sans) !important;
    font-size: clamp(30px, 3.8vw, 56px) !important; font-weight: 500 !important; line-height: 1.08 !important; letter-spacing: -0.05em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .pl-pepper-story__lead { max-width: 58ch; color: var(--sk-muted) !important; font-size: 17px !important; line-height: 1.6 !important; letter-spacing: 0 !important; }

  #shopify-section-{{ section.id }} .pl-pepper-story__grid { display: grid; gap: 12px; }
  #shopify-section-{{ section.id }} .pl-pepper-story__hero, #shopify-section-{{ section.id }} .pl-pepper-story__video-card {
    position: relative; display: block; margin: 0; overflow: hidden;
    background: var(--sk-card) !important; border: 1px solid var(--sk-line) !important; border-radius: 3px !important; box-shadow: none !important;
  }
  #shopify-section-{{ section.id }} .pl-pepper-story__hero img, #shopify-section-{{ section.id }} .pl-pepper-story__video-card img, #shopify-section-{{ section.id }} .pl-pepper-story__video-card video { display: block; width: 100%; aspect-ratio: 1 / 1; height: auto; object-fit: cover; border-radius: 0 !important; }
  #shopify-section-{{ section.id }} .pl-pepper-story__hero figcaption, #shopify-section-{{ section.id }} .pl-pepper-story__video-card figcaption, #shopify-section-{{ section.id }} .pl-pepper-story__video-card > span {
    display: block; width: auto !important; max-width: none !important; margin: 0 !important; padding: 10px 14px !important;
    border: 0 !important; border-top: 1px solid var(--sk-line) !important; border-radius: 0 !important; box-shadow: none !important;
    background: var(--sk-card) !important; backdrop-filter: none !important; transform: none !important;
    color: var(--sk-muted) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; font-size: 10.5px !important; letter-spacing: 0.08em !important;
    position: static !important; inset: auto !important;
  }
  #shopify-section-{{ section.id }} .pl-pepper-story__proof { display: grid; gap: 12px; align-content: start; }
  #shopify-section-{{ section.id }} .pl-pepper-story__proof-card, #shopify-section-{{ section.id }} .pl-pepper-story__copy-card {
    display: grid; grid-template-columns: 104px minmax(0, 1fr); align-items: stretch; overflow: hidden; margin: 0;
    background: var(--sk-card) !important; border: 1px solid var(--sk-line) !important; border-radius: 3px !important; box-shadow: none !important;
  }
  #shopify-section-{{ section.id }} .pl-pepper-story__proof-card > img, #shopify-section-{{ section.id }} .pl-pepper-story__proof-card > video { display: block; width: 104px; height: 100%; min-height: 104px; object-fit: cover; border-right: 1px solid var(--sk-line); border-radius: 0 !important; }
  #shopify-section-{{ section.id }} .pl-pepper-story__proof-card > div, #shopify-section-{{ section.id }} .pl-pepper-story__copy-card { display: grid; gap: 4px; align-content: start; padding: 14px 16px; }
  #shopify-section-{{ section.id }} .pl-pepper-story__copy-card { grid-template-columns: 1fr; }
  #shopify-section-{{ section.id }} .pl-pepper-story__proof-card span, #shopify-section-{{ section.id }} .pl-pepper-story__copy-card span { color: var(--sk-acc) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; font-size: 10.5px !important; }
  #shopify-section-{{ section.id }} .pl-pepper-story__proof-card h3, #shopify-section-{{ section.id }} .pl-pepper-story__copy-card h3 { margin: 0 !important; color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: 17px !important; font-weight: 600 !important; line-height: 1.25 !important; letter-spacing: -0.02em !important; }
  #shopify-section-{{ section.id }} .pl-pepper-story__proof-card p, #shopify-section-{{ section.id }} .pl-pepper-story__copy-card p { margin: 0 !important; color: var(--sk-muted) !important; font-size: 14px !important; line-height: 1.5 !important; letter-spacing: 0 !important; }

  #shopify-section-{{ section.id }} .pl-pepper-story__answers { display: grid; margin: 0; background: var(--sk-card); border: 1px solid var(--sk-line); border-radius: 3px; overflow: hidden; }
  #shopify-section-{{ section.id }} .pl-pepper-story__answers article { display: grid; gap: 4px; padding: 14px 16px; margin: 0; background: none !important; border: 0 !important; border-radius: 0 !important; box-shadow: none !important; }
  #shopify-section-{{ section.id }} .pl-pepper-story__answers article + article { border-top: 1px solid var(--sk-line) !important; }
  #shopify-section-{{ section.id }} .pl-pepper-story__answers span { color: var(--sk-muted) !important; font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important; font-size: 10.5px !important; }
  #shopify-section-{{ section.id }} .pl-pepper-story__answers strong { color: var(--sk-fg) !important; font-size: 15px !important; font-weight: 500 !important; line-height: 1.45 !important; letter-spacing: -0.01em !important; }

  #shopify-section-{{ section.id }} .pl-pepper-story__source { display: grid; gap: 0; overflow: hidden; background: var(--sk-card); border: 1px solid var(--sk-line); border-radius: 3px; }
  #shopify-section-{{ section.id }} .pl-pepper-story__source > img { display: block; width: 100%; aspect-ratio: 16 / 10; height: auto; object-fit: cover; border-radius: 0 !important; border-bottom: 1px solid var(--sk-line); }
  #shopify-section-{{ section.id }} .pl-pepper-story__source-copy { display: grid; gap: 8px; align-content: center; padding: 20px 18px; }
  #shopify-section-{{ section.id }} .pl-pepper-story__source-copy > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .pl-pepper-story__source-copy h3 { color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: 24px !important; font-weight: 500 !important; line-height: 1.12 !important; letter-spacing: -0.035em !important; }
  #shopify-section-{{ section.id }} .pl-pepper-story__source-copy p:not(#shopify-section-{{ section.id }} .pl-pepper-story__eyebrow) { color: var(--sk-muted) !important; font-size: 15px !important; line-height: 1.6 !important; letter-spacing: 0 !important; }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pl-pepper-story { padding: 88px 0; }
    #shopify-section-{{ section.id }} .pl-pepper-story__inner { gap: 40px; }
    #shopify-section-{{ section.id }} .pl-pepper-story__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; align-items: start; }
    #shopify-section-{{ section.id }} .pl-pepper-story__answers { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #shopify-section-{{ section.id }} .pl-pepper-story__answers article + article { border-top: 0 !important; border-left: 1px solid var(--sk-line) !important; }
    #shopify-section-{{ section.id }} .pl-pepper-story__answers article { padding: 20px 22px; }
    #shopify-section-{{ section.id }} .pl-pepper-story__source { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
    #shopify-section-{{ section.id }} .pl-pepper-story__source > img { aspect-ratio: auto; height: 100%; min-height: 320px; border-bottom: 0; border-right: 1px solid var(--sk-line); }
    #shopify-section-{{ section.id }} .pl-pepper-story__source-copy { padding: 40px; }
    #shopify-section-{{ section.id }} .pl-pepper-story__source-copy h3 { font-size: 30px !important; }
  }
{%- endstyle -%}

