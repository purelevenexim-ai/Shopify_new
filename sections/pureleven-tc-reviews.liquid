{%- comment -%}
Tea & Coffee Reviews Section
- Tea-specific customer testimonials (not generic spice reviews)
- Rating badge + up to 3 review blocks
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'tc-design-tokens.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'tc-page.css' | asset_url }}">

<section class="tc-reviews">
  <div class="tc-reviews__container">
    <p class="tc-eyebrow"><i>05</i> / What Customers Say</p>
    {%- if section.settings.heading -%}
      <h2 class="tc-reviews__heading tc-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.show_rating and section.settings.rating_text -%}
      <p class="tc-reviews__rating">{{ section.settings.rating_text }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="tc-reviews__grid">
        {%- for block in section.blocks -%}
          <div class="tc-reviews__card" {{ block.shopify_attributes }}>
            <div class="tc-reviews__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.stars -%}★{%- else -%}☆{%- endif -%}
              {%- endfor -%}
            </div>
            <p class="tc-reviews__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <p class="tc-reviews__author">{{ block.settings.author }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "TC Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by tea drinkers"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating line",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "4.9 Google rating · 56 reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review text",
          "default": "The tea was really good, Cardamom Chai is my favourite."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Verified Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TC Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "The tea was really good, Cardamom Chai is my favourite.",
            "author": "Verified Customer"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "Ordered a third time now. Milk tea powder makes the best chai.",
            "author": "Repeat Customer"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "Packaging was excellent and delivery was fast.",
            "author": "Verified Customer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
