{{ 'pl-split-card.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign feat = section.settings.featured_product
-%}

{{ 'tc-design-tokens.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* "This week's pick" — skillies language, px only. ID scope beats the card/home globals. */
  #shopify-section-{{ section.id }} { background: var(--sk-bg2) !important; border-top: 1px solid var(--sk-line); color: var(--sk-fg); font-family: var(--sk-sans); }
  #shopify-section-{{ section.id }} .gradient { background: transparent !important; }
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .page-width { max-width: var(--sk-wrap); }
  #shopify-section-{{ section.id }} .plc-feature__label {
    display: block; margin: 0 0 16px !important; color: var(--sk-muted);
    font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important;
  }
  #shopify-section-{{ section.id }} .plc-feature__label::before { content: none; }
  #shopify-section-{{ section.id }} .plc-feature__heading {
    max-width: 18ch; margin: 0 0 24px !important; color: var(--sk-fg) !important;
    font-family: var(--sk-sans) !important; font-size: clamp(30px, 3.4vw, 48px) !important; font-weight: 500 !important;
    line-height: 1.08 !important; letter-spacing: -0.05em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .plc-feature__grid { display: grid; gap: 12px; align-items: stretch; }

  /* product panel */
  #shopify-section-{{ section.id }} .plc-slot { height: 100%; }
  #shopify-section-{{ section.id }} .plc {
    display: flex; flex-direction: column; height: 100%; margin: 0;
    background: var(--sk-card) !important; border: 1px solid var(--sk-line) !important; border-radius: 3px !important;
    box-shadow: none !important; overflow: hidden;
  }
  #shopify-section-{{ section.id }} .plc__shot {
    position: relative; display: block; aspect-ratio: 4 / 3; margin: 0; padding: 0;
    background: var(--sk-bg2); border-bottom: 1px solid var(--sk-line); border-radius: 0 !important; overflow: hidden;
  }
  #shopify-section-{{ section.id }} .plc__shot img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 0 !important; }
  #shopify-section-{{ section.id }} .plc__flag {
    position: absolute; top: 10px; left: 10px; padding: 5px 6px !important; margin: 0;
    background: #fff !important; border: 1px solid var(--sk-line) !important; border-radius: 2px !important; box-shadow: none !important;
    color: var(--sk-acc) !important; font: 700 10px/1 var(--sk-mono) !important; letter-spacing: 0.08em !important;
  }
  #shopify-section-{{ section.id }} .plc__body { display: flex; flex-direction: column; flex: 1; gap: 12px; padding: 18px !important; }
  #shopify-section-{{ section.id }} .plc__body > * { margin: 0 !important; }
  #shopify-section-{{ section.id }} .plc__kicker {
    display: block; color: var(--sk-acc) !important;
    font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.12em !important; text-transform: uppercase !important;
  }
  #shopify-section-{{ section.id }} .plc__title {
    font-family: var(--sk-sans) !important; font-size: 22px !important; font-weight: 600 !important;
    line-height: 1.2 !important; letter-spacing: -0.03em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .plc__title a { color: var(--sk-fg) !important; text-decoration: none !important; font: inherit !important; letter-spacing: inherit !important; }
  #shopify-section-{{ section.id }} .plc__title a:hover { color: var(--sk-acc) !important; }
  #shopify-section-{{ section.id }} .plc__note {
    display: -webkit-box !important; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden;
    color: var(--sk-muted) !important; font-family: var(--sk-sans) !important; font-size: 15px !important; line-height: 1.55 !important; letter-spacing: 0 !important;
  }
  #shopify-section-{{ section.id }} .plc__meta {
    display: grid !important; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 0;
    border-top: 1px solid var(--sk-line); border-bottom: 1px solid var(--sk-line);
  }
  #shopify-section-{{ section.id }} .plc__meta span {
    display: block !important; padding: 10px 12px 10px 0; color: var(--sk-muted) !important;
    font: 400 10px/1.4 var(--sk-mono) !important; letter-spacing: 0.1em !important; text-transform: uppercase !important;
  }
  #shopify-section-{{ section.id }} .plc__meta span + span { padding-left: 12px; border-left: 1px solid var(--sk-line); }
  #shopify-section-{{ section.id }} .plc__meta b {
    display: block; margin-top: 2px; color: var(--sk-fg) !important;
    font-family: var(--sk-sans) !important; font-size: 14px !important; font-weight: 600 !important; letter-spacing: -0.01em !important; text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .plc__form, #shopify-section-{{ section.id }} .plc__formel { width: 100%; margin-top: auto !important; }
  #shopify-section-{{ section.id }} .plc__buy { display: grid; gap: 12px; }
  #shopify-section-{{ section.id }} .plc__chips {
    position: relative; display: flex; flex-wrap: wrap; gap: 1px;
    background: var(--sk-line2); border: 1px solid var(--sk-line2); border-radius: 2px; overflow: hidden;
  }
  #shopify-section-{{ section.id }} .plc__chip {
    flex: 1 1 0; min-width: calc(33.333% - 1px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    min-height: 44px; margin: 0 !important; padding: 6px 4px !important;
    background: #fff !important; border: 0 !important; border-radius: 0 !important; box-shadow: none !important;
    color: var(--sk-fg) !important; text-align: center; cursor: pointer;
    font: 400 11px/1.25 var(--sk-mono) !important; letter-spacing: 0.04em !important; text-transform: uppercase !important;
    transition: background-color 0.2s, color 0.2s;
  }
  #shopify-section-{{ section.id }} .plc__chip:hover { background: var(--sk-bg2) !important; }
  #shopify-section-{{ section.id }} .plc__chip-off { display: block; color: var(--sk-acc); font: 400 10px/1.2 var(--sk-mono); opacity: 1; }
  #shopify-section-{{ section.id }} .plc__radio:checked + .plc__chip {
    background: var(--sk-acc-soft) !important; color: var(--sk-acc) !important; font-weight: 700 !important; box-shadow: inset 0 0 0 1px var(--sk-acc) !important;
  }
  #shopify-section-{{ section.id }} .plc__chip--out { color: var(--sk-faint) !important; text-decoration: line-through; cursor: not-allowed; }
  #shopify-section-{{ section.id }} .plc__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }
  #shopify-section-{{ section.id }} .plc__now {
    color: var(--sk-fg) !important; font-family: var(--sk-sans) !important; font-size: 24px !important; font-weight: 600 !important;
    line-height: 1.1 !important; letter-spacing: -0.03em !important; font-variant-numeric: tabular-nums;
  }
  #shopify-section-{{ section.id }} .plc__was { color: var(--sk-faint) !important; font-size: 13px !important; font-weight: 400 !important; text-decoration: line-through; }
  #shopify-section-{{ section.id }} .plc__delivery {
    margin: 0 !important; color: var(--sk-acc) !important;
    font: 400 11px/1.5 var(--sk-mono) !important; letter-spacing: 0.1em !important; text-transform: uppercase !important;
  }
  #shopify-section-{{ section.id }} .plc__delivery::before { content: none !important; }
  #shopify-section-{{ section.id }} .plc__cta {
    display: flex; align-items: center; justify-content: center; width: 100%; min-height: 48px; margin: 0 !important; padding: 12px !important;
    background: var(--sk-yellow) !important; border: 1px solid var(--sk-yellow) !important; border-radius: 2px !important; box-shadow: none !important;
    color: var(--sk-on-yellow) !important; font-family: var(--sk-sans) !important; font-size: 13px !important; font-weight: 600 !important;
    line-height: 1.2 !important; letter-spacing: -0.01em !important; text-transform: none !important;
    transition: background-color 0.2s, border-color 0.2s, transform 0.25s var(--sk-ease);
  }
  #shopify-section-{{ section.id }} .plc__cta:hover:not([disabled]) { background: var(--sk-yellow-hover) !important; border-color: var(--sk-yellow-hover) !important; transform: translateY(-1px); }
  #shopify-section-{{ section.id }} .plc__cta::after, #shopify-section-{{ section.id }} .plc__cta::before { content: none !important; }

  /* reviews panel */
  #shopify-section-{{ section.id }} .plc-reviews {
    display: flex; flex-direction: column; gap: 0; padding: 0;
    background: var(--sk-card); border: 1px solid var(--sk-line); border-radius: 3px; overflow: hidden;
  }
  #shopify-section-{{ section.id }} .plc-reviews__head {
    display: flex; align-items: center; gap: 12px; padding: 16px 18px; background: var(--sk-bg); border-bottom: 1px solid var(--sk-line);
  }
  #shopify-section-{{ section.id }} .plc-reviews__score { color: var(--sk-fg); font-size: 32px; font-weight: 600; line-height: 1; letter-spacing: -0.04em; }
  #shopify-section-{{ section.id }} .plc-reviews__stars { color: var(--sk-acc); font-size: 13px; letter-spacing: 1px; line-height: 1.2; }
  #shopify-section-{{ section.id }} .plc-reviews__count { color: var(--sk-muted); font: 400 10.5px/1.5 var(--sk-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .plc-review { display: flex; gap: 12px; padding: 14px 18px; }
  #shopify-section-{{ section.id }} .plc-review + .plc-review { border-top: 1px solid var(--sk-line); }
  #shopify-section-{{ section.id }} .plc-review__av { flex: 0 0 32px; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--sk-line); object-fit: cover; background: var(--sk-bg2); }
  #shopify-section-{{ section.id }} .plc-review__b { min-width: 0; }
  #shopify-section-{{ section.id }} .plc-review__name {
    margin: 0 0 2px !important; color: var(--sk-fg); font-family: var(--sk-sans) !important; font-size: 14px !important; font-weight: 600 !important; letter-spacing: -0.01em !important;
  }
  #shopify-section-{{ section.id }} .plc-review__txt {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; margin: 0 !important;
    color: var(--sk-fg2); font-family: var(--sk-sans) !important; font-size: 14px !important; line-height: 1.55 !important; letter-spacing: 0 !important;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .plc-feature__grid { gap: 16px; }
    #shopify-section-{{ section.id }} .plc { flex-direction: row; }
    #shopify-section-{{ section.id }} .plc__shot { flex: 0 0 42%; aspect-ratio: auto; border-bottom: 0; border-right: 1px solid var(--sk-line); }
    #shopify-section-{{ section.id }} .plc__shot img { position: absolute; inset: 0; }
    #shopify-section-{{ section.id }} .plc__body { gap: 14px; padding: 28px !important; }
    #shopify-section-{{ section.id }} .plc__title { font-size: 28px !important; font-weight: 500 !important; }
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .plc-feature__grid { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 20px; }
  }
{%- endstyle -%}

{%- if feat != blank -%}
  <div class="color-{{ section.settings.color_scheme }} isolate gradient">
    <div class="section-{{ section.id }}-padding">
      <div class="page-width">
        {%- if section.settings.label != blank -%}
          <p class="plc-feature__label">{{ section.settings.label }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="plc-feature__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        <div class="plc-feature__grid">
          {%- capture feat_stats -%}
            {%- if section.settings.stat1_label != blank -%}
              <span>{{ section.settings.stat1_label }}<b>{{ section.settings.stat1_value }}</b></span>
            {%- endif -%}
            {%- if section.settings.stat2_label != blank -%}
              <span>{{ section.settings.stat2_label }}<b>{{ section.settings.stat2_value }}</b></span>
            {%- endif -%}
            {%- if section.settings.stat3_label != blank -%}
              <span class="plc__meta--3">{{ section.settings.stat3_label }}<b>{{ section.settings.stat3_value }}</b></span>
            {%- endif -%}
          {%- endcapture -%}

          {%- render 'pl-split-card',
            card_product: feat,
            sec_id: section.id,
            pl_featured: true,
            pl_kicker: section.settings.kicker,
            pl_note: section.settings.note,
            pl_stats: feat_stats,
            pl_delivery_note: section.settings.delivery_note
          -%}

          {%- if section.settings.show_reviews -%}
            <aside class="plc-reviews">
              <div class="plc-reviews__head">
                <span class="plc-reviews__score">{{ section.settings.reviews_score }}</span>
                <span>
                  <span class="plc-reviews__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><br>
                  <span class="plc-reviews__count">{{ section.settings.reviews_count }}</span>
                </span>
              </div>
              {%- liquid
                comment
                  Fallbacks are applied here rather than via schema defaults: once a
                  section instance stores an empty string, Liquid treats it as set and
                  the schema default never applies. The theme editor writes empty
                  strings on save, which blanks the panel. Typed values still win.
                endcomment
                assign d1n = 'Abu George'
                assign d1t = 'I purchased 3 in 1 combo pack online. All the items are very good quality. Thank you Pure Leven team.'
                assign d1a = 'https://lh3.googleusercontent.com/a-/ALV-UjXwkW7qXRIi1i_fzWnvRirAM5daQ3ly0_sm0YW2HvqqT1P0iJs=w120-h120-p-rp-mo-br100'
                assign d2n = 'Amal P'
                assign d2t = 'The tea is amazing! Personal favourite is the Cardamom Chai. The packaging is top notch and the delivery was quick.'
                assign d2a = 'https://lh3.googleusercontent.com/a/ACg8ocKs-CaXGC5edM8qEJJkJr9QLz34JWGjAge55k8pyyEjHMTcN6E=w120-h120-p-rp-mo-ba12-br100'
                assign d3n = 'Md. Kalim'
                assign d3t = 'Quality is very good and quick delivery, same quality for each and every dispatch. I am a regular buyer.'
                assign d3a = 'https://lh3.googleusercontent.com/a-/ALV-UjU2WcwEPcuMqjP3dgrS9vEFN3Lww90xxxLoCE-nLCEFY_g2EcowyA=w120-h120-p-rp-mo-ba12-br100'
              -%}
              {%- for i in (1..3) -%}
                {%- liquid
                  case i
                    when 1
                      assign rn = section.settings.r1_name | default: d1n
                      assign rt = section.settings.r1_text | default: d1t
                      assign ra = section.settings.r1_avatar | default: d1a
                    when 2
                      assign rn = section.settings.r2_name | default: d2n
                      assign rt = section.settings.r2_text | default: d2t
                      assign ra = section.settings.r2_avatar | default: d2a
                    when 3
                      assign rn = section.settings.r3_name | default: d3n
                      assign rt = section.settings.r3_text | default: d3t
                      assign ra = section.settings.r3_avatar | default: d3a
                  endcase
                -%}
                {%- if rn != blank -%}
                  <div class="plc-review">
                    {%- if ra != blank -%}
                      {%- capture pl_av -%}{% render 'pl-avatar-url', url: ra, px: 64 %}{%- endcapture -%}
                      <img class="plc-review__av" src="{{ pl_av | strip }}" alt="" loading="lazy" decoding="async" width="32" height="32">
                    {%- else -%}
                      <span class="plc-review__av"></span>
                    {%- endif -%}
                    <div class="plc-review__b">
                      <p class="plc-review__name">{{ rn }}</p>
                      <p class="plc-review__txt">{{ rt }}</p>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </aside>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Featured Product Strip",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "product", "id": "featured_product", "label": "Featured product" },
    { "type": "text", "id": "label", "label": "Strip label", "default": "This week's pick" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "kicker", "label": "Kicker", "info": "Falls back to the product's Origin metafield." },
    { "type": "textarea", "id": "note", "label": "Short note", "info": "Falls back to the product's short_description metafield." },
    {
      "type": "text", "id": "delivery_note", "label": "Delivery note",
      "info": "Shown under the price. Must match your real shipping rates or it will contradict checkout.",
      "default": "₹40/kg delivery charge"
    },

    { "type": "header", "content": "Stat strip" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "info": "Leave all blank to use the product's own brew / servings / cost-per-cup." },
    { "type": "text", "id": "stat1_value", "label": "Stat 1 value" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label" },
    { "type": "text", "id": "stat2_value", "label": "Stat 2 value" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label" },
    { "type": "text", "id": "stat3_value", "label": "Stat 3 value" },

    { "type": "header", "content": "Reviews" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews", "default": true },
    { "type": "text", "id": "reviews_score", "label": "Score", "default": "4.9" },
    { "type": "text", "id": "reviews_count", "label": "Count text", "default": "56 Google reviews" },
    { "type": "text", "id": "r1_name", "label": "Review 1 — name", "default": "Abu George" },
    { "type": "textarea", "id": "r1_text", "label": "Review 1 — text", "default": "I purchased 3 in 1 combo pack online. All the items are very good quality. Thank you Pure Leven team." },
    { "type": "text", "id": "r1_avatar", "label": "Review 1 — avatar URL", "default": "https://lh3.googleusercontent.com/a-/ALV-UjXwkW7qXRIi1i_fzWnvRirAM5daQ3ly0_sm0YW2HvqqT1P0iJs=w120-h120-p-rp-mo-br100" },
    { "type": "text", "id": "r2_name", "label": "Review 2 — name", "default": "Amal P" },
    { "type": "textarea", "id": "r2_text", "label": "Review 2 — text", "default": "The tea is amazing! Personal favourite is the Cardamom Chai. The packaging is top notch and the delivery was quick." },
    { "type": "text", "id": "r2_avatar", "label": "Review 2 — avatar URL", "default": "https://lh3.googleusercontent.com/a/ACg8ocKs-CaXGC5edM8qEJJkJr9QLz34JWGjAge55k8pyyEjHMTcN6E=w120-h120-p-rp-mo-ba12-br100" },
    { "type": "text", "id": "r3_name", "label": "Review 3 — name", "default": "Md. Kalim" },
    { "type": "textarea", "id": "r3_text", "label": "Review 3 — text", "default": "Quality is very good and quick delivery, same quality for each and every dispatch. I am a regular buyer." },
    { "type": "text", "id": "r3_avatar", "label": "Review 3 — avatar URL", "default": "https://lh3.googleusercontent.com/a-/ALV-UjU2WcwEPcuMqjP3dgrS9vEFN3Lww90xxxLoCE-nLCEFY_g2EcowyA=w120-h120-p-rp-mo-ba12-br100" },

    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 8 }
  ],
  "presets": [{ "name": "Featured Product Strip" }]
}
{% endschema %}
