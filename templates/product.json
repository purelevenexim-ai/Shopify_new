antee .pl-quality-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 !important; width: 100%; background: #fff; border: 1px solid #DEDEDB; border-radius: 3px; overflow: hidden; }\n  #pl-quality-guarantee .pl-quality-item { display: flex; align-items: flex-start; gap: 10px; margin: 0 !important; padding: 14px !important; background: none !important; border: 0 !important; border-radius: 0 !important; box-shadow: none !important; }\n  #pl-quality-guarantee .pl-quality-item:nth-child(even) { border-left: 1px solid #DEDEDB !important; }\n  #pl-quality-guarantee .pl-quality-item:nth-child(n+3) { border-top: 1px solid #DEDEDB !important; }\n  #pl-quality-guarantee .pl-quality-icon {\n    display: grid; place-items: center; flex: none; width: 28px; height: 28px; margin: 0 !important;\n    background: #EAF2EE !important; border: 0 !important; border-radius: 2px !important; color: #1F6B5C !important; box-shadow: none !important;\n  }\n  #pl-quality-guarantee .pl-quality-icon svg { width: 15px; height: 15px; }\n  #pl-quality-guarantee .pl-quality-item-text { color: #3D4250 !important; font-size: 13.5px !important; line-height: 1.45 !important; font-weight: 500 !important; letter-spacing: 0 !important; }\n  #pl-quality-guarantee .pl-quality-btn {\n    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 14px 24px 14px 26px !important;\n    background: #17191A !important; border: 1px solid #17191A !important; border-radius: 2px !important; box-shadow: none !important;\n    color: #fff !important; text-decoration: none !important; font-size: 13px !important; font-weight: 600 !important; letter-spacing: -0.01em !important; text-transform: none !important;\n    transition: background-color 0.2s, transform 0.25s cubic-bezier(0.2, 0.65, 0.2, 1);\n  }\n  #pl-quality-guarantee .pl-quality-btn:hover { background: #004438 !important; border-color: #004438 !important; transform: translateY(-1px); }\n  #pl-quality-guarantee .pl-qualit