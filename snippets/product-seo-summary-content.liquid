{%- assign summary = '' -%}
{%- assign highlight_1 = '' -%}
{%- assign highlight_2 = '' -%}
{%- assign highlight_3 = '' -%}
{%- assign highlight_4 = '' -%}
{%- assign primary_cta_url = '/collections/all' -%}
{%- assign primary_cta_label = 'Explore Kerala Spices' -%}
{%- assign secondary_cta_url = '/blogs/cooking-spices' -%}
{%- assign secondary_cta_label = 'Read Spice Journal' -%}
{%- assign note = 'From Kerala soil to your kitchen.' -%}

{%- comment -%}
  Beverages are matched first and returned early. Several of their handles collide
  with the spice rules below — 'deluxe-combo-pack-tea-coffee-honey' contains
  'combo-pack', and 'cardamom-tea' contains 'cardamom' — so without this branch
  they inherit spice copy.
{%- endcomment -%}
{%- assign bev_handles = 'premium-milk-tea-powder,premium-black-tea-granules,orange-pekoe-powder,cardamom-tea,naadan-kerala-coffee,naadan-pure-honey,starter-trial-pack-4-varieties,deluxe-combo-pack-tea-coffee-honey' | split: ',' -%}
{%- assign is_beverage = false -%}
{%- for h in bev_handles -%}
  {%- if product_handle == h -%}{%- assign is_beverage = true -%}{%- endif -%}
{%- endfor -%}

{%- if is_beverage -%}
  {%- assign primary_cta_url = '/collections/tea-coffee' -%}
  {%- assign primary_cta_label = 'Explore Tea & Coffee' -%}
  {%- assign secondary_cta_url = '/collections/all' -%}
  {%- assign secondary_cta_label = 'Shop All Products' -%}
  {%- assign note = 'Direct from Idukki and Adimali estates, packed to order.' -%}

  {%- case product_handle -%}
    {%- when 'premium-milk-tea-powder' -%}
      {%- assign summary = 'A fine-milled black tea powder from Idukki. The fine grind releases colour and strength quickly, which is what lets it stand up to milk — the everyday chai tea for Kerala households.' -%}
      {%- assign highlight_1 = 'Fine powder, not granule' -%}
      {%- assign highlight_2 = 'Built for milk, not for black' -%}
      {%- assign highlight_3 = 'Idukki high-range estates' -%}
      {%- assign highlight_4 = 'About ₹3 a cup' -%}
      {%- assign note = 'Boil milk and water together, add the powder at half boil, then rest 30 seconds.' -%}
    {%- when 'premium-black-tea-granules' -%}
      {%- assign summary = 'Broken Orange Pekoe (BOP) grade black tea — smaller broken leaf that infuses quickly and gives a bright, full-bodied cup without turning tannic.' -%}
      {%- assign highlight_1 = 'BOP export grade' -%}
      {%- assign highlight_2 = 'Bright, clean, no bitterness' -%}
      {%- assign highlight_3 = 'Drinks black or with milk' -%}
      {%- assign highlight_4 = 'Lab-tested for pesticides' -%}
      {%- assign note = 'A step up from CTC dust if you want clarity in the cup as well as strength.' -%}
    {%- when 'orange-pekoe-powder' -%}
      {%- assign summary = 'Orange Pekoe is a leaf-size grade, not a flavour — younger leaf with more essential oil, giving a refined, floral cup best drunk without milk.' -%}
      {%- assign highlight_1 = 'Whole-leaf grade' -%}
      {%- assign highlight_2 = 'Floral, low tannin' -%}
      {%- assign highlight_3 = 'Best served black' -%}
      {%- assign highlight_4 = 'Lemon or honey, never milk' -%}
      {%- assign note = 'Milk masks the florals this grade is bought for.' -%}
    {%- when 'cardamom-tea' -%}
      {%- assign summary = 'Idukki black tea blended with whole green cardamom pods rather than flavouring — a ready-to-steep spiced chai that needs no separate masala.' -%}
      {%- assign highlight_1 = 'Whole pods, no synthetic flavour' -%}
      {%- assign highlight_2 = 'One-step spiced chai' -%}
      {%- assign highlight_3 = 'Cardamom from our own gardens' -%}
      {%- assign highlight_4 = 'Traditional digestive pairing' -%}
      {%- assign note = 'Cardamom-flavoured teas use oils; this one uses the pod.' -%}
    {%- when 'naadan-kerala-coffee' -%}
      {%- assign summary = 'Medium-roast Kerala Robusta, ground fine for South Indian filter. Roughly twice the caffeine of Arabica and a heavier body — which is what survives being cut with hot milk.' -%}
      {%- assign highlight_1 = 'Robusta, filter grind' -%}
      {%- assign highlight_2 = 'Grown at 1,200–1,600 m' -%}
      {%- assign highlight_3 = 'No chicory, unblended' -%}
      {%- assign highlight_4 = 'Roasted in small batches' -%}
      {%- assign note = 'Most Indian filter blends carry 20–30% chicory. This does not.' -%}
    {%- when 'naadan-pure-honey' -%}
      {%- assign summary = 'Raw wildflower forest honey from Adimali, cold-extracted and unfiltered — so it keeps its pollen and enzymes, and crystallises the way real honey should.' -%}
      {%- assign highlight_1 = 'Never heated above 40°C' -%}
      {%- assign highlight_2 = 'Unfiltered, pollen intact' -%}
      {%- assign highlight_3 = 'Crystallises naturally' -%}
      {%- assign highlight_4 = 'Single yearly harvest' -%}
      {%- assign note = 'Honey that never sets has usually been pasteurised or cut with syrup.' -%}
    {%- when 'starter-trial-pack-4-varieties' -%}
      {%- assign summary = 'Four PureLeven teas and coffees in one box, sized so you can brew each properly for a week before committing to a full pack.' -%}
      {%- assign highlight_1 = '4 varieties, one box' -%}
      {%- assign highlight_2 = 'Try before the full pack' -%}
      {%- assign highlight_3 = 'One delivery charge' -%}
      {%- assign highlight_4 = 'Gift-friendly' -%}
      {%- assign note = 'The cheapest way to find which one you actually reach for.' -%}
    {%- when 'deluxe-combo-pack-tea-coffee-honey' -%}
      {%- assign summary = 'The full PureLeven beverage shelf — every tea and coffee we make plus a jar of raw forest honey, shipped as one box from Idukki and Adimali.' -%}
      {%- assign highlight_1 = '5 items, ships as one box' -%}
      {%- assign highlight_2 = 'Tea, coffee and raw honey' -%}
      {%- assign highlight_3 = 'Honey pairs with every cup' -%}
      {%- assign highlight_4 = 'Single delivery charge' -%}
      {%- assign note = 'Raw honey is the natural sweetener for each brew in this box.' -%}
  {%- endcase -%}

{%- elsif product_handle contains 'combo-pack' -%}
  {%- assign primary_cta_label = 'Explore Best Sellers' -%}
  {%- if product_handle contains '50g-black-pepper-100g-clove-100g' or product_handle == 'kerala-spice-combo-pack' -%}
    {%- assign summary = 'A starter Kerala spice combo that bundles cardamom, black pepper, and clove into one purchase for gifting, first-time buyers, and everyday kitchen setup.' -%}
    {%- assign highlight_1 = '3 core spices in one' -%}
    {%- assign highlight_2 = 'Starter / gifting use case' -%}
    {%- assign highlight_3 = 'Kerala spice identity' -%}
    {%- assign highlight_4 = 'Lower decision friction' -%}
    {%- assign note = 'Ideal when you want a cleaner kitchen starting point instead of comparing multiple separate spice listings.' -%}
  {%- else -%}
    {%- assign summary = 'A larger Kerala spice combo built for families and frequent cooks who want cardamom, black pepper, and clove together in a more kitchen-friendly bundle.' -%}
    {%- assign highlight_1 = 'Larger bundled quantity' -%}
    {%- assign highlight_2 = 'Family kitchen use' -%}
    {%- assign highlight_3 = '3 essential spices together' -%}
    {%- assign highlight_4 = 'Better refill value' -%}
    {%- assign note = 'Best when these core spices already move quickly in the kitchen and convenience matters.' -%}
  {%- endif -%}
  {%- elsif product_handle contains 'cardamom' -%}
  {%- assign primary_cta_label = 'Explore Cardamom Range' -%}
  {%- if product_handle contains '50gm' -%}
    {%- assign summary = 'This compact Kerala cardamom (elaichi) pack is for buyers who want fragrant whole pods, faster kitchen turnover, and a lower-commitment way to keep chai, sweets, and daily cooking aromatic.' -%}
    {%- assign highlight_1 = 'Whole cardamom pods' -%}
    {%- assign highlight_2 = 'Low kitchen-stock commitment' -%}
    {%- assign highlight_3 = 'Great for chai and sweets' -%}
    {%- assign highlight_4 = 'Trial-friendly size' -%}
    {%- assign note = 'Smaller pack, stronger turnover, fresher pod experience.' -%}
  {%- elsif product_handle contains '8mm-fruit-100gm' or product_handle == 'kerala-cardamom' -%}
    {%- assign summary = 'A daily-use Kerala cardamom (elaichi) pack with 8mm whole-pod positioning, designed for home kitchens that want bright aroma, cleaner storage cycles, and reliable use in chai, desserts, and savory cooking.' -%}
    {%- assign highlight_1 = '8mm whole pods' -%}
    {%- assign highlight_2 = 'Daily-use pack size' -%}
    {%- assign highlight_3 = 'Kerala source story' -%}
    {%- assign highlight_4 = 'Cardamom + elaichi relevance' -%}
    {%- assign note = 'Best when you want regular cardamom / elaichi use without carrying too much stock.' -%}
  {%- elsif product_handle contains '8mm-200gm' or product_handle == 'kerala-cardamom' -%}
    {%- assign summary = 'Kerala cardamom (elaichi) in a larger 8mm refill pack for households that want bigger whole pods, stronger aroma release, and enough volume for repeat chai, dessert, and masala use.' -%}
    {%- assign highlight_1 = '8mm whole pods' -%}
    {%- assign highlight_2 = 'Higher-aroma profile' -%}
    {%- assign highlight_3 = 'Built for repeat use' -%}
    {%- assign highlight_4 = 'Kerala high-range positioning' -%}
    {%- assign note = 'A stronger fit for kitchens that open cardamom often, not just occasionally.' -%}
  {%- elsif product_handle contains '500gm' -%}
    {%- assign summary = 'This larger Kerala cardamom refill pack is for kitchens that already know how quickly good cardamom disappears and want kitchen scale without stepping down to flatter commodity stock.' -%}
    {%- assign highlight_1 = 'Refill-led pack' -%}
    {%- assign highlight_2 = 'Kerala cardamom identity' -%}
    {%- assign highlight_3 = 'Whole-pod freshness logic' -%}
    {%- assign highlight_4 = 'Heavy-use households' -%}
    {%- assign note = 'Best for repeat chai drinkers and larger households that use cardamom as a real staple.' -%}
  {%- endif -%}
{%- elsif product_handle contains 'black-pepper' -%}
  {%- assign primary_cta_label = 'Explore Pepper Range' -%}
  {%- if product_handle contains '100gm' -%}
    {%- assign summary = 'This compact Kerala black pepper pack is built for first grinder refills and lighter-use kitchens that want whole peppercorn aroma without leaving a larger pouch open for too long.' -%}
    {%- assign highlight_1 = 'Whole peppercorns' -%}
    {%- assign highlight_2 = 'First grinder refill' -%}
    {%- assign highlight_3 = 'Fresh-crack flavor' -%}
    {%- assign highlight_4 = 'Low-commitment pack' -%}
    {%- assign note = 'Smaller pouch, same whole-pepper advantage, better for slower-use kitchens.' -%}
  {%- elsif product_handle contains '200gm' -%}
    {%- assign summary = 'Whole Kerala black pepper designed for daily seasoning and fresh grinding, with better aroma retention than pre-ground pepper and enough volume for steady kitchen use.' -%}
    {%- assign highlight_1 = 'Whole peppercorn format' -%}
    {%- assign highlight_2 = 'Daily seasoning sweet spot' -%}
    {%- assign highlight_3 = 'Fresh-grind use case' -%}
    {%- assign highlight_4 = 'Kerala provenance' -%}
    {%- assign note = 'This is the everyday pepper pack for cooks who want the grinder doing the real work.' -%}
  {%- elsif product_handle contains '300gm' or product_handle == 'kerala-black-pepper' -%}
    {%- assign summary = 'A larger Kerala black pepper offer pack for families and repeat cooks who want whole-pepper freshness, better refill value, and a more kitchen-friendly volume.' -%}
    {%- assign highlight_1 = 'Larger value pack' -%}
    {%- assign highlight_2 = 'Whole peppercorn format' -%}
    {%- assign highlight_3 = 'Refill-ready kitchen use' -%}
    {%- assign highlight_4 = 'Stronger value per use' -%}
    {%- assign note = 'Best when pepper disappears quickly in your kitchen and smaller packs slow you down.' -%}
  {%- elsif product_handle contains '500gm' -%}
    {%- assign summary = 'This larger Kerala black pepper pack is for heavier-use kitchens that want bulk refill convenience while still preserving the whole-pepper aroma advantage.' -%}
    {%- assign highlight_1 = 'Bulk refill size' -%}
    {%- assign highlight_2 = 'Whole pepper freshness' -%}
    {%- assign highlight_3 = 'High-use kitchen fit' -%}
    {%- assign highlight_4 = 'Grinder-led cooking' -%}
    {%- assign note = 'Made for kitchens that use pepper constantly and want refill scale without switching to flat ground pepper.' -%}
  {%- endif -%}
{%- elsif product_handle contains 'clove' -%}
  {%- assign primary_cta_label = 'Explore Whole Spices' -%}
  {%- if product_handle contains '100gm' -%}
    {%- assign summary = 'Kerala Adimali clove in a smaller whole-bud pack, suited to chai, rice dishes, and masala blends where visible quality and strong aroma matter more than bulk volume.' -%}
    {%- assign highlight_1 = 'Whole clove buds' -%}
    {%- assign highlight_2 = 'Adimali / Kerala positioning' -%}
    {%- assign highlight_3 = 'Smaller kitchen-friendly pack' -%}
    {%- assign highlight_4 = 'Aroma-first cooking' -%}
    {%- assign note = 'A practical fit for homes that use clove often enough to care about freshness, but not at refill scale.' -%}
  {%- elsif product_handle contains '200gm' -%}
    {%- assign summary = 'A larger Kerala Adimali clove pack for households that use whole cloves more often and want stronger refill value without giving up whole-bud quality and aroma.' -%}
    {%- assign highlight_1 = 'Whole clove buds' -%}
    {%- assign highlight_2 = 'Larger refill pack' -%}
    {%- assign highlight_3 = 'Aroma-first spice use' -%}
    {%- assign highlight_4 = 'Better refill value' -%}
    {%- assign note = 'This format works best when cloves are already part of the weekly cooking rhythm.' -%}
  {%- endif -%}
{%- elsif product_handle contains 'white-pepper' -%}
  {%- assign primary_cta_label = 'Explore Pepper Range' -%}
  {%- assign summary = 'Kerala white pepper delivers smoother heat and a more refined culinary finish than black pepper, especially in soups, sauces, marinades, noodles, and lighter-colored dishes.' -%}
  {%- assign highlight_1 = 'Smoother heat' -%}
  {%- assign highlight_2 = 'Whole-spice format' -%}
  {%- assign highlight_3 = 'Best for soups and sauces' -%}
  {%- assign highlight_4 = 'Cleaner visual finish' -%}
  {%- assign note = 'Choose white pepper when you want precision and warmth without the sharper edge of black pepper.' -%}
{%- elsif product_handle contains 'premium-cassia-cinnamon' or product_handle contains 'cassia' -%}
  {%- assign primary_cta_label = 'Explore Cinnamon Range' -%}
  {%- if product_handle contains '200g' or product_handle contains '200gm' -%}
    {%- assign summary = 'A larger cassia cinnamon pack for kitchens that want bold cinnamon warmth on repeat in chai, baking, breakfast recipes, and savory spice work.' -%}
    {%- assign highlight_1 = 'Bold cassia profile' -%}
    {%- assign highlight_2 = 'Repeat-use kitchen size' -%}
    {%- assign highlight_3 = 'Great for chai and baking' -%}
    {%- assign highlight_4 = 'Stronger cinnamon character' -%}
    {%- assign note = 'Choose this when you already know you prefer the warmer, more assertive side of cinnamon.' -%}
  {%- else -%}
    {%- assign summary = 'Premium cassia cinnamon with a bolder, warmer flavor profile suited to chai, baking, and savory recipes where a stronger cinnamon note is preferred.' -%}
    {%- assign highlight_1 = 'Bold cassia profile' -%}
    {%- assign highlight_2 = 'Great for chai and baking' -%}
    {%- assign highlight_3 = 'Stronger cinnamon character' -%}
    {%- assign highlight_4 = 'Everyday-use size' -%}
    {%- assign note = 'Built for buyers who want cinnamon to show up clearly rather than stay in the background.' -%}
  {%- endif -%}
{%- elsif product_handle contains 'aromatic-true-cinnamon-ceylon' or product_handle contains 'ceylon' -%}
  {%- assign primary_cta_label = 'Explore Cinnamon Range' -%}
  {%- if product_handle contains '200g' or product_handle contains '200gm' -%}
    {%- assign summary = 'A larger true Ceylon cinnamon pack for kitchens that prefer a lighter, sweeter, and more delicate cinnamon profile on repeat in tea, desserts, and softer baking.' -%}
    {%- assign highlight_1 = 'True Ceylon cinnamon' -%}
    {%- assign highlight_2 = 'Lighter and sweeter taste' -%}
    {%- assign highlight_3 = 'Kitchen refill format' -%}
    {%- assign highlight_4 = 'Best for tea and desserts' -%}
    {%- assign note = 'A better fit for repeat Ceylon buyers who want finesse, not brute cinnamon intensity.' -%}
  {%- else -%}
    {%- assign summary = 'True Ceylon cinnamon with a lighter, sweeter, and more delicate profile than cassia, suited to tea, desserts, and refined everyday use.' -%}
    {%- assign highlight_1 = 'True Ceylon cinnamon' -%}
    {%- assign highlight_2 = 'Lighter and sweeter taste' -%}
    {%- assign highlight_3 = 'Best for tea and desserts' -%}
    {%- assign highlight_4 = 'Refined everyday use' -%}
    {%- assign note = 'Choose this when you want a gentler cinnamon expression rather than a bold cassia note.' -%}
  {%- endif -%}
{%- endif -%}

{%- if summary != blank -%}
  <div class="product__seo-summary-surface">
    <p class="product__seo-summary-eyebrow">Answer-first guide</p>
    <p class="product__seo-summary-text">{{ summary }}</p>
    <ul class="product__seo-summary-highlights list-unstyled" role="list">
      {%- if highlight_1 != blank -%}<li>{{ highlight_1 }}</li>{%- endif -%}
      {%- if highlight_2 != blank -%}<li>{{ highlight_2 }}</li>{%- endif -%}
      {%- if highlight_3 != blank -%}<li>{{ highlight_3 }}</li>{%- endif -%}
      {%- if highlight_4 != blank -%}<li>{{ highlight_4 }}</li>{%- endif -%}
    </ul>
    <div class="product__seo-summary-actions">
      <a class="product__seo-summary-action product__seo-summary-action--primary" href="{{ primary_cta_url }}">{{ primary_cta_label }}</a>
      <a class="product__seo-summary-action product__seo-summary-action--secondary" href="{{ secondary_cta_url }}">{{ secondary_cta_label }}</a>
    </div>
    {%- if note != blank -%}
      <p class="product__seo-summary-note">{{ note }}</p>
    {%- endif -%}
  </div>
{%- endif -%}
