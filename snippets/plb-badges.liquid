{%- comment -%}
  plb-badges.liquid — FSSAI licence + WhatsApp contact.
  Params: fssai_no, wa_number (digits with country code), wa_display
{%- endcomment -%}

{%- liquid
  assign lic = fssai_no | default: '10020042013756'
  assign wa = wa_number | default: '918848265849'
  assign wa_show = wa_display | default: '+91 88482 65849'
-%}

<div class="plb-card plb-fssai">
  <span class="plb-fssai__b" aria-hidden="true">FSSAI</span>
  <p><b>FSSAI Licensed</b>Lic. {{ lic }} &middot; lab-tested each batch</p>
</div>

<a class="plb-card plb-wa" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">
  <span class="plb-wa__i" aria-hidden="true">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
