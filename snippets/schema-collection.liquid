{%- if collection and collection.handle != 'frontpage' and collection.products.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }},
  "description": {{ collection.description | strip_html | truncatewords: 50 | json }},
  "url": {{ shop.url | append: collection.url | json }},
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
    ]
  },
  "mainEntity": {
    "@type": "ItemList",
    "name": {{ collection.title | json }},
    "numberOfItems": {{ collection.products_count }},
    "itemListElement": [
      {%- for product in collection.products limit: 20 -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "item": {
          "@type": "Product",
          "name": {{ product.title | json }},
          "url": {{ shop.url | append: product.url | json }},
          "image": {{ product.featured_image | image_url: width: 600 | prepend: 'https:' | json }},
          "description": {{ product.description | strip_html | truncatewords: 30 | json }},
          "offers": {
            "@type": "Offer",
            "priceCurrency": "INR",
            "price": {{ product.price | money_without_currency | remove: ',' }},
            "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
            "url": {{ shop.url | append: product.url | json }}
          }
          {%- assign r_value = product.metafields.reviews.rating.value -%}
          {%- assign r_count = product.metafields.reviews.rating_count.value -%}
          {%- if r_value and r_count and r_count > 0 -%}
          ,"aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ r_value }},
            "reviewCount": {{ r_count }},
            "bestRating": "5"
          }
          {%- endif -%}
        }
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
}
</script>
{%- endif -%}
