{%- comment -%}
  plb-review.liquid — one real Google review, with a name and a face.
  A person who bought the same thing is a reason; an aggregate score is only
  a statistic. Photo, name, date and text are edited in the cart section.

  Params: name, date, rating, text, photo (url)
{%- endcomment -%}

<figure class="plb-rev">
  <div class="plb-rev__h">
    <img class="plb-rev__av" src="{{ photo }}" alt="{{ name | escape }}" width="48" height="48" loading="lazy">
    <div class="plb-rev__who">
      <div class="plb-stars" role="img" aria-label="{{ rating }} out of 5 stars">
        {%- for i in (1..rating) -%}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#FBBC04" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z"/></svg>
        {%- endfor -%}
      </div>
      <p class="plb-rev__nm">{{ name }}</p>
      <p class="plb-rev__dt">{{ date }}</p>
    </div>
    <div class="plb-rev__g">
      <span>Posted on</span>
      <svg viewBox="0 0 272.9 92.3" width="33" height="11" role="img" aria-label="Google"><path fill="#4285F4" d="M35.3 41.5V32h32.6c.3 1.6.5 3.5.5 5.6 0 6.8-1.9 15.2-7.9 21.2-5.9 6.1-13.4 9.3-23.3 9.3C17.2 68.1 0 51.3 0 31.3 0 11.3 17.2-1.5 37.2-1.5c10.2 0 17.5 4 23 9.1L53.7 14c-3.9-3.7-9.2-6.5-16.5-6.5-13.5 0-24 10.9-24 24.3s10.5 24.3 24 24.3c8.7 0 13.7-3.5 16.9-6.7 2.6-2.6 4.3-6.3 4.9-11.5H35.3z"/><path fill="#EA4335" d="M115.8 46.6c0 12.8-10 22.1-22.3 22.1S71.2 59.4 71.2 46.6s10-22.1 22.3-22.1 22.3 9.3 22.3 22.1zm-9.8 0c0-8-5.8-13.5-12.5-13.5S81 38.6 81 46.6s5.8 13.5 12.5 13.5 12.5-5.5 12.5-13.5z"/><path fill="#FBBC05" d="M161.1 46.6c0 12.8-10 22.1-22.3 22.1s-22.3-9.3-22.3-22.1 10-22.1 22.3-22.1 22.3 9.3 22.3 22.1zm-9.8 0c0-8-5.8-13.5-12.5-13.5s-12.5 5.5-12.5 13.5 5.8 13.5 12.5 13.5 12.5-5.5 12.5-13.5z"/><path fill="#4285F4" d="M204.3 25.8v40c0 16.5-9.7 23.2-21.2 23.2-10.8 0-17.3-7.2-19.7-13.1l8.5-3.5c1.5 3.6 5.2 7.9 11.2 7.9 7.3 0 11.8-4.5 11.8-13v-3.2h-.3c-2.2 2.7-6.4 5-11.7 5-11.1 0-21.3-9.7-21.3-22.1 0-12.5 10.2-22.2 21.3-22.2 5.3 0 9.5 2.3 11.7 4.9h.3V26h9.4zm-8.7 20.9c0-7.8-5.2-13.5-11.8-13.5-6.7 0-12.3 5.7-12.3 13.5s5.6 13.3 12.3 13.3c6.6 0 11.8-5.5 11.8-13.3z"/><path fill="#34A853" d="M219.6 3.1v64.8h-9.5V3.1z"/><path fill="#EA4335" d="M257.2 54.9l7.6 5.1c-2.5 3.6-8.4 9.8-18.7 9.8-12.7 0-22.2-9.8-22.2-22.1 0-13.2 9.5-22.1 21.1-22.1 11.6 0 17.3 9.1 19.1 14l1 2.5-29.9 12.4c2.3 4.5 5.8 6.8 10.8 6.8s8.5-2.5 11.2-6.4zm-23.5-8.1l20-8.3c-1.1-2.8-4.4-4.7-8.3-4.7-5 0-12 4.4-11.7 13z"/></svg>
    </div>
  </div>
  <blockquote class="plb-rev__q">{{ text }}</blockquote>
</figure>
