{%- comment -%}
  Progressive image loader (assets/pl-progressive-load.js).
  Below-the-fold images load in batches, nearest to the visitor first. Theme settings > PureLeven speed.
{%- endcomment -%}
{%- if settings.pl_batch_load != false -%}
  <script>window.PL_SPEED = { batch: {{ settings.pl_batch_size | default: 20 }}, gap: 250 };</script>
  <script src="{{ 'pl-progressive-load.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<style>
  img[loading="lazy"],
  img[data-pl-lz] {
    background-color: #f0f0f0;
  }
</style>
