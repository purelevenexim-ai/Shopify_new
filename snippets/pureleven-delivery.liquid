<style>
  .pureleven-delivery {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
  }

  .pureleven-delivery__shell {
    position: relative;
    display: grid;
    gap: 1.6rem;
    padding: clamp(2rem, 3vw, 2.8rem);
    border-radius: 2.4rem;
    border: 1px solid rgba(7, 131, 98, 0.16);
    background: #FAFAF8;
    box-shadow: 0 2px 24px rgba(0, 68, 56, 0.07), 0 0 0 1px rgba(7,131,98,0.04);
    overflow: hidden;
  }

  .pureleven-delivery__shell::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(7,131,98,0.05) 0%, transparent 55%);
    pointer-events: none;
  }

  .pureleven-delivery__top {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 1rem 1.2rem;
  }

  .pureleven-delivery__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    border-radius: 1.4rem;
    background: #004438;
    color: #FCE477;
    box-shadow: 0 6px 20px rgba(0, 68, 56, 0.25);
    flex-shrink: 0;
  }

  .pureleven-delivery__icon svg {
    width: 2.2rem;
    height: 2.2rem;
  }

  .pureleven-delivery__copy {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
    grid-column: 2;
  }

  .pureleven-delivery__eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #078362;
  }

  .pureleven-delivery__eyebrow::before,
  .pureleven-delivery__eyebrow::after {
    content: '';
    display: inline-block;
    width: 2rem;
    height: 1.5px;
    background: #078362;
    border-radius: 999px;
    opacity: 0.5;
  }

  .pureleven-delivery__title {
    margin: 0;
    font-family: var(--font-heading-family, 'Playfair Display', serif);
    font-size: clamp(1.85rem, 4.5vw, 2.4rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #004438;
  }

  .pureleven-delivery__text {
    margin: 0.2rem 0 0;
    font-size: 1.26rem;
    line-height: 1.6;
    color: rgba(0, 68, 56, 0.65);
  }

  .pureleven-delivery__text strong {
    color: #004438;
    font-weight: 700;
  }

  .pureleven-delivery__badge {
    display: none;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 3.4rem;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    background: #FCE477;
    color: #1A1A1A;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 4px 14px rgba(252, 228, 119, 0.45);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .pureleven-delivery__facts {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pureleven-delivery__fact {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    border: 1.5px solid rgba(7, 131, 98, 0.18);
    background: #fff;
    box-shadow: 0 1px 4px rgba(0, 68, 56, 0.06);
  }

  .pureleven-delivery__fact svg {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    color: #078362;
  }

  .pureleven-delivery__fact--rating svg {
    color: #D4821A;
    fill: #D4821A;
  }

  .pureleven-delivery__fact-text {
    font-size: 1.18rem;
    line-height: 1.3;
    color: #555;
    white-space: nowrap;
  }

  .pureleven-delivery__fact-text strong {
    color: #004438;
    font-weight: 700;
  }

  @media screen and (min-width: 900px) {
    .pureleven-delivery__shell {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 2.4rem;
      row-gap: 1.2rem;
    }

    .pureleven-delivery__top {
      display: flex;
      align-items: center;
      gap: 1.4rem;
    }

    .pureleven-delivery__copy {
      grid-column: auto;
      flex: 1;
    }

    .pureleven-delivery__title { font-size: 2.6rem; }
    .pureleven-delivery__text { font-size: 1.38rem; }

    .pureleven-delivery__badge { display: inline-flex; }

    .pureleven-delivery__facts {
      grid-column: 1 / -1;
      gap: 0.75rem;
    }

    .pureleven-delivery__fact { padding: 0.7rem 1.2rem; }
    .pureleven-delivery__fact-text { font-size: 1.28rem; }
  }

  @media screen and (max-width: 749px) {
    .pureleven-delivery { padding: 0 12px; }

    .pureleven-delivery__shell {
      padding: 1.6rem;
      gap: 1.2rem;
      border-radius: 2rem;
    }

    .pureleven-delivery__top { gap: 0.8rem 1rem; }

    .pureleven-delivery__icon {
      width: 4.4rem;
      height: 4.4rem;
      border-radius: 1.2rem;
    }

    .pureleven-delivery__icon svg { width: 2rem; height: 2rem; }
    .pureleven-delivery__title { font-size: 2rem; }
    .pureleven-delivery__text { font-size: 1.22rem; }
    .pureleven-delivery__facts { gap: 0.55rem; }
  }

  @media screen and (max-width: 560px) {
    .pureleven-delivery__top { grid-template-columns: 3.8rem minmax(0, 1fr); }
    .pureleven-delivery__icon { width: 3.8rem; height: 3.8rem; border-radius: 1.1rem; }
    .pureleven-delivery__icon svg { width: 1.8rem; height: 1.8rem; }
    .pureleven-delivery__fact-text { white-space: normal; }
  }
</style>

